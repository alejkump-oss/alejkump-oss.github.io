      <div><b>5</b><span><Fragment set:html={t('Do 5 oseb','Up to 5 guests')} /></span></div>
      <div><b>2</b><span><Fragment set:html={t('Spalnici','Bedrooms')} /></span></div>
      <div><b>270 m</b><span><Fragment set:html={t('Do jezera','To the lake')} /></span></div>
      <div><b>400 m</b><span><Fragment set:html={t('Do središča','To the centre')} /></span></div>
    </div>
    <div class="grid">
      <div class="rv">
        <span class="over"><Fragment set:html={t('O apartmaju','About the apartment')} /></span>
        <h2><Fragment set:html={t('Prostor, ki diha.','A place that breathes.')} /></h2>
        <p class="lead" style="margin-top:26px"><Fragment set:html={t(
          `Strato Apartment meri ${f.size} in sprejme ${f.guests}. ${f.bedrooms}. ${f.lake}, ${f.center}.`,
          `Strato Apartment measures ${e.size} and sleeps ${e.guests}. ${e.bedrooms}. ${e.lake}, ${e.center}.`)} /></p>
        <p style="margin-top:18px;color:var(--mute)"><Fragment set:html={t(f.living + '.', e.living + '.')} /></p>
        <p style="margin-top:18px;color:var(--mute)"><Fragment set:html={t(f.parking + '. ' + f.checkin + '. ' + f.checkout + '.', e.parking + '. ' + e.checkin + '. ' + e.checkout + '.')} /></p>
        <div class="hosts"><i></i><span><Fragment set:html={t('Gostitelja Barbara & Rok','Your hosts Barbara & Rok')} /></span></div>
      </div>
      <div class="pics rv d1">
        <img class="a" src={A+'strato-01.jpg'} alt="Dnevna soba s kavčem in delovnim kotičkom" loading="lazy" />
        <img class="b" src={A+'strato-03.jpg'} alt="Klavir in delovni kotiček" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<section style="padding-top:0">
  <div class="wrap" style="margin-bottom:clamp(40px,5vw,72px)">
    <span class="over rv"><Fragment set:html={t('Prostori','The rooms')} /></span>
    <h2 class="rv d1"><Fragment set:html={t('Vsak kotiček ima svoj namen.','Every corner has a purpose.')} /></h2>
  </div>
  {rooms.map((r, i) => (
    <article class="room rv">
      <div class="img"><img src={A+'strato-'+r.img+'.jpg'} alt={r.sl} loading="lazy" /></div>
      <div class="txt">
        <span class="num">0{i+1}</span>
        <h3><Fragment set:html={t(r.sl, r.en)} /></h3>
        <p><Fragment set:html={t(r.tsl, r.ten)} /></p>
      </div>
    </article>
  ))}
  <div class="wrap">
    <div class="amen">
      {amen.map(([sl,en,tsl,ten]) => (
        <div class="rv"><h4><Fragment set:html={t(sl,en)} /></h4><p><Fragment set:html={t(tsl,ten)} /></p></div>
      ))}
    </div>
  </div>
</section>

<section id="galerija" class="gal" style="padding-top:0">
  <div class="wrap galhead">
    <div>
      <span class="over rv"><Fragment set:html={t('Galerija','Gallery')} /></span>
      <h2 class="rv d1"><Fragment set:html={t('Pogled v apartma.','A look inside.')} /></h2>
    </div>
    <div class="galnav rv d2">
      <button type="button" data-dir="-1" aria-label="Prejšnja / Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 5l-7 7 7 7"/></svg></button>
      <button type="button" data-dir="1" aria-label="Naslednja / Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5l7 7-7 7"/></svg></button>
    </div>
  </div>
  <div class="strip" id="strip">
    {gallery.map(([n,sl,en]) => (
      <figure><img src={A+'strato-'+n+'.jpg'} alt={sl} loading="lazy" /><figcaption><Fragment set:html={t(sl,en)} /></figcaption></figure>
    ))}
  </div>
  <div class="wrap" style="margin-top:34px">
    <div class="slot rv"><b><Fragment set:html={t('Prostor za video ali virtualni ogled','Slot for a video or virtual tour')} /></b><Fragment set:html={t('Vstavimo, ko bo posnetek na voljo.','Inserted once the footage is available.')} /></div>
  </div>
</section>

<section id="ocene" class="ratings">
  <div class="wrap">
    <span class="over rv"><Fragment set:html={t('Ocene gostov','Guest ratings')} /></span>
    <h2 class="rv d1"><Fragment set:html={t('Kar pravijo tisti, ki so že bili tu.','What previous guests say.')} /></h2>
    <div class="scores rv">
      <div><small>Booking.com</small><b>9,9</b><span><Fragment set:html={t('od 10 · 10 ocen','out of 10 · 10 reviews')} /></span></div>
      <div><small>Airbnb</small><b>5,0</b><span><Fragment set:html={t('od 5 · 9 ocen','out of 5 · 9 reviews')} /></span></div>
    </div>
    <p style="margin-top:34px;font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:var(--brass)" class="rv"><Fragment set:html={t('Ocene gostov – izbor 5 ocen z Bookinga in Airbnb (vstavimo po potrditvi)','Guest reviews – a selection of 5 reviews from Booking and Airbnb (inserted after confirmation)')} /></p>
    <div class="revslots rv">
      {[1,2,3,4,5].map(n => (<div class="slot"><b><Fragment set:html={t('Ocena '+n,'Review '+n)} /></b><Fragment set:html={t('Besedilo gosta · ime · platforma','Guest text · name · platform')} /></div>))}
    </div>
  </div>
</section>

<section id="okolica">
  <div class="wrap">
    <span class="over rv"><Fragment set:html={t('Okolica','Things to do')} /></span>
    <h2 class="rv d1"><Fragment set:html={t('Pet krajev iz vodnika gostiteljev.','Five places from the hosts’ guide.')} /></h2>
    <div class="todo rv">
      {todo.map((p, i) => (
        <a href={d.maps} target="_blank" rel="noopener"><span class="n">0{i+1}</span><h3><Fragment set:html={t(p.sl,p.en)} /></h3><p><Fragment set:html={t(p.note_sl,p.note_en)} /></p></a>
      ))}
    </div>
    <div class="more rv">
      <span><Fragment set:html={t('Več iz vodnika','More from the guide')} /></span>
      {d.more_from_guide.map(m => (<i class="chip">{m}</i>))}
    </div>
  </div>
</section>

<section id="bentral" class="res">
  <div class="wrap">
    <span class="over rv"><Fragment set:html={t('Rezervacija','Reservation')} /></span>
    <h2 class="rv d1"><Fragment set:html={t('Preverite proste termine.','Check available dates.')} /></h2>
    <div class="box rv">
      <div class="widget"><div><b>Bentral</b><Fragment set:html={t('Tu bo Bentral rezervacijski koledar (vstavimo kodo vtičnika).','The Bentral booking calendar will be here (plugin code to be inserted).')} /></div></div>
      <div class="side">
        <h3><Fragment set:html={t('Raje po telefonu ali e-pošti?','Prefer phone or e-mail?')} /></h3>
        <p><Fragment set:html={t('Barbara in Rok odgovorita osebno.','Barbara and Rok reply in person.')} /></p>
        <div class="cta">
          <a class="btn solid" href={d.phone_href}><Fragment set:html={t('Pokliči','Call')} /> {d.phone}</a>
          <a class="btn" href={'mailto:'+d.email}><Fragment set:html={t('Piši na e-pošto','Send an e-mail')} /></a>
        </div>
        <div class="kv">
          <div><span><Fragment set:html={t('Prijava','Check-in')} /></span><span><Fragment set:html={t(f.checkin,e.checkin)} /></span></div>
          <div><span><Fragment set:html={t('Odjava','Check-out')} /></span><span><Fragment set:html={t(f.checkout,e.checkout)} /></span></div>
          <div><span><Fragment set:html={t('Hišni red','House rules')} /></span><span><Fragment set:html={t(f.rules,e.rules)} /></span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="kontakt" class="contact">
  <div class="wrap">
    <span class="over rv"><Fragment set:html={t('Kontakt','Contact')} /></span>
    <h2 class="rv d1"><Fragment set:html={t('Pišite nama.','Write to us.')} /></h2>
    <div class="grid">
      <form class="form rv" id="cf" action={'mailto:'+d.email} method="post" enctype="text/plain">
        <label><Fragment set:html={t('Ime in priimek','Full name')} /><input name="ime" required autocomplete="name" /></label>
        <label><Fragment set:html={t('E-pošta','E-mail')} /><input name="email" type="email" required autocomplete="email" /></label>
        <div class="two">
          <label><Fragment set:html={t('Prihod','Check-in')} /><input name="od" type="date" /></label>
          <label><Fragment set:html={t('Odhod','Check-out')} /><input name="do" type="date" /></label>
        </div>
        <label><Fragment set:html={t('Sporočilo','Message')} /><textarea name="sporocilo" required></textarea></label>
        <div><button class="btn solid" type="submit"><Fragment set:html={t('Pripravi e-sporočilo','Prepare e-mail')} /></button></div>
        <p class="hint"><Fragment set:html={t(
          'Obrazec odpre vaš e-poštni program s pripravljenim sporočilom za strato.apartment@gmail.com – pošljete ga vi. Nič se ne shranjuje na strani.',
          'This form opens your e-mail app with a message prepared for strato.apartment@gmail.com – you send it yourself. Nothing is stored on the site.')} /></p>
      </form>
      <div class="info rv d1">
        <div class="line"><small><Fragment set:html={t('Naslov','Address')} /></small><span>{d.address} · <a class="u" href={d.maps} target="_blank" rel="noopener"><Fragment set:html={t('Zemljevid','Map')} /></a></span></div>
        <div class="line"><small><Fragment set:html={t('Telefon','Phone')} /></small><a class="u" href={d.phone_href}>{d.phone}</a></div>
        <div class="line"><small><Fragment set:html={t('E-pošta','E-mail')} /></small><a class="u" href={'mailto:'+d.email}>{d.email}</a></div>
        <div class="line"><small><Fragment set:html={t('Gostitelja','Hosts')} /></small><span>{d.hosts}</span></div>
        <div class="line"><small><Fragment set:html={t('Prijava','Check-in')} /></small><span><Fragment set:html={t(f.checkin,e.checkin)} /></span></div>
        <div class="line"><small><Fragment set:html={t('Odjava','Check-out')} /></small><span><Fragment set:html={t(f.checkout,e.checkout)} /></span></div>
        <div class="line"><small><Fragment set:html={t('Hišni red','House rules')} /></small><span><Fragment set:html={t(f.rules,e.rules)} /></span></div>
        <div class="badges">
          <div class="slot"><b>Green & Safe</b><Fragment set:html={t('Logo Green & Safe (pošljeta gostitelja)','Green & Safe logo (to be supplied by the hosts)')} /></div>
          <div class="koc"><small style="font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--brass)">Kočevsko</small><a href={d.kocevsko_link} target="_blank" rel="noopener"><Fragment set:html={t('Najdete nas tudi na Kočevsko.com','Find us on Kočevsko.com too')} /></a></div>
        </div>
      </div>
    </div>
  </div>
</section>

</main>

<footer>
  <div class="wrap">
    <span>© Strato Apartment · {d.address}</span>
    <span class="pv">Predogled: AK agencija</span>
  </div>
</footer>

<script is:inline>
(function(){
  var h=document.documentElement;
  var titles={sl:'Strato Apartment · Kočevje',en:'Strato Apartment · Kočevje, Slovenia'};
  function setLang(l){h.lang=l;document.title=titles[l];try{localStorage.setItem('strato-lang',l)}catch(e){}
    document.querySelectorAll('.lang button').forEach(function(b){b.setAttribute('aria-pressed',String(b.dataset.set===l))});}
  document.querySelectorAll('.lang button').forEach(function(b){b.addEventListener('click',function(){setLang(b.dataset.set)})});
  setLang(h.lang==='en'?'en':'sl');

  var nav=document.getElementById('nav');
  function onScroll(){nav.classList.toggle('on',window.scrollY>40)}
  onScroll();addEventListener('scroll',onScroll,{passive:true});

  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}})},{threshold:.1,rootMargin:'0px 0px -6% 0px'});
    document.querySelectorAll('.rv').forEach(function(el){io.observe(el)});
  } else { document.querySelectorAll('.rv').forEach(function(el){el.classList.add('in')}); }

  var strip=document.getElementById('strip');
  document.querySelectorAll('.galnav button').forEach(function(b){b.addEventListener('click',function(){
    var w=strip.querySelector('figure').getBoundingClientRect().width+14;
    strip.scrollBy({left:w*Number(b.dataset.dir),behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});
  })});

  var quick=document.getElementById('quick'), cf=document.getElementById('cf');
  quick.addEventListener('submit',function(ev){ev.preventDefault();
    var od=quick.od.value, dd=quick.do.value;
    if(od) cf.od.value=od; if(dd) cf.do.value=dd;
    var g=quick.gostje.value; if(g && !cf.sporocilo.value){cf.sporocilo.value=(h.lang==='en'?'Guests: ':'Število gostov: ')+g;}
    document.getElementById('bentral').scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});
  });
  cf.addEventListener('submit',function(ev){ev.preventDefault();
    var en=h.lang==='en';
    var body=(en?'Name: ':'Ime: ')+cf.ime.value+'\n'+(en?'E-mail: ':'E-pošta: ')+cf.email.value+'\n'+(en?'Dates: ':'Termin: ')+(cf.od.value||'–')+' – '+(cf.do.value||'–')+'\n\n'+cf.sporocilo.value;
    location.href='mailto:'+'strato.apartment@gmail.com'+'?subject='+encodeURIComponent(en?'Enquiry – Strato Apartment':'Povpraševanje – Strato Apartment')+'&body='+encodeURIComponent(body);
  });
})();
</script>
</body>
</html>
