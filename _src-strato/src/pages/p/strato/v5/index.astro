---
// Strato Apartment – predlog 5 (client: "dober vmesnik")
// Same layout language as bohinjmountaindreams.com/sl: centred serif logo header over a full-screen hero,
// tan booking bar overlapping the hero, 1100px text column with grey uppercase buttons, beige CTA box,
// three-column card row with arrows, four-column footer + copyright bar. Own code, own text, Strato photos only.
import d from '../../../../data/strato.json';
const f = d.facts_sl, e = d.facts_en;
const A = '../assets/';
const t = (sl, en) => `<span data-lang="sl">${sl}</span><span data-lang="en">${en}</span>`;
const todo = d.things_to_do_from_hosts_folio_guide;
const reviews = d.ratings.reviews;
const split = (s) => s.split(' / ');
const gallery = ['01','03','04','05','06','07','08','10','11','12','13','14','15','terasa-3','terasa-4','terasa-5','terasa-6','vrt-2','kopalnica-2','kopalnica-3','hodnik-1'];
// Things-to-do photos: Wikimedia Commons, downloaded into ../assets/; the credit is part of the photo.
const pimg = (p) => `<img src="${A}${p.photo}" width="${p.photo_w}" height="${p.photo_h}" loading="lazy" decoding="async" alt="${p.photo_alt_sl}">`;
const cr = (p) => `<small class="credit">${t('Foto','Photo')}: ${p.photo_credit.author}, <a href="${p.photo_credit.license_url}" target="_blank" rel="noopener license">${p.photo_credit.license}</a>, <a href="${p.photo_credit.source}" target="_blank" rel="noopener">Wikimedia Commons</a></small>`;
const amen = [[f.bedrooms,e.bedrooms],[f.living,e.living],[f.kitchen,e.kitchen],[f.bedroom1,e.bedroom1],[f.bedroom2,e.bedroom2],[f.bathroom,e.bathroom],[f.climate,e.climate],[f.outdoor,e.outdoor],[f.parking,e.parking],[f.extras,e.extras],[f.renovated,e.renovated],[f.languages,e.languages]];
---
<!doctype html>
<html lang="sl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>Strato Apartment · Kočevje</title>
<meta name="description" content="Strato Apartment, Kočevje – apartma za do 5 oseb, 270 m od Kočevskega jezera. Predlog spletne strani (AK agencija)." />
<meta name="robots" content="noindex" />
<script is:inline>
  (function(){var h=document.documentElement;h.classList.add('js');try{var l=localStorage.getItem('strato-lang');if(l==='en'||l==='sl')h.lang=l;}catch(e){}})();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bona+Nova:ital,wght@0,400;0,700;1,400&family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
<style is:global>
  :root{
    --ink:#000; --text:#393939; --mute:#6d6d6d; --line:#e4e4e4;
    --brown:#6b5b44; --brown2:#6f5736; --tan:#9a7b4e; --beige:#f5f0ea; --grey:#69727d;
    --serif:'Bona Nova',Georgia,'Times New Roman',serif; --sans:'Work Sans',Arial,sans-serif;
    --max:1100px; --gut:clamp(16px,4vw,40px);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  body{background:#fff;color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.7;font-weight:400;overflow-x:hidden}
  img{display:block;max-width:100%;height:auto}
  a{color:inherit;text-decoration:none}
  html[lang=sl] [data-lang=en]{display:none!important}
  html[lang=en] [data-lang=sl]{display:none!important}
  .wrap{max-width:var(--max);margin:0 auto;padding:0 var(--gut)}
  h1,h2,h3{font-family:var(--serif);font-weight:400;line-height:1.15;color:var(--ink)}
  h1{font-size:34px}
  h2{font-size:28px}
  h3{font-size:24px}
  p{margin:0 0 22px}
  .over{display:block;font-size:14px;text-transform:uppercase;letter-spacing:.02em;color:var(--ink);line-height:1.3}
  .btn{display:inline-block;background:var(--grey);color:#fff;font:400 15px/1.2 var(--sans);text-transform:uppercase;padding:13px 24px;min-height:44px;border-radius:3px;border:0;cursor:pointer;transition:background .25s}
  .btn:hover{background:#525a63}
  .btn.brown{background:var(--brown2);text-transform:none;font-weight:600;font-size:14px;padding:16px 30px}
  .btn.brown:hover{background:#5a4629}
  .btn.outline{background:transparent;color:var(--brown2);border:1px solid var(--brown2);font-size:13px;padding:16px 34px}
  .btn.outline:hover{background:var(--brown2);color:#fff}

  /* header over hero */
  .top{position:absolute;inset:0 0 auto 0;z-index:30;color:#fff}
  .top .bar{display:flex;justify-content:space-between;align-items:center;padding:calc(8px + env(safe-area-inset-top)) max(var(--gut),env(safe-area-inset-right)) 8px max(var(--gut),env(safe-area-inset-left));font-size:15px}
  .top .bar a,.top .bar button{color:#fff;background:none;border:0;font:400 15px/1 var(--sans);cursor:pointer;padding:4px 6px;opacity:.9}
  .top .bar [aria-pressed=true]{text-decoration:underline;text-underline-offset:4px;opacity:1}
  .top .bar .r{display:flex;gap:14px}
  .brandrow{position:relative;display:flex;justify-content:center;align-items:flex-start;padding:4px var(--gut) 0}
  .brand{text-align:center;display:flex;flex-direction:column;align-items:center;gap:2px}
  .brand svg{width:58px;height:40px;stroke:#fff;fill:none;stroke-width:1.6}
  .brand b{font:400 20px/1.2 var(--serif);letter-spacing:.06em;text-transform:uppercase}
  .brand small{font:300 12px/1.2 var(--sans);letter-spacing:.3em;text-transform:uppercase;opacity:.92}
  .burger{position:absolute;right:calc(var(--gut) + 260px);top:30px;width:60px;height:44px;background:none;border:0;cursor:pointer;display:grid;gap:9px;padding:6px 0;align-content:center}
  .burger i{display:block;height:2px;background:#fff;width:60px}
  @media (max-width:1250px){.burger{right:var(--gut)}}
  @media (max-width:640px){.top .bar{font-size:13px}.burger{width:40px;top:18px;gap:7px}.burger i{width:40px}.brand svg{width:48px}.brand b{font-size:16px}.brand small{font-size:10px}}
  .overlay{position:fixed;inset:0;background:#000;color:#fff;z-index:40;display:none;flex-direction:column;align-items:center;justify-content:center;gap:28px;font-family:var(--serif);font-size:30px}
  .overlay.open{display:flex}
  .overlay a:hover{color:#d9c7a6}
  .overlay .x{position:absolute;top:22px;right:var(--gut);background:none;border:0;color:#fff;font:300 44px/1 var(--sans);cursor:pointer}

  /* hero */
  .hero{position:relative;height:100svh;min-height:620px;display:grid;place-items:center;isolation:isolate;overflow:hidden}
  .hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2;transform:scale(1.05);animation:kb 16s ease-out forwards}
  @keyframes kb{to{transform:scale(1)}}
  .hero::after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(0,0,0,.55),rgba(0,0,0,.25) 45%,rgba(0,0,0,.45))}
  .hero h2{color:#fff;font-size:clamp(34px,4vw,50px);text-align:center;padding:0 var(--gut);text-shadow:0 2px 12px rgba(0,0,0,.4)}

  /* booking bar overlapping hero */
  .bookwrap{position:relative;z-index:5;margin-top:-50px}
  .book{max-width:var(--max);margin:0 auto;background:var(--tan);padding:22px 20px;display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr) auto;gap:20px;align-items:end}
  .book label,.book .bk{display:grid;gap:4px;color:#fff;font:600 12px/1.2 var(--sans)}
  .book .d{flex:1 1 130px;display:grid;gap:0;color:var(--mute);padding:5px 0 4px}
  .book .d small{font:600 11px/1.2 var(--sans);letter-spacing:.06em;text-transform:uppercase;color:var(--mute)}
  .book .d input{height:auto;padding:2px 0 0;line-height:1.3}
  .book .field{background:#fff;border:1px solid #c9b48f;min-height:44px;display:flex;flex-wrap:wrap;align-items:center;gap:0 10px;padding:0 12px;color:var(--mute)}
  .book .field svg{width:18px;height:18px;stroke:#444;fill:none;stroke-width:1.6;flex:0 0 18px}
  .book input{flex:1 1 130px;width:auto;height:42px;border:0;outline:none;font:400 16px/1 var(--sans);color:var(--text);background:transparent;min-width:0}
  .book .btn{height:44px;display:inline-flex;align-items:center}
  @media (max-width:820px){.book{grid-template-columns:minmax(0,1fr);margin:0 var(--gut)}.bookwrap{margin-top:-30px}}

  /* text sections */
  .story{padding:72px 0 10px}
  .story p{color:var(--ink)}
  .figure{display:flex;justify-content:center;margin:26px 0 36px}
  .figure img{width:100%;max-width:1024px;aspect-ratio:3/2;object-fit:cover}
  .figure.narrow img{max-width:946px}
  .figure.duo{display:grid;grid-template-columns:1fr 1fr;gap:14px;max-width:946px;margin:26px auto 30px}
  @media (max-width:560px){.figure.duo{grid-template-columns:1fr}}
  .cards img{width:100%;aspect-ratio:3/2;object-fit:cover;margin-bottom:14px}
  .credit{display:block;font-size:12px;color:var(--mute);line-height:1.5;margin-top:4px}
  .credit a{color:inherit;text-decoration:underline;text-underline-offset:2px}
  .block{margin-bottom:34px}
  .block h2{margin-bottom:10px}
  .block .btn{margin-top:2px}
  .amen{list-style:none;columns:2;column-gap:40px;margin:18px 0 40px}
  .amen li{break-inside:avoid;padding:8px 0;border-bottom:1px solid var(--line);font-size:15px}
  @media (max-width:760px){.amen{columns:1}}

  /* gallery */
  .gal{padding:30px 0 50px}
  .grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:22px}
  .grid3 img{width:100%;aspect-ratio:3/2;object-fit:cover}
  @media (max-width:760px){.grid3{grid-template-columns:repeat(2,minmax(0,1fr))}}

  /* ratings */
  .ocene{padding:50px 0}
  .scores{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px;margin:26px 0 36px}
  .score{border:1px solid var(--line);padding:26px 28px;display:flex;gap:22px;align-items:center}
  .score b{font:400 56px/1 var(--serif);color:var(--brown2)}
  .score small{display:block;font:600 13px/1.4 var(--sans);text-transform:uppercase;letter-spacing:.04em}
  .score span{font-size:14px;color:var(--text)}
  @media (max-width:640px){.scores{grid-template-columns:minmax(0,1fr)}}
  .cards{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 80px)/3);gap:40px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:4px 0 10px}
  .cards::-webkit-scrollbar{display:none}
  .cards>div{scroll-snap-align:start}
  .cards h3{margin-bottom:6px}
  .cards p{font-size:15px;line-height:1.75;margin-bottom:8px}
  .cards .meta{font-size:14px;color:var(--text)}
  .cards .meta i{font-style:normal;color:var(--mute)}
  .cards .more{font-size:15px;color:var(--ink);text-decoration:underline;text-underline-offset:3px}
  .arrows{display:flex;gap:14px;margin-top:18px;font-size:26px;line-height:1}
  .arrows button{background:none;border:0;cursor:pointer;color:var(--ink);font:400 26px/1 var(--sans);padding:0 4px}
  @media (max-width:900px){.cards{grid-auto-columns:calc((100% - 40px)/2)}}
  @media (max-width:600px){.cards{grid-auto-columns:88%}}
  .tr{font-size:12px;color:var(--mute);font-style:italic}

  /* beige CTA */
  .cta{max-width:var(--max);margin:40px auto;background:var(--beige);padding:34px 42px;display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:28px;align-items:center}
  .cta svg{width:42px;height:42px;stroke:var(--brown2);fill:none;stroke-width:1.5}
  .cta h3{font-size:34px;color:var(--brown2);margin-bottom:6px}
  .cta p{margin:0;color:var(--mute);font-size:15px}
  @media (max-width:820px){.cta{grid-template-columns:minmax(0,1fr);margin:30px var(--gut);text-align:center;justify-items:center}}

  /* reservation */
  .res{padding:30px 0 50px}
  .widget{margin-top:22px;border:1px dashed var(--tan);background:var(--beige);min-height:360px;display:grid;place-items:center;text-align:center;padding:30px;color:var(--text)}
  .widget b{display:block;font:400 24px/1.2 var(--serif);color:var(--brown2);margin-bottom:8px}
  .res .acts{display:flex;flex-wrap:wrap;gap:12px;margin-top:20px}
  .kv{margin-top:26px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;font-size:15px}
  .kv b{display:block;font:400 20px/1.3 var(--serif);margin-bottom:4px}
  @media (max-width:760px){.kv{grid-template-columns:minmax(0,1fr)}}

  /* things to do */
  .okolica{padding:40px 0 20px}
  .chips{margin:18px 0 0;font-size:15px;color:var(--text)}
  .chips span{display:inline-block;margin:0 14px 6px 0}
  .chips>span::before{content:'·';margin-right:8px;color:var(--brown2)}

  /* contact form (reference: underline fields + outlined button) */
  .kontakt{padding:40px 0 60px}
  .kontakt h2{line-height:1.2}
  .form{margin-top:22px;display:grid;gap:22px}
  .form label{display:grid;gap:4px;font:600 13px/1.3 var(--sans)}
  .form input,.form textarea{width:100%;border:0;border-bottom:1px solid #bdbdbd;padding:12px 0;font:400 16px/1.4 var(--sans);color:var(--text);outline:none;background:transparent;border-radius:0}
  .form input:focus,.form textarea:focus{border-color:var(--brown2)}
  .form textarea{min-height:110px;resize:vertical}
  .two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:22px}
  .hint{font-size:13px;color:var(--mute);margin:0}
  @media (max-width:560px){.two{grid-template-columns:minmax(0,1fr)}}

  /* footer */
  footer{padding:50px 0 0}
  .fgrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:40px}
  .fgrid h2{font-size:28px;margin-bottom:10px}
  .fgrid ul{list-style:none}
  .fgrid li{padding:3px 0;font-size:16px}
  .fgrid .ico{display:flex;gap:10px;align-items:flex-start}
  .fgrid .ico svg{width:16px;height:16px;flex:0 0 16px;margin-top:7px;fill:var(--ink)}
  .tag{font:400 28px/1.2 var(--serif)}
  .slot{margin-top:14px;border:1px dashed #bbb;padding:16px;font-size:13px;color:var(--mute)}
  .slot b{display:block;color:var(--ink);font-weight:600;margin-bottom:4px}
  .koc{margin-top:10px;font-size:15px}
  .koc a{text-decoration:underline;text-underline-offset:3px;color:var(--brown2)}
  .copy{border-top:1px solid #ccc;margin-top:40px;padding:20px 0;font-size:15px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px}
  @media (max-width:900px){.fgrid{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}
  @media (max-width:560px){.fgrid{grid-template-columns:minmax(0,1fr)}}

  /* mobile QA */
  [id]{scroll-margin-top:16px}
  @media (max-width:760px){
    .top .bar a,.top .bar button{min-height:44px;min-width:44px;display:inline-flex;align-items:center;justify-content:center;padding:4px 10px}
    .overlay a{min-height:44px;display:inline-flex;align-items:center;padding:4px 12px}
    .top .bar .r{gap:4px}
    .burger{width:44px;height:44px;padding:0;justify-items:end}
    .burger i{width:40px}
    .book label,.book .cap{font-size:15px}
    .book .d small{font-size:12px}
    .book .d{flex-basis:100%;padding:6px 0 2px}
    .book .d input{height:44px;padding:0}
    .book .field{min-height:48px}
    .book input{height:46px}
    .form label{font-size:15px}
    .hint{font-size:15px}
    .arrows button{min-width:44px;min-height:44px}
    .cards .more{display:inline-block;padding:12px 16px 12px 0;min-width:44px}
    .koc a{display:inline-block;padding:12px 0}
    .fgrid li a{display:inline-block;padding:9px 0}
    .over{font-size:15px}
    .hero{min-height:560px}
    .hero h2{font-size:34px}
  }
  html.js .rv{opacity:0;transform:translateY(16px);transition:opacity .7s ease,transform .7s ease}
  html.js .rv.in{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){html.js .rv{opacity:1;transform:none;transition:none}.hero img{animation:none;transform:none}}
</style>
</head>
<body>

<header class="top">
  <div class="bar">
    <div class="l" role="group" aria-label="Jezik / Language">
      <button type="button" data-set="sl" aria-pressed="true">sl</button>
      <button type="button" data-set="en" aria-pressed="false">en</button>
    </div>
    <div class="r">
      <a href="#kontakt"><Fragment set:html={t('Kontakt','Contact')} /></a>
      <a href="#bentral"><Fragment set:html={t('Rezerviraj zdaj','Book now')} /></a>
    </div>
  </div>
  <div class="brandrow">
    <a class="brand" href="#top" aria-label="Strato Apartment">
      <svg viewBox="0 0 58 40" aria-hidden="true"><path d="M8 24 L29 6 L50 24"/><path d="M14 24 V36 H44 V24"/><path d="M4 39 C10 35 16 35 22 39 C28 35 34 35 40 39 C46 35 52 35 56 39"/></svg>
      <b>Strato Apartment</b>
      <small>Kočevje · Slovenija</small>
    </a>
    <button class="burger" type="button" aria-label="Meni / Menu" id="burger"><i></i><i></i><i></i></button>
  </div>
</header>
<nav class="overlay" id="overlay" aria-label="Meni">
  <button class="x" type="button" id="close" aria-label="Zapri / Close">×</button>
  <a href="#apartma"><Fragment set:html={t('Apartma','Apartment')} /></a>
  <a href="#galerija"><Fragment set:html={t('Galerija','Gallery')} /></a>
  <a href="#ocene"><Fragment set:html={t('Ocene gostov','Guest reviews')} /></a>
  <a href="#okolica"><Fragment set:html={t('Okolica','Things to do')} /></a>
  <a href="#bentral"><Fragment set:html={t('Rezervacija','Reservation')} /></a>
  <a href="#kontakt"><Fragment set:html={t('Kontakt','Contact')} /></a>
</nav>

<main id="top">

<section class="hero">
  <img src={A+'strato-02.jpg'} alt="Dnevna soba apartmaja Strato, Kočevje" fetchpriority="high" />
  <h2><Fragment set:html={t('Kjer se mir sreča z jezerom','Where calm meets the lake')} /></h2>
</section>

<div class="bookwrap">
  <form class="book" id="quick" action="#bentral" method="get" autocomplete="off">
    <div class="bk"><span class="cap"><Fragment set:html={t('Datumi','Dates')} /></span><span class="field"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg><label class="d"><small><Fragment set:html={t('Prihod','Check-in')} /></small><input type="date" name="od" /></label><label class="d"><small><Fragment set:html={t('Odhod','Check-out')} /></small><input type="date" name="do" /></label></span></div>
    <label><Fragment set:html={t('Gostje','Guests')} /><span class="field"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/></svg><input type="number" name="gostje" min="1" max="5" placeholder="1–5" /></span></label>
    <button class="btn brown" type="submit"><Fragment set:html={t('Preveri razpoložljivost','Check availability')} /></button>
  </form>
</div>

<section id="apartma" class="story">
  <div class="wrap">
    <span class="over rv"><Fragment set:html={t('Naša zgodba na kratko','Our story in short')} /></span>
    <h1 class="rv">Strato Apartment</h1>
    <p class="rv" style="margin-top:40px"><Fragment set:html={t(
      `Strato Apartment je družinsko voden apartma v Kočevju, ki ga gostita Barbara in Rok. ${f.renovated}, meri ${f.size} in sprejme ${f.guests}. ${f.lake}, ${f.center}.`,
      `Strato Apartment is a family-run apartment in Kočevje hosted by Barbara and Rok. ${e.renovated}, it measures ${e.size} and sleeps ${e.guests}. ${e.lake}, ${e.center}.`)} /></p>
    <p class="rv"><Fragment set:html={t(`${f.bedrooms}. ${f.parking}. ${f.languages}.`,`${e.bedrooms}. ${e.parking}. ${e.languages}.`)} /></p>

    <span class="over rv" style="text-transform:none;margin-top:30px"><Fragment set:html={t('Apartma','Apartment')} /></span>
    <div class="figure rv"><img src={A+'strato-05.jpg'} alt="Dnevna soba s TV, kitaro in klavirjem" loading="lazy" /></div>
    <div class="block rv">
      <h2><Fragment set:html={t('Dnevna soba in spalnici','Living room and bedrooms')} /></h2>
      <p><Fragment set:html={t(`${f.living}. ${f.bedroom1}. ${f.bedroom2}.`,`${e.living}. ${e.bedroom1}. ${e.bedroom2}.`)} /></p>
      <a class="btn" href="#galerija"><Fragment set:html={t('Poglej galerijo','View the gallery')} /></a>
    </div>
    <div class="figure rv"><img src={A+'strato-terasa-1.jpg'} width="1280" height="852" alt="Terasa z jedilno mizo in pogledom na hiše in hribe" loading="lazy" /></div>
    <div class="block rv">
      <h2><Fragment set:html={t('Narava vas čaka','Nature awaits')} /><br /><Fragment set:html={t('Na prostem','Outdoors')} /></h2>
      <p><Fragment set:html={t(`${f.lake}, ${f.center}. ${f.outdoor}. Pet krajev iz vodnika gostiteljev najdete spodaj.`,`${e.lake}, ${e.center}. ${e.outdoor}. Five places from the hosts' guide are listed below.`)} /></p>
      <a class="btn" href="#okolica"><Fragment set:html={t('Razišči okolico','Explore the area')} /></a>
    </div>
    <div class="figure narrow rv"><img src={A+'strato-09.jpg'} alt="Kuhinja z jedilnico" loading="lazy" /></div>
    <div class="block rv">
      <h2><Fragment set:html={t('Kuhinja in oprema','Kitchen and amenities')} /></h2>
      <p><Fragment set:html={t(`${f.kitchen}. ${f.bathroom}. ${f.climate}.`,`${e.kitchen}. ${e.bathroom}. ${e.climate}.`)} /></p>
      <div class="figure duo"><img src={A+'strato-kopalnica-1.jpg'} width="1440" height="958" alt="Kopalnica s tušem" loading="lazy" /><img src={A+'strato-vrt-1.jpg'} width="1440" height="958" alt="Hiša in vrt z napisom Strato Apartment" loading="lazy" /></div>
      <ul class="amen">{amen.map(([sl,en]) => (<li><Fragment set:html={t(sl,en)} /></li>))}</ul>
    </div>
  </div>
</section>

<section id="galerija" class="gal">
  <div class="wrap">
    <span class="over rv"><Fragment set:html={t('Fotografije','Photographs')} /></span>
    <h2 class="rv"><Fragment set:html={t('Galerija apartmaja','Apartment gallery')} /></h2>
    <div class="grid3 rv">{gallery.map((n) => (<img src={A+'strato-'+n+'.jpg'} alt="Strato Apartment" loading="lazy" />))}</div>
  </div>
</section>

<section id="ocene" class="ocene">
  <div class="wrap">
    <span class="over rv"><Fragment set:html={t('Ocene gostov','Guest ratings')} /></span>
    <h2 class="rv"><Fragment set:html={t('Kaj pravijo naši gostje','What our guests say')} /></h2>
    <div class="scores rv">
      <div class="score"><b>9,9</b><div><small>Booking.com</small><span><Fragment set:html={t(d.ratings.booking,'9.9 / 10 (10 reviews) – Exceptional; staff 10, cleanliness 10, comfort 10, location 9.6')} /></span></div></div>
      <div class="score"><b>5,0</b><div><small>Airbnb</small><span><Fragment set:html={t(d.ratings.airbnb,'5.0 / 5 (9 reviews) – Guest favourite')} /></span></div></div>
    </div>
    <div class="cards rv" id="revs">
      {reviews.map((r) => (
        <div>
          <h3>{r.name}</h3>
          <p><Fragment set:html={t(r.sl, r.en)} /></p>
          <div class="meta">{r.source} · <i><Fragment set:html={t(split(r.date)[0], split(r.date)[1] || split(r.date)[0])} /></i>{r.translated && <> · <span class="tr"><Fragment set:html={t('prevedeno','translated')} /></span></>}</div>
        </div>
      ))}
    </div>
    <div class="arrows"><button type="button" data-for="revs" data-dir="-1" aria-label="Prejšnja / Previous">←</button><button type="button" data-for="revs" data-dir="1" aria-label="Naslednja / Next">→</button></div>
  </div>
</section>

<div class="cta rv">
  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="1.5"/><path d="M3 10h18M8 3v4M16 3v4M12 13v4M10 15h4"/></svg>
  <div><h3><Fragment set:html={t('Ste pripravljeni na oddih?','Ready for a break?')} /></h3><p><Fragment set:html={t('Preverite razpoložljivost in rezervirajte bivanje še danes.','Check availability and book your stay today.')} /></p></div>
  <a class="btn brown" href="#bentral"><Fragment set:html={t('Preveri razpoložljivost','Check availability')} /></a>
</div>

<section id="bentral" class="res">
  <div class="wrap">
    <span class="over rv"><Fragment set:html={t('Rezervacija','Reservation')} /></span>
    <h2 class="rv"><Fragment set:html={t('Preverite proste termine','Check available dates')} /></h2>
    <div class="widget rv"><div><b>Bentral</b><Fragment set:html={t('Tu bo Bentral rezervacijski koledar (vstavimo kodo vtičnika).','The Bentral booking calendar will be here (plugin code to be inserted).')} /></div></div>
    <div class="acts rv">
      <a class="btn brown" href={d.phone_href}><Fragment set:html={t('Pokliči','Call')} /> {d.phone}</a>
      <a class="btn" href={'mailto:'+d.email}><Fragment set:html={t('Pošlji e-pošto','Send an e-mail')} /></a>
    </div>
    <div class="kv rv">
      <div><b><Fragment set:html={t('Prijava','Check-in')} /></b><Fragment set:html={t(f.checkin,e.checkin)} /></div>
      <div><b><Fragment set:html={t('Odjava','Check-out')} /></b><Fragment set:html={t(f.checkout,e.checkout)} /></div>
      <div><b><Fragment set:html={t('Hišni red','House rules')} /></b><Fragment set:html={t(f.rules,e.rules)} /></div>
    </div>
  </div>
</section>

<section id="okolica" class="okolica">
  <div class="wrap">
    <span class="over rv"><Fragment set:html={t('Ne zamudite','Don’t miss')} /></span>
    <h2 class="rv"><Fragment set:html={t('Kaj početi v okolici','Things to do nearby')} /></h2>
    <div class="cards rv" id="places" style="margin-top:22px">
      {todo.map((p) => (<div data-todo><Fragment set:html={pimg(p)} /><h3><Fragment set:html={t(p.sl,p.en)} /></h3><p><Fragment set:html={t(p.note_sl,p.note_en)} /></p><a class="more" href={d.maps} target="_blank" rel="noopener"><Fragment set:html={t('Več','More')} /></a><Fragment set:html={cr(p)} /></div>))}
    </div>
    <div class="arrows"><button type="button" data-for="places" data-dir="-1" aria-label="Prejšnja / Previous">←</button><button type="button" data-for="places" data-dir="1" aria-label="Naslednja / Next">→</button></div>
    <p class="chips rv"><b><Fragment set:html={t('Več iz vodnika:','More from the guide:')} /></b> {d.more_from_guide.map((m) => (<span>{m}</span>))}</p>
  </div>
</section>

<section id="kontakt" class="kontakt">
  <div class="wrap">
    <h2 class="rv"><Fragment set:html={t('Bi želeli povprašati<br />o prostem terminu?','Would you like to ask<br />about a free date?')} /></h2>
    <span class="over rv"><Fragment set:html={t('Pišite nam prek obrazca','Write to us via the form')} /></span>
    <form class="form rv" id="cf" action={'mailto:'+d.email} method="post" enctype="text/plain">
      <label><Fragment set:html={t('Ime in priimek','Full name')} /><input name="ime" required autocomplete="name" /></label>
      <label><Fragment set:html={t('Vaš e-poštni naslov','Your e-mail address')} /><input name="email" type="email" required autocomplete="email" /></label>
      <div class="two">
        <label><Fragment set:html={t('Prihod','Check-in')} /><input name="od" type="date" /></label>
        <label><Fragment set:html={t('Odhod','Check-out')} /><input name="do" type="date" /></label>
      </div>
      <label><Fragment set:html={t('Sporočilo','Message')} /><textarea name="sporocilo" required></textarea></label>
      <div><button class="btn outline" type="submit"><Fragment set:html={t('Pošljite povpraševanje','Send enquiry')} /></button></div>
      <p class="hint"><Fragment set:html={t('Obrazec odpre vaš e-poštni program s pripravljenim sporočilom za strato.apartment@gmail.com – pošljete ga vi. Nič se ne shranjuje na strani.','This form opens your e-mail app with a message prepared for strato.apartment@gmail.com – you send it yourself. Nothing is stored on the site.')} /></p>
    </form>
  </div>
</section>

</main>

<footer>
  <div class="wrap">
    <div class="fgrid">
      <div><p class="tag"><Fragment set:html={t('Kjer se mir<br />sreča z jezerom','Where calm<br />meets the lake')} /></p><p style="font-size:15px;color:var(--text)">{d.hosts}</p></div>
      <div><h2><Fragment set:html={t('Hitre povezave','Quick links')} /></h2><ul>
        <li><a href="#apartma"><Fragment set:html={t('Apartma','Apartment')} /></a></li>
        <li><a href="#galerija"><Fragment set:html={t('Galerija','Gallery')} /></a></li>
        <li><a href="#ocene"><Fragment set:html={t('Ocene gostov','Guest reviews')} /></a></li>
        <li><a href="#okolica"><Fragment set:html={t('Okolica','Things to do')} /></a></li>
        <li><a href="#bentral"><Fragment set:html={t('Rezervacija','Reservation')} /></a></li>
      </ul></div>
      <div><h2><Fragment set:html={t('Kontakt','Contact')} /></h2><ul>
        <li class="ico"><svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg><a href={d.maps} target="_blank" rel="noopener">{d.address}</a></li>
        <li class="ico"><svg viewBox="0 0 24 24"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.6 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .6 3.6 1 1 0 0 1-.25 1z"/></svg><a href={d.phone_href}>{d.phone}</a></li>
        <li class="ico"><svg viewBox="0 0 24 24"><path d="M2 5h20v14H2z M2 5l10 8 10-8" fill="none" stroke="#000" stroke-width="2"/></svg><a href={'mailto:'+d.email}>{d.email}</a></li>
      </ul></div>
      <div><h2><Fragment set:html={t('Informacije','Information')} /></h2><ul>
        <li><Fragment set:html={t(f.checkin,e.checkin)} /></li>
        <li><Fragment set:html={t(f.checkout,e.checkout)} /></li>
        <li><Fragment set:html={t(f.rules,e.rules)} /></li>
      </ul>
      <div class="slot"><b>Green & Safe</b><Fragment set:html={t('Logo Green & Safe (pošljeta gostitelja)','Green & Safe logo (to be supplied by the hosts)')} /></div>
      <p class="koc"><a href={d.kocevsko_link} target="_blank" rel="noopener"><Fragment set:html={t('Najdete nas tudi na Kočevsko.com','Find us on Kočevsko.com too')} /></a></p></div>
    </div>
    <div class="copy"><span>© 2026 Strato Apartment. <Fragment set:html={t('Vse pravice pridržane.','All rights reserved.')} /></span><span>Predogled: AK agencija</span></div>
  </div>
</footer>

<script is:inline>
(function(){
  var h=document.documentElement;
  var titles={sl:'Strato Apartment · Kočevje',en:'Strato Apartment · Kočevje, Slovenia'};
  function setLang(l){h.lang=l;document.title=titles[l];try{localStorage.setItem('strato-lang',l)}catch(e){}
    document.querySelectorAll('[data-set]').forEach(function(b){b.setAttribute('aria-pressed',String(b.dataset.set===l))});}
  document.querySelectorAll('[data-set]').forEach(function(b){b.addEventListener('click',function(){setLang(b.dataset.set)})});
  setLang(h.lang==='en'?'en':'sl');
  var ov=document.getElementById('overlay');
  document.getElementById('burger').addEventListener('click',function(){ov.classList.add('open')});
  document.getElementById('close').addEventListener('click',function(){ov.classList.remove('open')});
  ov.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(){ov.classList.remove('open')})});
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}})},{threshold:.08,rootMargin:'0px 0px -5% 0px'});
    document.querySelectorAll('.rv').forEach(function(el){var r=el.getBoundingClientRect();if(r.top<innerHeight&&r.bottom>0){el.classList.add('in')}else{io.observe(el)}});
  } else { document.querySelectorAll('.rv').forEach(function(el){el.classList.add('in')}); }
  addEventListener('scroll',function(){document.querySelectorAll('.rv:not(.in)').forEach(function(el){if(el.getBoundingClientRect().top<innerHeight)el.classList.add('in')})},{passive:true});
  var rm=matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('.arrows button').forEach(function(b){b.addEventListener('click',function(){
    var s=document.getElementById(b.dataset.for); var c=s.firstElementChild; var w=c.getBoundingClientRect().width+40;
    s.scrollBy({left:w*Number(b.dataset.dir),behavior:rm?'auto':'smooth'});
  })});
  var quick=document.getElementById('quick'), cf=document.getElementById('cf');
  quick.addEventListener('submit',function(ev){ev.preventDefault();
    if(quick.od.value) cf.od.value=quick.od.value; if(quick.do.value) cf.do.value=quick.do.value;
    if(quick.gostje.value && !cf.sporocilo.value) cf.sporocilo.value=(h.lang==='en'?'Guests: ':'Število gostov: ')+quick.gostje.value;
    document.getElementById('bentral').scrollIntoView({behavior:rm?'auto':'smooth'});
  });
  cf.addEventListener('submit',function(ev){ev.preventDefault();
    var en=h.lang==='en';
    var body=(en?'Name: ':'Ime: ')+cf.ime.value+'\n'+(en?'E-mail: ':'E-pošta: ')+cf.email.value+'\n'+(en?'Dates: ':'Termin: ')+(cf.od.value||'–')+' – '+(cf.do.value||'–')+'\n\n'+cf.sporocilo.value;
    location.href='mailto:'+'strato.apartment@gmail.com'+'?subject='+encodeURIComponent(en?'Enquiry – Strato Apartment':'Povpraševanje – Strato Apartment')+'&body='+encodeURIComponent(body);
  });
})();
</script>
</body>
</html>
