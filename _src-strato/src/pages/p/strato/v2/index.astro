---
// Strato Apartment – preview v2. Structure and look mirror resort-beatrice.si: dark gold-text top
// bar, light header with mark + serif wordmark, Inter nav, gold gradient button; full-viewport hero
// with light headline + italic serif word and two buttons; ratings strip; centred "about";
// three overlapping rounded photos; dark accommodation carousel; cream statement; photo rows;
// green amenities with line icons; location; testimonial cards; FAQ; dark cards; closing CTA;
// four-column footer. Code, copy and photos are our own; facts from strato.json.
import d from '../../../../data/strato.json';
const t = (sl: string, en: string) => `<span data-lang="sl">${sl}</span><span data-lang="en">${en}</span>`;
const photos: Record<string, [string, string]> = {
  '01': ['Dnevna soba s kavčem in pisalno mizo', 'Living room with sofa and desk'],
  '02': ['Dnevna soba s TV in kitaro', 'Living room with TV and guitar'],
  '03': ['Klavir in delovni kotiček', 'Piano and desk corner'],
  '04': ['Kitara in klavir', 'Guitar and piano'],
  '05': ['Dnevna soba s klavirjem', 'Living room with piano'],
  '06': ['Kuhinja', 'Kitchen'], '07': ['Kuhinja z jedilnico', 'Kitchen with dining area'],
  '08': ['Kuhinjski pult', 'Kitchen counter'], '09': ['Jedilnica', 'Dining area'],
  '10': ['Velika spalnica', 'Main bedroom'], '11': ['Velika spalnica z omaro', 'Main bedroom with wardrobe'],
  '12': ['Velika spalnica', 'Main bedroom'], '13': ['Velika spalnica', 'Main bedroom'],
  '14': ['Manjša spalnica s sedalnimi vrečami', 'Second bedroom with bean bags'], '15': ['Manjša spalnica', 'Second bedroom'],
};
const img = (n: string, cls = '', loading: 'lazy' | 'eager' = 'lazy') =>
  `<img src="../assets/strato-${n}.jpg" width="950" height="632" loading="${loading}" decoding="async" class="${cls}" alt="${photos[n][0]}" data-alt-sl="${photos[n][0]}" data-alt-en="${photos[n][1]}">`;
const S = d.facts_sl as any, E = d.facts_en as any;
const mailSl = 'Povpraševanje – Strato Apartment', mailEn = 'Enquiry – Strato Apartment';
const dsl = (x: string) => x.split(' / ')[0], den = (x: string) => x.split(' / ')[1] || x;
const cards = [
  { n: '05', sl: 'Dnevna soba', en: 'Living room', k: 'living' },
  { n: '06', sl: 'Kuhinja', en: 'Kitchen', k: 'kitchen' },
  { n: '12', sl: 'Velika spalnica', en: 'Main bedroom', k: 'bedroom1' },
  { n: '15', sl: 'Manjša spalnica', en: 'Second bedroom', k: 'bedroom2' },
];
const amenIcons: [string, string, string][] = [
  ['M4 20V10h16v10M4 15h16M7 10V7h4v3M13 10V7h4v3', 'Dve spalnici', 'Two bedrooms'],
  ['M6 10V7a6 6 0 0 1 12 0v3M5 10h14v11H5z', 'Samostojna prijava s kodo', 'Self check-in with a code'],
  ['M4 7h16v10H4zM4 12h16M9 17v3M15 17v3', 'Kuhinja z indukcijo in pečico', 'Kitchen with induction hob and oven'],
  ['M5 12a7 7 0 0 1 14 0M8 15a4 4 0 0 1 8 0M12 18h.01', 'Brezplačen WiFi', 'Free WiFi'],
  ['M4 17h16M6 17V9l6-4 6 4v8M9 17v-4h6v4', 'Zasebno parkirišče', 'Private parking'],
  ['M12 3v2M12 19v2M3 12h2M19 12h2M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z', 'Terasa, vrt in žar', 'Terrace, garden and barbecue'],
  ['M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16zM8 12h8', 'Toplotna črpalka in klima', 'Heat pump and air conditioning'],
  ['M5 20V8h14v12M9 4h6v4H9zM9 14h6', 'Otroška posteljica', 'Baby cot'],
];
---
<!doctype html>
<html lang="sl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Strato Apartment – Kočevje</title>
<meta name="description" content="Strato Apartment, Kočevje: apartma 74 m² za do 5 oseb, 270 m od Kočevskega jezera. Predogled.">
<meta name="robots" content="noindex">
<script is:inline>try{var l=localStorage.getItem('strato-lang');if(l==='en'||l==='sl')document.documentElement.lang=l}catch(e){}</script>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;1,800;1,900&display=swap" rel="stylesheet">
<style is:global>
:root{--bg:#f6f6f3;--cream:#f3efe9;--dark:#2d2d2d;--green:#3c4b3f;--ink:#232323;--grey:#5f5f5f;--gold:#c9a258;--gold2:#e2c98b;--line:#d9d9d4;--max:1300px;--r:18px}
*{box-sizing:border-box}
html{scroll-behavior:smooth}@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Inter',sans-serif;font-size:16px;line-height:1.6}
html[lang=sl] [data-lang=en],html[lang=en] [data-lang=sl]{display:none!important}
img{display:block;max-width:100%;height:auto}
a{color:inherit}
p{margin:0}
h1,h2,h3{margin:0;font-weight:300;line-height:1.1;letter-spacing:-.01em}
h1{font-size:clamp(2.6rem,5.6vw,4.6rem)}
h2{font-size:clamp(2rem,3.6vw,3.1rem)}
em.s{font-family:'Playfair Display',serif;font-style:italic;font-weight:900;letter-spacing:-.01em}
.label{font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}
.wrap{max-width:var(--max);margin:0 auto;padding:0 70px}
@media (max-width:900px){.wrap{padding:0 24px}}
section{padding:110px 0}
@media (max-width:760px){section{padding:70px 0}}
.center{text-align:center}
.btn{display:inline-block;font-size:.9rem;font-weight:500;padding:13px 24px;text-decoration:none;border:1px solid transparent;cursor:pointer;font-family:inherit;transition:filter .2s}
.btn.gold{background:linear-gradient(100deg,var(--gold) 0%,var(--gold2) 100%);color:var(--ink)}
.btn.gold:hover{filter:brightness(1.05)}
.btn.out{border-color:var(--ink);color:var(--ink);background:transparent}
.btn.outw{border-color:#fff;color:#fff;background:transparent}
/* top bar + header */
.topbar{background:var(--dark);color:var(--gold);text-align:center;font-size:.7rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;padding:12px 16px}
header{background:#f4f5f1;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:50}
header .wrap{height:72px;display:flex;align-items:center;gap:30px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;font-family:'Playfair Display',serif;font-size:1.65rem;color:var(--ink)}
.brand svg{width:46px;height:46px}
nav.main{flex:1;display:flex;justify-content:center;gap:34px;font-size:1rem}
nav.main a{text-decoration:none}
.lang{display:flex;gap:4px;align-items:center;font-size:.95rem;margin-right:28px}
.lang button{border:0;background:none;font:inherit;cursor:pointer;padding:4px 6px;color:var(--grey)}
.lang button[aria-pressed=true]{color:var(--ink);font-weight:500}
.burger{display:none;border:0;background:none;cursor:pointer;width:30px;height:22px;position:relative}
.burger span,.burger span::before,.burger span::after{content:"";position:absolute;left:0;width:28px;height:2px;background:var(--ink);top:10px}
.burger span::before{top:-9px}.burger span::after{top:9px}
@media (max-width:1000px){
  header .wrap{height:64px;justify-content:space-between}
  nav.main,header .btn{display:none}
  .lang{margin:0 0 0 auto}
  .burger{display:block}
  nav.main.open{display:flex;position:absolute;top:64px;left:0;right:0;background:#f4f5f1;border-bottom:1px solid var(--line);flex-direction:column;gap:14px;padding:22px 24px}
}
/* hero */
.hero{position:relative;height:100svh;min-height:640px;display:grid;place-items:center;text-align:center;color:#fff;overflow:hidden;padding:0}
.slide{position:absolute;inset:0;opacity:0;transition:opacity 1.4s}
.slide.on{opacity:1}
.slide img{width:100%;height:100%;object-fit:cover}
.hero::after{content:"";position:absolute;inset:0;background:rgba(40,40,45,.5)}
.hero .in{position:relative;z-index:2;max-width:820px;padding:0 24px}
.hero h1{color:#f3efe9}
.hero p{margin:22px auto 30px;max-width:60ch;font-size:1.05rem}
.hero .cta{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.bars{position:absolute;bottom:26px;left:50%;transform:translateX(-50%);display:flex;gap:16px;z-index:2}
.bars button{width:min(280px,22vw);height:2px;background:rgba(255,255,255,.35);border:0;padding:0;cursor:pointer}
.bars button[aria-current=true]{background:#fff}
/* ratings strip */
.strip{display:flex;align-items:center;gap:40px;flex-wrap:wrap;padding:46px 0}
.strip .label{line-height:1.5}
.strip .plat{display:flex;align-items:center;gap:14px;font-size:1.5rem;color:#8a8a8a;font-weight:500;flex:1;justify-content:center}
.strip .badge{background:linear-gradient(135deg,var(--gold2),var(--gold));color:var(--ink);font-size:1rem;font-weight:600;padding:8px 12px;border-radius:10px}
/* about */
.about .wrap{max-width:900px}
.about h2{margin:14px 0 22px}
.about p{color:#333;font-size:1.05rem}
.about .btn{margin-top:30px}
/* collage */
.collage{position:relative;height:720px;max-width:1300px;margin:0 auto}
.collage img{position:absolute;object-fit:cover;border-radius:var(--r)}
.collage .a{left:6%;top:0;width:36%;height:72%}
.collage .b{left:28%;top:11%;width:46%;height:89%;z-index:1}
.collage .c{right:6%;top:18%;width:36%;height:55%;z-index:2}
@media (max-width:760px){.collage{height:auto;display:grid;gap:10px;padding:0 24px}.collage img{position:static;width:100%;height:auto;aspect-ratio:3/2}}
/* dark carousel */
.dark{background:var(--dark);color:#f0ede6}
.acc{display:grid;grid-template-columns:320px 1fr;gap:80px;align-items:start}
@media (max-width:900px){.acc{grid-template-columns:1fr;gap:40px}}
.acc h2{margin:14px 0 22px;color:#fff}
.acc p{color:#e6e2da;font-size:1rem}
.acc .btn{margin-top:36px}
.track{display:flex;gap:30px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:10px;scrollbar-width:none}
.track::-webkit-scrollbar{display:none}
.card{flex:0 0 370px;scroll-snap-align:start}
.card img{border-radius:var(--r);aspect-ratio:1/1;object-fit:cover;width:100%}
.card .row{display:grid;grid-template-columns:70px 1fr;gap:8px;margin-top:22px}
.card .num{font-family:'Playfair Display',serif;font-size:2.3rem;color:var(--gold);line-height:1}
.card h3{font-family:'Playfair Display',serif;font-style:italic;font-weight:800;font-size:1.25rem;color:#fff}
.card p{font-size:.92rem;margin-top:8px}
.arrows{display:flex;gap:14px;margin-top:40px}
.arrows button{width:46px;height:46px;border-radius:50%;border:1px solid var(--gold);background:none;color:var(--gold);cursor:pointer;font-size:1.1rem}
/* statement */
.state{background:var(--cream)}
.state .wrap{max-width:900px}
.state p{margin-top:28px;color:#333;font-size:1.05rem}
.rows{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;padding:0 0 0;max-width:none}
.rows+.rows{margin-top:14px}
.rows img{aspect-ratio:4/3;object-fit:cover;width:100%}
@media (max-width:700px){.rows{grid-template-columns:1fr 1fr}}
/* green amenities */
.green{background:var(--green);color:#eef1ec}
.green h2{color:#fff;margin:14px 0 22px}
.green .wrap>p{max-width:760px;margin:0 auto}
.icons{display:grid;grid-template-columns:repeat(4,1fr);gap:40px 20px;margin-top:70px;text-align:center}
@media (max-width:760px){.icons{grid-template-columns:1fr 1fr}}
.icons svg{width:54px;height:54px;color:var(--gold);margin-bottom:14px}
.icons b{font-weight:500;font-size:1rem}
/* location */
.loc{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}
@media (max-width:900px){.loc{grid-template-columns:1fr;gap:40px}}
.loc h2{margin:14px 0 24px}
.loc .btn{margin-top:30px}
.loc ol{margin:26px 0 0;padding:0 0 0 20px;color:#333}
.loc ol li{margin-bottom:6px}
.loc .more{font-size:.9rem;color:var(--grey);margin-top:16px}
.lcol{position:relative;height:720px}
.lcol img{position:absolute;object-fit:cover;border-radius:var(--r)}
.lcol .a{left:10%;top:0;width:80%;height:100%}
.lcol .b{right:0;top:10%;width:40%;height:34%;z-index:2;border:4px solid var(--bg)}
.lcol .c{left:0;bottom:12%;width:46%;height:26%;z-index:2;border:4px solid var(--bg)}
@media (max-width:900px){.lcol{height:auto}.lcol img{position:static;width:100%;height:auto;aspect-ratio:3/2;border:0}.lcol .b,.lcol .c{display:none}}
/* testimonials */
.testi{background:var(--cream)}
.testi .sub{margin-top:18px;color:#333}
.ttrack{display:flex;gap:30px;overflow-x:auto;scroll-snap-type:x mandatory;margin-top:60px;padding-bottom:10px;scrollbar-width:none}
.ttrack::-webkit-scrollbar{display:none}
.tcard{flex:0 0 min(100%,640px);scroll-snap-align:start;background:#fff;border-radius:var(--r);padding:60px 60px 50px;box-shadow:0 10px 40px rgba(0,0,0,.04)}
@media (max-width:700px){.tcard{padding:36px 26px}}
.stars{color:var(--gold);letter-spacing:4px;font-size:1.1rem;margin-bottom:26px}
.tcard p{font-size:1rem;color:#333}
.tcard .who{margin-top:30px;font-size:.85rem}
.tcard .who b{display:block;font-weight:600}
.tcard .who span{color:var(--grey)}
.tnav{display:flex;justify-content:space-between;align-items:center;margin-top:30px}
.dots{display:flex;gap:6px}.dots i{width:6px;height:6px;border-radius:50%;background:#bbb}.dots i:first-child{background:#444}
.tnav .arrows{margin:0}.tnav .arrows button{color:var(--ink);border-color:var(--ink)}
/* faq */
.faq{display:grid;grid-template-columns:1fr 1.2fr;gap:80px;align-items:start}
@media (max-width:900px){.faq{grid-template-columns:1fr;gap:34px}}
.faq h2{margin-bottom:22px}
.faq .btn{margin-top:26px}
details{border-top:1px solid var(--line)}
details:last-child{border-bottom:1px solid var(--line)}
summary{cursor:pointer;list-style:none;padding:20px 0;display:flex;justify-content:space-between;gap:14px;font-size:.98rem}
summary::-webkit-details-marker{display:none}
summary::after{content:"⌄";font-size:1.2rem;line-height:1;transition:transform .25s}
details[open] summary::after{transform:rotate(180deg)}
details p{padding:0 0 20px;color:#333}
/* trip cards */
.trips .head{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
@media (max-width:900px){.trips .head{grid-template-columns:1fr;gap:20px}}
.trips h2{color:#fff;margin-top:14px}
.tcards{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;margin-top:70px}
@media (max-width:900px){.tcards{grid-template-columns:1fr}}
.tc{background:#fff;color:var(--ink);border-radius:4px;overflow:hidden}
.tc .top{height:170px;background:linear-gradient(135deg,var(--green),#56685a);display:grid;place-items:center;color:var(--gold);font-family:'Playfair Display',serif;font-size:3rem}
.tc .body{padding:26px}
.tc h3{font-size:1.15rem;font-weight:500;margin-bottom:8px}
.tc p{font-size:.9rem;color:#444}
.trips .more{margin-top:40px;color:#cfcac0;font-size:.92rem;text-align:center}
/* closing / booking */
.close .wrap{max-width:860px}
.close svg{width:120px;height:120px;margin:0 auto 30px}
.close h2{margin-bottom:22px}
.widget{margin:40px auto 0;border:1px dashed var(--gold);background:#fff;border-radius:var(--r);min-height:300px;display:grid;place-items:center;text-align:center;padding:30px}
.widget .label{display:block;margin-bottom:10px}
.actions{display:flex;justify-content:center;gap:14px;flex-wrap:wrap;margin-top:26px}
/* contact */
.contact{display:grid;grid-template-columns:1fr 1.2fr;gap:80px}
@media (max-width:900px){.contact{grid-template-columns:1fr;gap:34px}}
form{display:grid;gap:14px}
label{display:grid;gap:6px;font-size:.85rem;color:var(--grey)}
input,textarea{font:inherit;padding:13px 14px;border:1px solid var(--line);border-radius:6px;background:#fff;color:var(--ink);width:100%}
textarea{min-height:120px;resize:vertical}
.hint{font-size:.82rem;color:var(--grey)}
dl{margin:26px 0 0;display:grid;gap:14px}
dt{font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);font-weight:600}
dd{margin:2px 0 0}
/* footer */
footer{padding:70px 0 30px;border-top:1px solid var(--line)}
.fgrid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:40px}
@media (max-width:900px){.fgrid{grid-template-columns:1fr 1fr}}
@media (max-width:560px){.fgrid{grid-template-columns:1fr}}
footer .label{display:block;margin-bottom:16px}
footer a{display:block;text-decoration:none;font-size:.95rem;margin-bottom:8px}
footer p{font-size:.95rem;color:#444;max-width:360px;margin-top:16px}
.fbot{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;margin-top:60px;padding-top:24px;border-top:1px solid var(--line);font-size:.85rem;color:var(--grey)}
.logo-slot{width:150px;height:84px;border:1px dashed var(--grey);border-radius:8px;display:grid;place-items:center;text-align:center;font-size:.68rem;color:var(--grey);padding:8px;background:#fff}
.rv{opacity:1}
@media (prefers-reduced-motion:no-preference){.rv{opacity:0;transform:translateY(18px);transition:opacity .8s,transform .8s}.rv.in{opacity:1;transform:none}}
</style>
</head>
<body>
<div class="topbar"><Fragment set:html={t('Rezervirajte neposredno pri gostiteljih Barbari in Roku','Book directly with your hosts Barbara and Rok')} /></div>
<header>
  <div class="wrap">
    <a class="brand" href="#top"><svg viewBox="0 0 46 46" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="6"/><rect x="25" y="3" width="18" height="18" rx="6"/><rect x="3" y="25" width="18" height="18" rx="6"/><rect x="25" y="25" width="18" height="18" rx="6"/></svg>Strato</a>
    <nav class="main" id="menu" aria-label="Meni">
      <a href="#apartma"><Fragment set:html={t('Apartma','Apartment')} /></a>
      <a href="#oprema"><Fragment set:html={t('Oprema','Amenities')} /></a>
      <a href="#okolica"><Fragment set:html={t('Okolica','Location')} /></a>
      <a href="#ocene"><Fragment set:html={t('Ocene','Reviews')} /></a>
      <a href="#vprasanja"><Fragment set:html={t('Vprašanja','FAQ')} /></a>
      <a href="#kontakt"><Fragment set:html={t('Kontakt','Contact')} /></a>
    </nav>
    <div class="lang" role="group" aria-label="Jezik / Language"><button type="button" data-set-lang="sl" aria-pressed="true">SL</button><span>·</span><button type="button" data-set-lang="en" aria-pressed="false">EN</button></div>
    <a class="btn gold" href="#bentral"><Fragment set:html={t('REZERVIRAJ','BOOK NOW')} /></a>
    <button class="burger" type="button" aria-label="Meni" aria-controls="menu" aria-expanded="false"><span></span></button>
  </div>
</header>

<main id="top">
  <section class="hero">
    {['02','09','12'].map((n,i) => (<div class={`slide${i===0?' on':''}`} data-slide><Fragment set:html={img(n,'',i===0?'eager':'lazy')} /></div>))}
    <div class="in">
      <h1><Fragment set:html={t('Kjer se <em class="s">dom</em><br>začne na dopustu','Where <em class="s">home</em><br>begins on holiday')} /></h1>
      <p><Fragment set:html={t(`Strato Apartment, ${S.size} za ${S.guests} v Kočevju. ${S.lake}, ${S.center}.`,`Strato Apartment, ${E.size} for ${E.guests} in Kočevje. ${E.lake}, ${E.center}.`)} /></p>
      <div class="cta"><a class="btn gold" href="#bentral"><Fragment set:html={t('Preveri razpoložljivost','Check availability')} /></a><a class="btn outw" href="#apartma"><Fragment set:html={t('Razišči apartma','Explore the apartment')} /></a></div>
    </div>
    <div class="bars">{[0,1,2].map(i => (<button type="button" data-dot={i} aria-current={i===0?'true':'false'} aria-label={`Slika ${i+1}`}></button>))}</div>
  </section>

  <div class="wrap strip rv">
    <span class="label"><Fragment set:html={t('Ocene gostov<br>prebrane 25. 11. 2026','Guest scores<br>as read 25 Nov 2026')} /></span>
    <div class="plat">Booking.com <span class="badge"><Fragment set:html={t('9,9','9.9')} /></span></div>
    <div class="plat">airbnb <span class="badge"><Fragment set:html={t('5,0','5.0')} /></span></div>
    <div class="plat" style="font-size:1rem;color:var(--grey)"><Fragment set:html={t('10 + 9 ocen · Izbira gostov','10 + 9 reviews · Guest favourite')} /></div>
  </div>

  <section class="about center" id="apartma">
    <div class="wrap rv">
      <span class="label"><Fragment set:html={t('O apartmaju','About')} /></span>
      <h2><Fragment set:html={t('Več kot le <em class="s">prostor za bivanje</em>','More than just a <em class="s">place to stay</em>')} /></h2>
      <p><Fragment set:html={t(`${S.bedrooms}. ${S.living}. ${S.renovated}. Gostitelja Barbara in Rok vas sprejmeta osebno ali pa se prijavite sami s kodo.`,`${E.bedrooms}. ${E.living}. ${E.renovated}. Your hosts Barbara and Rok welcome you in person, or you check in yourself with a code.`)} /></p>
      <a class="btn out" href="#oprema"><Fragment set:html={t('Več o apartmaju','More about the apartment')} /></a>
    </div>
  </section>

