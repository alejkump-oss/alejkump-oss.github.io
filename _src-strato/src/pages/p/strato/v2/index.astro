---
// Strato Apartment – preview v2 ("Lakeside resort editorial" archetype).
// Feel borrowed from a modern resort site: one calm sans for everything, a serif only for
// numerals and one italic word, full-bleed centered hero with two buttons, a stats row,
// alternating image/text blocks, a horizontal gallery, an FAQ list.
// All code, copy and layout are original. Facts come only from src/data/strato.json.
import d from '../../../../data/strato.json';

const t = (sl: string, en: string) =>
  `<span data-lang="sl">${sl}</span><span data-lang="en">${en}</span>`;

const labels: Record<string, [string, string]> = {
  kitchen: ['Kuhinja', 'Kitchen'],
  bedroom1: ['Velika spalnica', 'Main bedroom'],
  bedroom2: ['Manjša spalnica', 'Second bedroom'],
  living: ['Dnevna soba', 'Living room'],
  bathroom: ['Kopalnica', 'Bathroom'],
  climate: ['Ogrevanje in hlajenje', 'Heating and cooling'],
  outdoor: ['Zunaj', 'Outdoors'],
  parking: ['Parkiranje', 'Parking'],
  extras: ['Dodatno', 'Extras'],
  bedrooms: ['Spanje', 'Sleeping'],
};
const amenityKeys = ['kitchen','living','bedroom1','bedroom2','bathroom','climate','outdoor','parking','extras','bedrooms'];

const photos: Record<string, [string, string]> = {
  '01': ['Dnevna soba s kavčem in pisalno mizo', 'Living room with sofa and desk'],
  '02': ['Dnevna soba s TV in kitaro', 'Living room with TV and guitar'],
  '03': ['Klavir in delovni kotiček', 'Piano and desk corner'],
  '04': ['Kitara in klavir', 'Guitar and piano'],
  '05': ['Dnevna soba s klavirjem', 'Living room with piano'],
  '06': ['Kuhinja', 'Kitchen'],
  '07': ['Kuhinja z jedilnico', 'Kitchen with dining area'],
  '08': ['Kuhinjski pult', 'Kitchen counter'],
  '09': ['Jedilnica', 'Dining area'],
  '10': ['Velika spalnica', 'Main bedroom'],
  '11': ['Velika spalnica z omaro', 'Main bedroom with wardrobe'],
  '12': ['Velika spalnica', 'Main bedroom'],
  '13': ['Velika spalnica', 'Main bedroom'],
  '14': ['Manjša spalnica s sedalnimi vrečami', 'Second bedroom with bean bags'],
  '15': ['Manjša spalnica', 'Second bedroom'],
};
const img = (n: string, cls = '', loading: 'lazy' | 'eager' = 'lazy') =>
  `<img src="../assets/strato-${n}.jpg" width="950" height="632" loading="${loading}" decoding="async" class="${cls}" alt="${photos[n][0]}" data-alt-sl="${photos[n][0]}" data-alt-en="${photos[n][1]}">`;

const blocks = [
  { n: '05', key: 'living' },
  { n: '07', key: 'kitchen' },
  { n: '12', key: 'bedroom1' },
  { n: '15', key: 'bedroom2' },
];
const galleryIds = ['01','03','04','06','08','09','10','11','13','14'];

const mailSubjectSl = 'Povpraševanje – Strato Apartment';
const mailSubjectEn = 'Enquiry – Strato Apartment';
---
<!doctype html>
<html lang="sl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Strato Apartment – Kočevje</title>
<meta name="description" content="Strato Apartment, Kočevje: apartma 74 m² za do 5 oseb, 270 m od Kočevskega jezera. Predogled spletne strani.">
<meta name="robots" content="noindex">
<script is:inline>try{var l=localStorage.getItem('strato-lang');if(l==='en'||l==='sl')document.documentElement.lang=l}catch(e){}</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;1,400&display=swap" rel="stylesheet">
<style is:global>
:root{
  --bg:#f7f4ef;--paper:#fffdf9;--ink:#23292e;--ink2:#5f6a73;--line:#e3ddd3;
  --lake:#4b6a7c;--lake2:#dfe8ec;--sand:#e9e1d3;
  --max:1180px;--r:6px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Inter',system-ui,sans-serif;font-size:16.5px;line-height:1.6;font-weight:400;-webkit-font-smoothing:antialiased}
html[lang=sl] [data-lang=en],html[lang=en] [data-lang=sl]{display:none!important}
img{display:block;max-width:100%;height:auto}
a{color:inherit}
p{margin:0}
h1,h2,h3{margin:0;font-weight:300;letter-spacing:-.025em;line-height:1.1}
h1{font-size:clamp(2.5rem,6.4vw,4.9rem)}
h2{font-size:clamp(1.9rem,3.8vw,2.9rem)}
h3{font-size:1.2rem;font-weight:500;letter-spacing:-.01em}
.serif{font-family:'Playfair Display',Georgia,serif}
em.serif{font-style:italic;font-weight:400}
.label{font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--ink2);font-weight:500}
.wrap{max-width:var(--max);margin:0 auto;padding:0 22px}
section{padding:96px 0}
@media (max-width:760px){section{padding:64px 0}}
.center{text-align:center}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:15px 26px;border-radius:var(--r);border:1px solid var(--ink);background:var(--ink);color:#fff;text-decoration:none;font-weight:500;font-size:.95rem;font-family:inherit;cursor:pointer;transition:background .2s,color .2s,border-color .2s}
.btn:hover{background:var(--lake);border-color:var(--lake)}
.btn.light{background:transparent;color:#fff;border-color:rgba(255,255,255,.8)}
.btn.light:hover{background:#fff;color:var(--ink)}
.btn.outline{background:transparent;color:var(--ink)}
.btn.outline:hover{background:var(--ink);color:#fff}
/* nav */
.nav{position:fixed;top:0;left:0;right:0;z-index:50;color:#fff;transition:background .3s,color .3s}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:76px;gap:16px}
.brand{text-decoration:none;font-weight:500;letter-spacing:.2em;text-transform:uppercase;font-size:.85rem}
.links{display:flex;gap:28px;font-size:.88rem}
.links a{text-decoration:none;opacity:.85}
.links a:hover{opacity:1}
@media (max-width:960px){.links{display:none}}
.lang{display:inline-flex;gap:2px;font-size:.78rem;font-weight:500;letter-spacing:.1em}
.lang button{border:0;background:transparent;color:inherit;font:inherit;padding:6px 8px;cursor:pointer;opacity:.6;border-bottom:1px solid transparent}
.lang button[aria-pressed=true]{opacity:1;border-bottom-color:currentColor}
.nav.solid{background:rgba(247,244,239,.92);backdrop-filter:blur(10px);color:var(--ink);border-bottom:1px solid var(--line)}
.nav.solid .wrap{height:62px}
/* hero */
.hero{position:relative;min-height:92vh;display:grid;place-items:center;color:#fff;text-align:center;padding:120px 0 90px;overflow:hidden}
.hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}
.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(25,32,38,.42),rgba(25,32,38,.22) 45%,rgba(25,32,38,.62));z-index:-1}
.hero .label{color:rgba(255,255,255,.8)}
.hero h1{margin:16px auto 20px;max-width:14ch}
.hero p.sub{max-width:52ch;margin:0 auto 34px;font-size:1.08rem;opacity:.92}
.hero .cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.scroll{position:absolute;bottom:26px;left:50%;transform:translateX(-50%);font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;opacity:.75}
/* stats */
.stats{background:var(--paper);border-bottom:1px solid var(--line)}
.stats .wrap{display:grid;grid-template-columns:repeat(4,1fr);padding:0}
.stat{padding:38px 22px;text-align:center;border-right:1px solid var(--line)}
.stat:last-child{border-right:0}
@media (max-width:760px){.stats .wrap{grid-template-columns:1fr 1fr}.stat:nth-child(2){border-right:0}.stat:nth-child(-n+2){border-bottom:1px solid var(--line)}}
.stat b{display:block;font-family:'Playfair Display',serif;font-weight:400;font-size:clamp(2.2rem,4.4vw,3.4rem);line-height:1;color:var(--lake)}
.stat b small{font-size:.45em;margin-left:4px}
.stat>span{display:block;margin-top:8px;font-size:.85rem;color:var(--ink2)}
/* intro */
.intro .wrap{max-width:780px}
.intro h2{margin:14px 0 22px}
.intro p{font-size:1.12rem;color:var(--ink2)}
/* blocks */
.block{display:grid;grid-template-columns:1fr 1fr;gap:0;align-items:stretch;background:var(--paper);border:1px solid var(--line);margin-bottom:22px}
.block:nth-child(even) .txt{order:-1}
@media (max-width:860px){.block{grid-template-columns:1fr}.block:nth-child(even) .txt{order:0}}
.block img{width:100%;height:100%;object-fit:cover;aspect-ratio:3/2}
.block .txt{padding:48px 44px;display:flex;flex-direction:column;justify-content:center;gap:14px}
@media (max-width:860px){.block .txt{padding:28px 22px}}
.block .txt h3{font-size:clamp(1.5rem,2.4vw,2rem);font-weight:300}
.block .txt p{color:var(--ink2)}
/* amenities */
.check{display:grid;grid-template-columns:1fr 1fr;gap:0 48px;margin-top:40px;border-top:1px solid var(--line)}
@media (max-width:760px){.check{grid-template-columns:1fr}}
.check div{padding:20px 0;border-bottom:1px solid var(--line);display:grid;grid-template-columns:150px 1fr;gap:14px}
@media (max-width:480px){.check div{grid-template-columns:1fr;gap:4px}}
.check .label{padding-top:4px;color:var(--lake)}
.check p{color:var(--ink);font-size:.97rem}
/* gallery scroll-snap */
.strip{margin-top:40px;display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 22px 14px;scrollbar-width:thin}
.strip figure{margin:0;flex:0 0 min(78vw,560px);scroll-snap-align:center}
.strip img{aspect-ratio:3/2;object-fit:cover;width:100%}
.strip figcaption{font-size:.8rem;color:var(--ink2);margin-top:8px}
.strip-wrap{max-width:none;padding:0}
.strip-head{max-width:var(--max);margin:0 auto;padding:0 22px;display:flex;justify-content:space-between;align-items:end;gap:20px}
.strip-head p{color:var(--ink2)}
/* ratings */
.rate{background:var(--lake);color:#f2f5f6}
.rate .label{color:#c6d4db}
.rate .pair{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:rgba(255,255,255,.18);margin:40px auto 0;max-width:760px;border:1px solid rgba(255,255,255,.18)}
.rate .pair div{background:var(--lake);padding:36px 20px;text-align:center}
.rate .pair b{display:block;font-family:'Playfair Display',serif;font-weight:400;font-size:clamp(3rem,6vw,4.6rem);line-height:1}
.rate .pair b small{font-size:.35em}
.rate .pair>div>span{display:block;margin-top:10px;color:#c6d4db;font-size:.9rem}
.slot{max-width:760px;margin:22px auto 0;border:1px dashed rgba(255,255,255,.5);padding:26px;text-align:center}
.slot .label{color:#f2f5f6;margin-bottom:16px;display:block}
.slot ul{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
@media (max-width:720px){.slot ul{grid-template-columns:repeat(2,1fr)}}
.slot li{border:1px dashed rgba(255,255,255,.3);min-height:90px;display:grid;place-items:center;font-size:.8rem;color:#c6d4db}
/* things to do */
.places{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-top:40px}
@media (max-width:1000px){.places{grid-template-columns:repeat(3,1fr)}}
@media (max-width:640px){.places{grid-template-columns:1fr 1fr}}
.place{background:var(--paper);border:1px solid var(--line);padding:24px 20px;min-height:170px;display:flex;flex-direction:column;justify-content:space-between;gap:16px}
.place b{font-family:'Playfair Display',serif;font-weight:400;font-size:1.6rem;color:var(--lake)}
.place h3{font-weight:500;font-size:1.05rem}
.place p{font-size:.88rem;color:var(--ink2);margin-top:4px}
.more{margin-top:28px;display:flex;flex-wrap:wrap;gap:8px 22px;font-size:.92rem;color:var(--ink2)}
.more span::before{content:"— ";color:var(--lake)}
/* faq */
.faq{max-width:780px;margin:40px auto 0;border-top:1px solid var(--line)}
details{border-bottom:1px solid var(--line)}
summary{cursor:pointer;list-style:none;padding:20px 0;display:flex;justify-content:space-between;align-items:center;gap:16px;font-weight:500}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";font-weight:300;font-size:1.5rem;color:var(--lake);transition:transform .25s}
details[open] summary::after{transform:rotate(45deg)}
details p{padding:0 0 20px;color:var(--ink2)}
/* booking */
.book{background:var(--paper);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.widget{margin:40px auto 0;max-width:860px;border:1px dashed var(--lake);background:var(--lake2);min-height:300px;display:grid;place-items:center;text-align:center;padding:30px}
.widget .label{color:var(--lake);display:block;margin-bottom:10px}
.actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-top:24px}
/* contact */
.two{display:grid;grid-template-columns:1fr 1fr;gap:64px;margin-top:40px}
@media (max-width:860px){.two{grid-template-columns:1fr;gap:40px}}
form{display:grid;gap:16px}
label{display:grid;gap:6px;font-size:.85rem;color:var(--ink2)}
input,textarea{font:inherit;padding:13px 14px;border:1px solid var(--line);border-radius:var(--r);background:var(--paper);color:var(--ink);width:100%}
textarea{min-height:130px;resize:vertical}
.hint{font-size:.82rem;color:var(--ink2)}
dl{margin:0;display:grid;gap:20px}
dt{font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--lake);font-weight:500}
dd{margin:4px 0 0}
.badge{margin-top:28px;display:flex;gap:18px;align-items:center;flex-wrap:wrap}
.logo-slot{width:150px;height:84px;border:1px dashed var(--ink2);display:grid;place-items:center;text-align:center;font-size:.68rem;letter-spacing:.04em;color:var(--ink2);padding:8px;background:var(--paper)}
footer{padding:40px 0;border-top:1px solid var(--line);font-size:.85rem;color:var(--ink2)}
footer .wrap{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px}
@media (max-width:760px){footer .wrap{grid-template-columns:1fr}}
footer .label{margin-bottom:8px;display:block}
footer a{text-decoration:none;display:block;margin-bottom:4px}
.rv{opacity:1}
@media (prefers-reduced-motion:no-preference){
  .rv{opacity:0;transform:translateY(18px);transition:opacity .8s ease,transform .8s ease}
  .rv.in{opacity:1;transform:none}
}
</style>
</head>
<body>

<header class="nav">
  <div class="wrap">
    <a class="brand" href="#top">Strato Apartment</a>
    <nav class="links" aria-label="Meni">
      <a href="#apartma"><Fragment set:html={t('Apartma','Apartment')} /></a>
      <a href="#oprema"><Fragment set:html={t('Oprema','Amenities')} /></a>
      <a href="#galerija"><Fragment set:html={t('Galerija','Gallery')} /></a>
      <a href="#ocene"><Fragment set:html={t('Ocene','Reviews')} /></a>
      <a href="#okolica"><Fragment set:html={t('Okolica','Things to do')} /></a>
      <a href="#vprasanja"><Fragment set:html={t('Vprašanja','FAQ')} /></a>
      <a href="#kontakt"><Fragment set:html={t('Kontakt','Contact')} /></a>
    </nav>
    <div class="lang" role="group" aria-label="Jezik / Language">
      <button type="button" data-set-lang="sl" aria-pressed="true">SL</button>
      <span style="opacity:.5">|</span>
      <button type="button" data-set-lang="en" aria-pressed="false">EN</button>
    </div>
  </div>
</header>

<main id="top">
  <section class="hero">
    <Fragment set:html={img('02','',"eager")} />
    <div class="wrap">
      <p class="label"><Fragment set:html={t('Kočevje · ob jezeru · Slovenija','Kočevje · by the lake · Slovenia')} /></p>
      <h1><Fragment set:html={t(
        'Apartma, kjer je <em class="serif">jezero</em> na sprehod daleč',
        'An apartment with the <em class="serif">lake</em> a short walk away')} /></h1>
      <p class="sub"><Fragment set:html={t(
        `Strato Apartment, ${d.facts_sl.size}, ${d.facts_sl.guests}. ${d.facts_sl.lake}, ${d.facts_sl.center}.`,
        `Strato Apartment, ${d.facts_en.size}, ${d.facts_en.guests}. ${d.facts_en.lake}, ${d.facts_en.center}.`)} /></p>
      <div class="cta">
        <a class="btn" href="#bentral"><Fragment set:html={t('Preveri razpoložljivost','Check availability')} /></a>
        <a class="btn light" href="#apartma"><Fragment set:html={t('Razišči apartma','Explore the apartment')} /></a>
      </div>
    </div>
    <span class="scroll"><Fragment set:html={t('Pomakni se navzdol','Scroll')} /></span>
  </section>

  <div class="stats">
    <div class="wrap">
      <div class="stat"><b>74<small>m²</small></b><span><Fragment set:html={t('bivalne površine','of living space')} /></span></div>
      <div class="stat"><b>5</b><span><Fragment set:html={t('oseb največ','guests at most')} /></span></div>
      <div class="stat"><b>270<small>m</small></b><span><Fragment set:html={t('do Kočevskega jezera','to Lake Kočevje')} /></span></div>
      <div class="stat"><b>400<small>m</small></b><span><Fragment set:html={t('do središča Kočevja','to Kočevje town centre')} /></span></div>
    </div>
  </div>

  <section class="intro center">
    <div class="wrap rv">
      <p class="label"><Fragment set:html={t('Dobrodošli','Welcome')} /></p>
      <h2><Fragment set:html={t('Dve spalnici, dnevna soba z glasbili in terasa','Two bedrooms, a living room with instruments and a terrace')} /></h2>
      <p><Fragment set:html={t(
        `${d.facts_sl.bedrooms}. ${d.facts_sl.living}. Gostitelja Barbara in Rok vas sprejmeta osebno ali pa se prijavite sami s kodo.`,
        `${d.facts_en.bedrooms}. ${d.facts_en.living}. Your hosts Barbara and Rok welcome you in person, or you check in yourself with a code.`)} /></p>
    </div>
  </section>

  <section id="apartma" style="padding-top:0">
    <div class="wrap">
      {blocks.map(b => (
        <div class="block rv">
          <Fragment set:html={img(b.n)} />
          <div class="txt">
            <span class="label"><Fragment set:html={t(labels[b.key][0],labels[b.key][1])} /></span>
            <h3><Fragment set:html={t(labels[b.key][0],labels[b.key][1])} /></h3>
            <p><Fragment set:html={t((d.facts_sl as any)[b.key],(d.facts_en as any)[b.key])} /></p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="oprema" style="padding-top:0">
    <div class="wrap">
      <div class="center rv">
        <p class="label"><Fragment set:html={t('Oprema','Amenities')} /></p>
        <h2 style="margin-top:12px"><Fragment set:html={t('Kaj vas čaka v apartmaju','What you will find in the apartment')} /></h2>
      </div>
      <div class="check rv">
        {amenityKeys.map(k => (
          <div><span class="label"><Fragment set:html={t(labels[k][0],labels[k][1])} /></span><p><Fragment set:html={t((d.facts_sl as any)[k],(d.facts_en as any)[k])} /></p></div>
        ))}
      </div>
    </div>
  </section>

  <section id="galerija" class="strip-wrap" style="padding-top:0">
    <div class="strip-head rv">
      <div><p class="label"><Fragment set:html={t('Galerija','Gallery')} /></p><h2 style="margin-top:12px"><Fragment set:html={t('Fotografije','Photos')} /></h2></div>
      <p><Fragment set:html={t('Pomaknite se vstran →','Scroll sideways →')} /></p>
    </div>
    <div class="strip rv">
      {galleryIds.map(n => (
        <figure><Fragment set:html={img(n)} /><figcaption><Fragment set:html={t(photos[n][0],photos[n][1])} /></figcaption></figure>
      ))}
    </div>
  </section>

  <section id="ocene" class="rate center">
    <div class="wrap">
      <p class="label rv"><Fragment set:html={t('Ocene gostov','Guest ratings')} /></p>
      <h2 class="rv" style="margin-top:12px"><Fragment set:html={t('Javne ocene, prebrane 25. 11. 2026','Public scores as read on 25 Nov 2026')} /></h2>
      <div class="pair rv">
        <div><span class="label">Booking.com</span><b><Fragment set:html={t('9,9','9.9')} /><small> / 10</small></b><span><Fragment set:html={t('10 ocen','10 reviews')} /></span></div>
        <div><span class="label">Airbnb</span><b><Fragment set:html={t('5,0','5.0')} /></b><span><Fragment set:html={t('9 ocen','9 reviews')} /></span></div>
      </div>
      <div class="slot rv">
        <span class="label"><Fragment set:html={t(
          'Ocene gostov – izbor 5 ocen z Bookinga in Airbnb (vstavimo po potrditvi)',
          'Guest reviews – a selection of 5 reviews from Booking and Airbnb (inserted after confirmation)')} /></span>
        <ul>{[1,2,3,4,5].map(i => (<li><Fragment set:html={t(`Ocena ${i}`,`Review ${i}`)} /></li>))}</ul>
      </div>
    </div>
  </section>

  <section id="okolica">
    <div class="wrap">
      <div class="center rv">
        <p class="label"><Fragment set:html={t('Okolica','Nearby')} /></p>
        <h2 style="margin-top:12px"><Fragment set:html={t('Kaj početi na Kočevskem','Things to do around Kočevje')} /></h2>
      </div>
      <div class="places rv">
        {d.things_to_do_from_hosts_folio_guide.map((p, i) => (
          <div class="place"><b>0{i+1}</b><div><h3><Fragment set:html={t(p.sl,p.en)} /></h3><p><Fragment set:html={t(p.note_sl,p.note_en)} /></p></div></div>
        ))}
      </div>
      <p class="label rv" style="margin-top:34px"><Fragment set:html={t('Več iz vodiča gostiteljev','More from the hosts’ guide')} /></p>
      <div class="more rv">{d.more_from_guide.map(m => (<span>{m}</span>))}</div>
    </div>
  </section>

  <section id="vprasanja" style="padding-top:0">
    <div class="wrap">
      <div class="center rv">
        <p class="label"><Fragment set:html={t('Dobro je vedeti','Good to know')} /></p>
        <h2 style="margin-top:12px"><Fragment set:html={t('Pogosta vprašanja','Frequently asked questions')} /></h2>
      </div>
      <div class="faq rv">
        <details><summary><Fragment set:html={t('Kdaj je prijava in odjava?','When are check-in and check-out?')} /></summary><p><Fragment set:html={t(`${d.facts_sl.checkin}. ${d.facts_sl.checkout}.`,`${d.facts_en.checkin}. ${d.facts_en.checkout}.`)} /></p></details>
        <details><summary><Fragment set:html={t('Kakšen je hišni red?','What are the house rules?')} /></summary><p><Fragment set:html={t(d.facts_sl.rules,d.facts_en.rules)} /></p></details>
        <details><summary><Fragment set:html={t('Je parkiranje na voljo?','Is parking available?')} /></summary><p><Fragment set:html={t(d.facts_sl.parking,d.facts_en.parking)} /></p></details>
        <details><summary><Fragment set:html={t('Kako daleč je jezero in središče mesta?','How far are the lake and the town centre?')} /></summary><p><Fragment set:html={t(`${d.facts_sl.lake}; ${d.facts_sl.center}.`,`${d.facts_en.lake}; ${d.facts_en.center}.`)} /></p></details>
        <details><summary><Fragment set:html={t('Kaj je na voljo za otroke?','What is there for children?')} /></summary><p><Fragment set:html={t(`${d.facts_sl.extras}. ${d.facts_sl.bedroom2}.`,`${d.facts_en.extras}. ${d.facts_en.bedroom2}.`)} /></p></details>
      </div>
    </div>
  </section>

  <section id="bentral" class="book center">
    <div class="wrap">
      <p class="label rv"><Fragment set:html={t('Rezervacija','Reservation')} /></p>
      <h2 class="rv" style="margin-top:12px"><Fragment set:html={t('Preverite proste termine','Check free dates')} /></h2>
      <div class="widget rv">
        <div><span class="label">Bentral</span><p><Fragment set:html={t('Tu bo Bentral rezervacijski koledar (vstavimo kodo vtičnika).','The Bentral booking calendar will appear here (plugin code to be inserted).')} /></p></div>
      </div>
      <div class="actions rv">
        <a class="btn" href={d.phone_href}><Fragment set:html={t('Pokliči','Call')} /> {d.phone}</a>
        <a class="btn outline" href={`mailto:${d.email}`}><Fragment set:html={t('Piši na e-pošto','Send an e-mail')} /></a>
      </div>
    </div>
  </section>

  <section id="kontakt">
    <div class="wrap">
      <div class="center rv">
        <p class="label"><Fragment set:html={t('Kontakt','Contact')} /></p>
        <h2 style="margin-top:12px"><Fragment set:html={t('Pišite nam','Write to us')} /></h2>
      </div>
      <div class="two">
        <form class="rv" method="post" enctype="text/plain" action={`mailto:${d.email}?subject=${encodeURIComponent(mailSubjectSl)}`} data-subject-sl={mailSubjectSl} data-subject-en={mailSubjectEn}>
          <label><Fragment set:html={t('Ime in priimek','Full name')} /><input name="ime" required autocomplete="name"></label>
          <label><Fragment set:html={t('E-pošta','E-mail')} /><input name="eposta" type="email" required autocomplete="email"></label>
          <label><Fragment set:html={t('Termin (prihod – odhod)','Dates (arrival – departure)')} /><input name="termin" data-ph-sl="npr. 12. 7. – 16. 7." data-ph-en="e.g. 12 Jul – 16 Jul" placeholder="npr. 12. 7. – 16. 7."></label>
          <label><Fragment set:html={t('Sporočilo','Message')} /><textarea name="sporocilo"></textarea></label>
          <button class="btn" type="submit"><Fragment set:html={t('Odpri v e-pošti','Open in e-mail')} /></button>
          <p class="hint"><Fragment set:html={t(
            `Obrazec nima strežnika: gumb odpre vaš e-poštni program s pripravljenim sporočilom na ${d.email}, pošljete ga vi.`,
            `This form has no server: the button opens your e-mail app with a prepared message to ${d.email}; you send it yourself.`)} /></p>
        </form>
        <div class="rv">
          <dl>
            <div><dt><Fragment set:html={t('Naslov','Address')} /></dt><dd>{d.address}<br><a href={d.maps} target="_blank" rel="noopener"><Fragment set:html={t('Odpri zemljevid','Open map')} /> ↗</a></dd></div>
            <div><dt><Fragment set:html={t('Telefon','Phone')} /></dt><dd><a href={d.phone_href}>{d.phone}</a></dd></div>
            <div><dt><Fragment set:html={t('E-pošta','E-mail')} /></dt><dd><a href={`mailto:${d.email}`}>{d.email}</a></dd></div>
            <div><dt><Fragment set:html={t('Prijava / odjava','Check-in / check-out')} /></dt><dd><Fragment set:html={t(`${d.facts_sl.checkin}. ${d.facts_sl.checkout}.`,`${d.facts_en.checkin}. ${d.facts_en.checkout}.`)} /></dd></div>
            <div><dt><Fragment set:html={t('Hišni red','House rules')} /></dt><dd><Fragment set:html={t(d.facts_sl.rules,d.facts_en.rules)} /></dd></div>
            <div><dt><Fragment set:html={t('Gostitelja','Hosts')} /></dt><dd>{d.hosts}</dd></div>
          </dl>
          <div class="badge">
            <div class="logo-slot"><Fragment set:html={t('Logo Green &amp; Safe (pošljeta gostitelja)','Green &amp; Safe logo (to be sent by the hosts)')} /></div>
            <a href={d.kocevsko_link} target="_blank" rel="noopener"><Fragment set:html={t('Najdete nas tudi na Kočevsko.com','Find us also on Kočevsko.com')} /> ↗</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <div><span class="label">Strato Apartment</span>{d.address}<br>{d.hosts}</div>
    <div><span class="label"><Fragment set:html={t('Povezave','Links')} /></span>
      <a href="#bentral"><Fragment set:html={t('Rezervacija','Reservation')} /></a>
      <a href="#galerija"><Fragment set:html={t('Galerija','Gallery')} /></a>
      <a href={d.kocevsko_link} target="_blank" rel="noopener">Kočevsko.com</a>
    </div>
    <div><span class="label"><Fragment set:html={t('Kontakt','Contact')} /></span><a href={d.phone_href}>{d.phone}</a><a href={`mailto:${d.email}`}>{d.email}</a><span style="display:block;margin-top:14px"><Fragment set:html={t('Predogled: AK agencija','Preview: AK agencija')} /></span></div>
  </div>
</footer>

<script is:inline>
(function(){
  var root=document.documentElement;
  function apply(l){
    root.lang=l;
    try{localStorage.setItem('strato-lang',l)}catch(e){}
    document.querySelectorAll('[data-set-lang]').forEach(function(b){b.setAttribute('aria-pressed',String(b.getAttribute('data-set-lang')===l))});
    document.querySelectorAll('[data-alt-sl]').forEach(function(i){i.alt=i.getAttribute('data-alt-'+l)||i.alt});
    document.querySelectorAll('[data-ph-sl]').forEach(function(i){i.placeholder=i.getAttribute('data-ph-'+l)||''});
    document.querySelectorAll('form[data-subject-sl]').forEach(function(f){
      var m=f.action.split('?')[0];f.action=m+'?subject='+encodeURIComponent(f.getAttribute('data-subject-'+l));
    });
    document.title=l==='en'?'Strato Apartment – Kočevje, Slovenia':'Strato Apartment – Kočevje';
  }
  document.querySelectorAll('[data-set-lang]').forEach(function(b){b.addEventListener('click',function(){apply(b.getAttribute('data-set-lang'))})});
  apply(root.lang==='en'?'en':'sl');
  var nav=document.querySelector('.nav');
  function onScroll(){nav.classList.toggle('solid',window.scrollY>window.innerHeight*.8)}
  window.addEventListener('scroll',onScroll,{passive:true});onScroll();
  var els=document.querySelectorAll('.rv');
  if('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{rootMargin:'0px 0px -8% 0px'});
    els.forEach(function(e){io.observe(e)});
  }else{els.forEach(function(e){e.classList.add('in')})}
})();
</script>
</body>
</html>
