---
// Strato Apartment – predlog 6
// Feel: oldsquarehouse.com – bright, airy, friendly; emerald accent, rounded pills, uppercase labels, FAQ.
// Own code. Facts only from src/data/strato.json.
import d from '../../../../data/strato.json';
const f = d.facts_sl, e = d.facts_en;
const A = '../assets/';
const t = (sl, en) => `<span data-lang="sl">${sl}</span><span data-lang="en">${en}</span>`;

const cards = [
  { img: '02', sl: 'Dnevna soba', en: 'Living room', tsl: f.living, ten: e.living, msl: 'TV · klavir · kitara', men: 'TV · piano · guitar' },
  { img: '07', sl: 'Kuhinja', en: 'Kitchen', tsl: f.kitchen, ten: e.kitchen, msl: 'Popolnoma opremljena', men: 'Fully equipped' },
  { img: '12', sl: 'Spalnici', en: 'Bedrooms', tsl: f.bedroom1 + '. ' + f.bedroom2 + '.', ten: e.bedroom1 + '. ' + e.bedroom2 + '.', msl: 'Do 5 oseb', men: 'Up to 5 guests' },
];
const chips = [
  [f.bathroom, e.bathroom], [f.climate, e.climate], [f.outdoor, e.outdoor], [f.parking, e.parking], [f.extras, e.extras], [f.bedrooms, e.bedrooms],
];
const gallery = ['01','03','04','05','06','08','09','10','11','13','14','15'];
const captions = { '01':['Dnevna soba','Living room'],'03':['Klavir','Piano'],'04':['Kitara in klavir','Guitar and piano'],'05':['Dnevna soba','Living room'],'06':['Kuhinja','Kitchen'],'08':['Kuhinjski pult','Kitchen counter'],'09':['Jedilnica','Dining'],'10':['Velika spalnica','Large bedroom'],'11':['Velika spalnica','Large bedroom'],'13':['Velika spalnica','Large bedroom'],'14':['Manjša spalnica','Second bedroom'],'15':['Manjša spalnica','Second bedroom'] };
const todo = d.things_to_do_from_hosts_folio_guide;
const faq = [
  ['Kdaj je prijava in odjava?', 'When are check-in and check-out?', f.checkin + '. ' + f.checkout + '.', e.checkin + '. ' + e.checkout + '.'],
  ['So hišni ljubljenčki dovoljeni?', 'Are pets allowed?', 'Ne. ' + f.rules + '.', 'No. ' + e.rules + '.'],
  ['Je parkiranje na voljo?', 'Is parking available?', f.parking + '.', e.parking + '.'],
  ['Kaj je v kuhinji?', 'What is in the kitchen?', f.kitchen + '.', e.kitchen + '.'],
  ['Kaj je vključeno?', 'What is included?', f.extras + '.', e.extras + '.'],
  ['Kako daleč je jezero in mesto?', 'How far are the lake and the town?', f.lake + '; ' + f.center + '.', e.lake + '; ' + e.center + '.'],
];
---
<!doctype html>
<html lang="sl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Strato Apartment · Kočevje</title>
<meta name="description" content="Strato Apartment, Kočevje – apartma za do 5 oseb, 270 m od Kočevskega jezera. Predlog spletne strani (AK agencija)." />
<meta name="robots" content="noindex" />
<script is:inline>
  (function(){var h=document.documentElement;h.classList.add('js');try{var l=localStorage.getItem('strato-lang');if(l==='en'||l==='sl')h.lang=l;}catch(e){}})();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet" />
<style is:global>
  :root{
    --white:#fff; --mist:#eef4f0; --mist2:#e1ebe5; --ink:#17221d; --text:#2b3a33; --mute:#5f7067;
    --em:#0e6b50; --em2:#0b5540; --deep:#0b3d2e; --sun:#f0c04f; --line:#d9e4de;
    --head:'Fraunces',Georgia,serif; --body:'DM Sans',system-ui,sans-serif;
    --max:1200px; --gut:clamp(16px,4vw,48px); --r:22px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  body{background:var(--white);color:var(--text);font-family:var(--body);font-size:17px;line-height:1.6;overflow-x:hidden}
  img{display:block;max-width:100%;height:auto}
  a{color:inherit;text-decoration:none}
  html[lang=sl] [data-lang=en]{display:none!important}
  html[lang=en] [data-lang=sl]{display:none!important}
  .wrap{max-width:var(--max);margin:0 auto;padding:0 var(--gut)}
  h1,h2,h3{font-family:var(--head);font-weight:500;color:var(--ink);line-height:1.08;letter-spacing:-.01em}
  h2{font-size:clamp(32px,4.2vw,52px)}
  h3{font-size:clamp(22px,2vw,26px)}
  .label{display:inline-block;font-size:12px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--em);margin-bottom:14px}
  .lead{font-size:clamp(17px,1.4vw,20px);color:var(--mute);max-width:60ch}
  .pill{display:inline-flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:10px;padding:15px 26px;border-radius:999px;background:var(--em);color:#fff;font-weight:600;font-size:15px;border:0;cursor:pointer;transition:background .25s,transform .25s;box-shadow:0 8px 24px -12px rgba(14,107,80,.6)}
  .pill:hover{background:var(--em2);transform:translateY(-1px)}
  .pill.ghost{background:#fff;color:var(--ink);box-shadow:none;border:1.5px solid var(--line)}
  .pill.ghost:hover{background:var(--mist)}
  section{padding:clamp(72px,9vw,120px) 0}
  section.tint{background:var(--mist)}

  /* nav */
  .nav{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  .nav .wrap{display:flex;align-items:center;justify-content:space-between;height:72px;gap:16px}
  .logo{display:flex;align-items:center;gap:10px;font-family:var(--head);font-weight:600;font-size:22px;color:var(--ink)}
  .logo i{width:34px;height:34px;border-radius:50%;background:var(--em);display:grid;place-items:center}
  .logo i::after{content:'';width:14px;height:14px;border-radius:50% 50% 50% 0;background:var(--sun);transform:rotate(-45deg)}
  .menu{display:flex;gap:28px;font-weight:500;font-size:15px}
  .menu a{color:var(--text);padding:6px 0;border-bottom:2px solid transparent;transition:border-color .25s,color .25s}
  .menu a:hover{color:var(--em);border-color:var(--em)}
  .lang{display:flex;background:var(--mist);border-radius:999px;padding:3px}
  .lang button{border:0;background:none;font:600 12px/1 var(--body);letter-spacing:.1em;padding:8px 11px;border-radius:999px;color:var(--mute);cursor:pointer}
  .lang button[aria-pressed=true]{background:var(--ink);color:#fff}
  .right{display:flex;align-items:center;gap:12px}
  @media (max-width:960px){.menu{display:none}.nav .wrap{height:64px}.right .pill{padding:11px 16px;font-size:14px}}

  /* hero */
  .hero{padding:0;position:relative}
  .hero .frame{position:relative;height:min(86svh,820px);min-height:560px;overflow:hidden}
  .hero .frame img{width:100%;height:100%;object-fit:cover;object-position:center}
  .hero .frame::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(11,61,46,0) 40%,rgba(11,61,46,.55) 100%)}
  .hero .card{position:absolute;left:var(--gut);right:var(--gut);bottom:clamp(24px,5vw,64px);max-width:640px;background:#fff;border-radius:var(--r);padding:clamp(24px,3.5vw,44px);box-shadow:0 30px 60px -30px rgba(11,61,46,.5)}
  .hero h1{font-size:clamp(40px,5.6vw,72px);font-weight:600}
  .hero h1 span{color:var(--em)}
  .hero p{margin:14px 0 24px;color:var(--mute);font-size:clamp(16px,1.3vw,19px)}
  .hero .acts{display:flex;flex-wrap:wrap;gap:12px}
  @media (min-width:1300px){.hero .card{left:calc((100% - var(--max))/2 + var(--gut))}}
  .prox{display:flex;flex-wrap:wrap;gap:12px;padding:24px 0}
  .prox span{display:inline-flex;align-items:center;gap:10px;background:var(--mist);border-radius:999px;padding:10px 18px;font-weight:500;font-size:15px}
  .prox b{color:var(--em);font-family:var(--head);font-weight:600;font-size:18px}

  /* about */
  .about .grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(32px,6vw,80px);align-items:center}
  .about img{border-radius:var(--r);aspect-ratio:4/3;object-fit:cover}
  .about p+p{margin-top:16px}
  .host{display:flex;align-items:center;gap:14px;margin-top:28px;padding:16px 18px;background:var(--mist);border-radius:16px;font-weight:500}
  .host i{width:40px;height:40px;border-radius:50%;background:var(--sun);display:grid;place-items:center;font:600 15px/1 var(--head);color:var(--deep)}
  @media (max-width:860px){.about .grid{grid-template-columns:minmax(0,1fr)}}

  /* cards */
  .cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;margin-top:40px}
  .card3{background:#fff;border:1px solid var(--line);border-radius:var(--r);overflow:hidden;transition:transform .35s,box-shadow .35s}
  .card3:hover{transform:translateY(-4px);box-shadow:0 30px 50px -34px rgba(11,61,46,.45)}
  .card3 img{aspect-ratio:4/3;object-fit:cover;width:100%}
  .card3 .b{padding:22px 24px 26px}
  .card3 .m{font-size:12px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--em);margin-bottom:8px;display:block}
  .card3 p{color:var(--mute);font-size:15px;margin-top:10px}
  @media (max-width:900px){.cards{grid-template-columns:minmax(0,1fr)}}
  .chips{display:flex;flex-wrap:wrap;gap:12px;margin-top:36px}
  .chips span{display:inline-flex;gap:10px;align-items:flex-start;background:#fff;border:1px solid var(--line);border-radius:16px;padding:12px 16px;font-size:15px;max-width:100%}
  .chips span::before{content:'';flex:0 0 18px;height:18px;margin-top:3px;border-radius:50%;background:var(--em) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='3'><path d='M5 13l4 4L19 7'/></svg>") center/11px no-repeat}

  /* gallery */
  .masonry{columns:3;column-gap:16px;margin-top:40px}
  .masonry figure{break-inside:avoid;margin:0 0 16px;position:relative;border-radius:18px;overflow:hidden}
  .masonry img{width:100%;transition:transform .8s}
  .masonry figure:hover img{transform:scale(1.03)}
  .masonry figcaption{position:absolute;left:12px;bottom:12px;background:rgba(255,255,255,.92);border-radius:999px;padding:6px 12px;font-size:12px;font-weight:600;color:var(--ink)}
  @media (max-width:900px){.masonry{columns:2}}
  @media (max-width:560px){.masonry{columns:1}}

  /* ratings */
  .scores{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:22px;margin-top:40px}
  .score{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:30px;display:flex;align-items:center;gap:24px}
  .score .ring{flex:0 0 112px;width:112px;height:112px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--em) var(--pct),var(--mist2) 0);position:relative}
  .score .ring::after{content:'';position:absolute;inset:8px;border-radius:50%;background:#fff}
  .score .ring b{position:relative;font:600 34px/1 var(--head);color:var(--ink)}
  .score small{display:block;font-size:12px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--em)}
  .score span{color:var(--mute)}
  .slots{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;margin-top:16px}
  .slot{border:2px dashed var(--mist2);border-radius:18px;padding:22px 18px;min-height:150px;color:var(--mute);font-size:14px;background:#fff}
  .slot b{display:block;color:var(--em);font-size:12px;letter-spacing:.18em;text-transform:uppercase;margin-bottom:8px}
  @media (max-width:980px){.slots{grid-template-columns:repeat(2,minmax(0,1fr))}.slots .slot:last-child{grid-column:1/-1}}
  @media (max-width:640px){.scores{grid-template-columns:minmax(0,1fr)}}

  /* todo */
  .todo{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px;margin-top:40px}
  .todo a{background:var(--mist);border-radius:var(--r);padding:26px 22px;min-height:200px;display:flex;flex-direction:column;transition:background .3s,transform .3s}
  .todo a:hover{background:var(--mist2);transform:translateY(-3px)}
  .todo .n{width:40px;height:40px;border-radius:50%;background:#fff;display:grid;place-items:center;font:600 16px/1 var(--head);color:var(--em);margin-bottom:auto}
  .todo h3{font-size:21px;margin-top:22px}
  .todo p{color:var(--mute);font-size:14px;margin-top:6px}
  @media (max-width:1000px){.todo{grid-template-columns:repeat(2,minmax(0,1fr))}.todo a:last-child{grid-column:1/-1}}
  @media (max-width:560px){.todo{grid-template-columns:minmax(0,1fr)}.todo a{min-height:0}.todo .n{margin-bottom:0}}
  .more{margin-top:28px;display:flex;flex-wrap:wrap;gap:10px;align-items:center}
  .more .l{font-size:12px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--em);margin-right:6px}
  .more i{font-style:normal;border:1px solid var(--line);border-radius:999px;padding:8px 14px;font-size:14px}

  /* location + faq */
  .loc{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(32px,6vw,80px);align-items:start}
  .addr{background:var(--deep);color:#e9f3ee;border-radius:var(--r);padding:clamp(26px,3.5vw,40px)}
  .addr h3{color:#fff;margin-bottom:14px}
  .addr .row{display:flex;gap:14px;padding:12px 0;border-top:1px solid rgba(255,255,255,.14);font-size:15px;flex-wrap:wrap}
  .addr .row small{flex:0 0 100px;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--sun);padding-top:4px}
  .addr .pill{margin-top:18px;background:var(--sun);color:var(--deep);box-shadow:none}
  .addr .pill:hover{background:#f6cd69}
  details{border-bottom:1px solid var(--line)}
  summary{list-style:none;cursor:pointer;padding:18px 0;display:flex;justify-content:space-between;gap:16px;align-items:center;font-weight:600;color:var(--ink);font-size:17px}
  summary::-webkit-details-marker{display:none}
  summary::after{content:'+';flex:0 0 32px;height:32px;border-radius:50%;background:var(--mist);display:grid;place-items:center;font-weight:500;color:var(--em);transition:transform .3s}
  details[open] summary::after{transform:rotate(45deg)}
  details p{padding:0 0 18px;color:var(--mute)}
  @media (max-width:860px){.loc{grid-template-columns:minmax(0,1fr)}}

  /* reservation */
  .res .box{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.7fr);gap:22px;margin-top:40px}
  .widget{border:2px dashed var(--em);border-radius:var(--r);background:#fff;min-height:380px;display:grid;place-items:center;text-align:center;padding:30px;color:var(--mute)}
  .widget b{display:block;color:var(--em);font-size:12px;letter-spacing:.2em;text-transform:uppercase;margin-bottom:10px}
  .side{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:28px;display:flex;flex-direction:column;gap:12px}
  .side h3{margin-bottom:6px}
  .side p{color:var(--mute);margin-bottom:8px}
  .side .pill{width:100%}
  @media (max-width:860px){.res .box{grid-template-columns:minmax(0,1fr)}}

  /* contact */
  .contact .grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(32px,6vw,80px);margin-top:40px}
  .form{display:grid;gap:14px}
  .form label{display:grid;gap:6px;font-size:13px;font-weight:600;color:var(--ink)}
  .form input,.form textarea{width:100%;border:1.5px solid var(--line);border-radius:14px;padding:13px 16px;font:400 16px/1.4 var(--body);color:var(--ink);background:#fff;outline:none;transition:border-color .2s}
  .form input:focus,.form textarea:focus{border-color:var(--em)}
  .form textarea{min-height:130px;resize:vertical}
  .two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px}
  .hint{font-size:13px;color:var(--mute)}
  .badges{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px;margin-top:22px}
  .badges .slot{min-height:120px;display:flex;flex-direction:column;justify-content:center}
  .badges .koc{border:1px solid var(--line);border-radius:18px;padding:20px;display:flex;flex-direction:column;justify-content:center;gap:6px}
  .badges .koc a{color:var(--em);font-weight:600;text-decoration:underline;text-underline-offset:3px}
  @media (max-width:860px){.contact .grid{grid-template-columns:minmax(0,1fr)}}
  @media (max-width:520px){.two,.badges{grid-template-columns:minmax(0,1fr)}}

  footer{background:var(--deep);color:#cfe0d7;padding:36px 0;font-size:14px}
  footer .wrap{display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;align-items:center}
  footer .pv{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--sun)}

  html.js .rv{opacity:0;transform:translateY(20px);transition:opacity .7s ease,transform .7s ease}
  html.js .rv.in{opacity:1;transform:none}
  html.js .rv.d1{transition-delay:.1s}html.js .rv.d2{transition-delay:.2s}
  @media (prefers-reduced-motion:reduce){html.js .rv{opacity:1;transform:none;transition:none}.card3,.todo a,.masonry img,.pill{transition:none}}
</style>
</head>
<body>

<header class="nav">
  <div class="wrap">
    <a class="logo" href="#top"><i aria-hidden="true"></i>Strato</a>
    <nav class="menu" aria-label="Meni">
      <a href="#apartma"><Fragment set:html={t('Apartma','Apartment')} /></a>
      <a href="#galerija"><Fragment set:html={t('Galerija','Gallery')} /></a>
      <a href="#ocene"><Fragment set:html={t('Ocene','Reviews')} /></a>
      <a href="#aktivnosti"><Fragment set:html={t('Aktivnosti','Activities')} /></a>
      <a href="#lokacija"><Fragment set:html={t('Lokacija','Location')} /></a>
      <a href="#kontakt"><Fragment set:html={t('Kontakt','Contact')} /></a>
    </nav>
    <div class="right">
      <div class="lang" role="group" aria-label="Jezik / Language">
        <button type="button" data-set="sl" aria-pressed="true">SL</button>
        <button type="button" data-set="en" aria-pressed="false">EN</button>
      </div>
      <a class="pill" href="#bentral"><Fragment set:html={t('Rezerviraj zdaj','Book now')} /></a>
    </div>
  </div>
</header>

<main id="top">

<section class="hero">
  <div class="frame">
    <img src={A+'strato-09.jpg'} alt="Kuhinja z jedilnico, Strato Apartment" fetchpriority="high" />
    <div class="card rv">
      <span class="label">Kočevje · Kočevsko</span>
      <h1>Strato <span>Apartment</span></h1>
      <p><Fragment set:html={t(`Svetel apartma za ${f.guests}. ${f.lake}.`,`A bright apartment for ${e.guests}. ${e.lake}.`)} /></p>
      <div class="acts">
        <a class="pill" href="#bentral"><Fragment set:html={t('Preveri razpoložljivost','Check availability')} /></a>
        <a class="pill ghost" href="#galerija"><Fragment set:html={t('Poglej fotografije','See the photos')} /></a>
      </div>
    </div>
  </div>
  <div class="wrap prox rv">
    <span><b>270 m</b><Fragment set:html={t('Kočevsko jezero','Lake Kočevje')} /></span>
    <span><b>400 m</b><Fragment set:html={t('Središče mesta','Town centre')} /></span>
    <span><b>74 m²</b><Fragment set:html={t('2 spalnici','2 bedrooms')} /></span>
    <span><b>P</b><Fragment set:html={t('Zasebno parkirišče','Private parking')} /></span>
  </div>
</section>

<section id="apartma" class="about" style="padding-top:clamp(32px,5vw,64px)">
  <div class="wrap grid">
    <div class="rv">
      <span class="label"><Fragment set:html={t('O apartmaju','About the apartment')} /></span>
      <h2><Fragment set:html={t('Dom za družino ali družbo, korak od jezera.','A home for a family or friends, a step from the lake.')} /></h2>
      <p class="lead" style="margin-top:20px"><Fragment set:html={t(`${f.size}, ${f.guests}. ${f.bedrooms}.`,`${e.size}, ${e.guests}. ${e.bedrooms}.`)} /></p>
      <p style="margin-top:16px;color:var(--mute)"><Fragment set:html={t(f.living+'.',e.living+'.')} /></p>
      <p style="margin-top:16px;color:var(--mute)"><Fragment set:html={t(f.lake+', '+f.center+'.',e.lake+', '+e.center+'.')} /></p>
      <div class="host"><i>B&amp;R</i><span><Fragment set:html={t('Gostitelja Barbara in Rok','Hosts Barbara and Rok')} /></span></div>
    </div>
    <img class="rv d1" src={A+'strato-05.jpg'} alt="Dnevna soba s TV, kitaro in klavirjem" loading="lazy" />
  </div>
</section>

<section class="tint" style="padding-top:clamp(56px,7vw,96px)">
  <div class="wrap">
    <span class="label rv"><Fragment set:html={t('Prostori','The spaces')} /></span>
    <h2 class="rv d1"><Fragment set:html={t('Kaj vas čaka notri','What awaits inside')} /></h2>
    <div class="cards">
      {cards.map((c) => (
        <article class="card3 rv">
          <img src={A+'strato-'+c.img+'.jpg'} alt={c.sl} loading="lazy" />
          <div class="b"><span class="m"><Fragment set:html={t(c.msl,c.men)} /></span><h3><Fragment set:html={t(c.sl,c.en)} /></h3><p><Fragment set:html={t(c.tsl,c.ten)} /></p></div>
        </article>
      ))}
    </div>
    <div class="chips rv">
      {chips.map(([sl,en]) => (<span><Fragment set:html={t(sl,en)} /></span>))}
    </div>
  </div>
</section>

<section id="galerija">
  <div class="wrap">
    <span class="label rv"><Fragment set:html={t('Galerija','Gallery')} /></span>
    <h2 class="rv d1"><Fragment set:html={t('Fotografije apartmaja','Photos of the apartment')} /></h2>
    <div class="masonry rv">
      {gallery.map((n) => (<figure><img src={A+'strato-'+n+'.jpg'} alt={captions[n][0]} loading="lazy" /><figcaption><Fragment set:html={t(captions[n][0],captions[n][1])} /></figcaption></figure>))}
    </div>
  </div>
</section>

<section id="ocene" class="tint">
  <div class="wrap">
    <span class="label rv"><Fragment set:html={t('Ocene gostov','Guest ratings')} /></span>
    <h2 class="rv d1"><Fragment set:html={t('Ocene na Bookingu in Airbnb','Ratings on Booking and Airbnb')} /></h2>
    <div class="scores rv">
      <div class="score"><div class="ring" style="--pct:99%"><b>9,9</b></div><div><small>Booking.com</small><span><Fragment set:html={t('od 10 · 10 ocen','out of 10 · 10 reviews')} /></span></div></div>
      <div class="score"><div class="ring" style="--pct:100%"><b>5,0</b></div><div><small>Airbnb</small><span><Fragment set:html={t('od 5 · 9 ocen','out of 5 · 9 reviews')} /></span></div></div>
    </div>
    <p class="label rv" style="margin-top:34px"><Fragment set:html={t('Ocene gostov – izbor 5 ocen z Bookinga in Airbnb (vstavimo po potrditvi)','Guest reviews – a selection of 5 reviews from Booking and Airbnb (inserted after confirmation)')} /></p>
    <div class="slots rv">
      {[1,2,3,4,5].map((n) => (<div class="slot"><b><Fragment set:html={t('Ocena '+n,'Review '+n)} /></b><Fragment set:html={t('Besedilo gosta · ime · platforma','Guest text · name · platform')} /></div>))}
    </div>
  </div>
</section>

<section id="aktivnosti">
  <div class="wrap">
    <span class="label rv"><Fragment set:html={t('Aktivnosti','Activities')} /></span>
    <h2 class="rv d1"><Fragment set:html={t('Kaj početi v okolici','Things to do nearby')} /></h2>
    <div class="todo rv">
      {todo.map((p, i) => (<a href={d.maps} target="_blank" rel="noopener"><span class="n">{i+1}</span><h3><Fragment set:html={t(p.sl,p.en)} /></h3><p><Fragment set:html={t(p.note_sl,p.note_en)} /></p></a>))}
    </div>
    <div class="more rv"><span class="l"><Fragment set:html={t('Več iz vodnika','More from the guide')} /></span>{d.more_from_guide.map((m) => (<i>{m}</i>))}</div>
  </div>
</section>

<section id="lokacija" class="tint">
  <div class="wrap">
    <span class="label rv"><Fragment set:html={t('Lokacija in pogosta vprašanja','Location and FAQ')} /></span>
    <h2 class="rv d1"><Fragment set:html={t('Kje smo in kako poteka bivanje','Where we are and how a stay works')} /></h2>
    <div class="loc" style="margin-top:40px">
      <div class="addr rv">
        <h3><Fragment set:html={t('Naslov','Address')} /></h3>
        <p>{d.address}</p>
        <div class="row" style="margin-top:16px"><small><Fragment set:html={t('Prijava','Check-in')} /></small><span><Fragment set:html={t(f.checkin,e.checkin)} /></span></div>
        <div class="row"><small><Fragment set:html={t('Odjava','Check-out')} /></small><span><Fragment set:html={t(f.checkout,e.checkout)} /></span></div>
        <div class="row"><small><Fragment set:html={t('Hišni red','House rules')} /></small><span><Fragment set:html={t(f.rules,e.rules)} /></span></div>
        <div class="row"><small><Fragment set:html={t('Telefon','Phone')} /></small><a href={d.phone_href}>{d.phone}</a></div>
        <a class="pill" href={d.maps} target="_blank" rel="noopener"><Fragment set:html={t('Odpri zemljevid','Open the map')} /></a>
      </div>
      <div class="rv d1">
        {faq.map(([qs,qe,as_,ae]) => (<details><summary><Fragment set:html={t(qs,qe)} /></summary><p><Fragment set:html={t(as_,ae)} /></p></details>))}
      </div>
    </div>
  </div>
</section>

<section id="bentral" class="res">
  <div class="wrap">
    <span class="label rv"><Fragment set:html={t('Rezervacija','Reservation')} /></span>
    <h2 class="rv d1"><Fragment set:html={t('Preverite proste termine','Check available dates')} /></h2>
    <div class="box rv">
      <div class="widget"><div><b>Bentral</b><Fragment set:html={t('Tu bo Bentral rezervacijski koledar (vstavimo kodo vtičnika).','The Bentral booking calendar will be here (plugin code to be inserted).')} /></div></div>
      <div class="side">
        <h3><Fragment set:html={t('Ali pokličite','Or get in touch')} /></h3>
        <p><Fragment set:html={t('Barbara in Rok odgovorita osebno.','Barbara and Rok reply in person.')} /></p>
        <a class="pill" href={d.phone_href}><Fragment set:html={t('Pokliči','Call')} /> {d.phone}</a>
        <a class="pill ghost" href={'mailto:'+d.email}><Fragment set:html={t('Pošlji e-pošto','Send an e-mail')} /></a>
      </div>
    </div>
  </div>
</section>

<section id="kontakt" class="contact tint">
  <div class="wrap">
    <span class="label rv"><Fragment set:html={t('Kontakt','Contact')} /></span>
    <h2 class="rv d1"><Fragment set:html={t('Pišite nama','Write to us')} /></h2>
    <div class="grid">
      <form class="form rv" id="cf" action={'mailto:'+d.email} method="post" enctype="text/plain">
        <label><Fragment set:html={t('Ime in priimek','Full name')} /><input name="ime" required autocomplete="name" /></label>
        <label><Fragment set:html={t('E-pošta','E-mail')} /><input name="email" type="email" required autocomplete="email" /></label>
        <div class="two">
          <label><Fragment set:html={t('Prihod','Check-in')} /><input name="od" type="date" /></label>
          <label><Fragment set:html={t('Odhod','Check-out')} /><input name="do" type="date" /></label>
        </div>
        <label><Fragment set:html={t('Sporočilo','Message')} /><textarea name="sporocilo" required></textarea></label>
        <div><button class="pill" type="submit"><Fragment set:html={t('Pripravi e-sporočilo','Prepare e-mail')} /></button></div>
        <p class="hint"><Fragment set:html={t('Obrazec odpre vaš e-poštni program s pripravljenim sporočilom za strato.apartment@gmail.com – pošljete ga vi. Nič se ne shranjuje na strani.','This form opens your e-mail app with a message prepared for strato.apartment@gmail.com – you send it yourself. Nothing is stored on the site.')} /></p>
      </form>
      <div class="rv d1">
        <h3><Fragment set:html={t('Podatki','Details')} /></h3>
        <p style="margin-top:10px">{d.hosts}<br />{d.address}<br /><a href={d.phone_href} style="color:var(--em);font-weight:600">{d.phone}</a><br /><a href={'mailto:'+d.email} style="color:var(--em);font-weight:600">{d.email}</a><br /><a href={d.maps} target="_blank" rel="noopener" style="text-decoration:underline;text-underline-offset:3px"><Fragment set:html={t('Google zemljevid','Google Maps')} /></a></p>
        <p style="margin-top:16px;color:var(--mute)"><Fragment set:html={t(f.checkin+'. '+f.checkout+'. '+f.rules+'.',e.checkin+'. '+e.checkout+'. '+e.rules+'.')} /></p>
        <div class="badges">
          <div class="slot"><b>Green & Safe</b><Fragment set:html={t('Logo Green & Safe (pošljeta gostitelja)','Green & Safe logo (to be supplied by the hosts)')} /></div>
          <div class="koc"><b style="font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--em)">Kočevsko</b><a href={d.kocevsko_link} target="_blank" rel="noopener"><Fragment set:html={t('Najdete nas tudi na Kočevsko.com','Find us on Kočevsko.com too')} /></a></div>
        </div>
      </div>
    </div>
  </div>
</section>

</main>

<footer>
  <div class="wrap">
    <span>© Strato Apartment · {d.address}</span>
    <span class="pv">Predogled: AK agencija</span>
  </div>
</footer>

<script is:inline>
(function(){
  var h=document.documentElement;
  var titles={sl:'Strato Apartment · Kočevje',en:'Strato Apartment · Kočevje, Slovenia'};
  function setLang(l){h.lang=l;document.title=titles[l];try{localStorage.setItem('strato-lang',l)}catch(e){}
    document.querySelectorAll('.lang button').forEach(function(b){b.setAttribute('aria-pressed',String(b.dataset.set===l))});}
  document.querySelectorAll('.lang button').forEach(function(b){b.addEventListener('click',function(){setLang(b.dataset.set)})});
  setLang(h.lang==='en'?'en':'sl');
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}})},{threshold:.1,rootMargin:'0px 0px -6% 0px'});
    document.querySelectorAll('.rv').forEach(function(el){io.observe(el)});
  } else { document.querySelectorAll('.rv').forEach(function(el){el.classList.add('in')}); }
  var cf=document.getElementById('cf');
  cf.addEventListener('submit',function(ev){ev.preventDefault();
    var en=h.lang==='en';
    var body=(en?'Name: ':'Ime: ')+cf.ime.value+'\n'+(en?'E-mail: ':'E-pošta: ')+cf.email.value+'\n'+(en?'Dates: ':'Termin: ')+(cf.od.value||'–')+' – '+(cf.do.value||'–')+'\n\n'+cf.sporocilo.value;
    location.href='mailto:'+'strato.apartment@gmail.com'+'?subject='+encodeURIComponent(en?'Enquiry – Strato Apartment':'Povpraševanje – Strato Apartment')+'&body='+encodeURIComponent(body);
  });
})();
</script>
</body>
</html>
