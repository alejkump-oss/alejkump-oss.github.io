---
// Strato Apartment – preview v4. Structure and look mirror carolinaluxurystay.com: deep-green header
// with gold flared-serif logo, two-row centred nav, SL/EN, gold uppercase button; full-screen muted
// hero with centred headline + gold REZERVACIJA; three-column image/text/image sections; half-photo
// text sections; two-column heading/text; three feature cards; accordion FAQ; gallery; green footer
// with columns and a bottom bar. Code, copy and photos are our own; facts from strato.json.
import d from '../../../../data/strato.json';
const t = (sl: string, en: string) => `<span data-lang="sl">${sl}</span><span data-lang="en">${en}</span>`;
const photos: Record<string, [string, string]> = {
  '01': ['Dnevna soba s kavčem in pisalno mizo', 'Living room with sofa and desk'],
  '02': ['Dnevna soba s TV in kitaro', 'Living room with TV and guitar'],
  '03': ['Klavir in delovni kotiček', 'Piano and desk corner'],
  '04': ['Kitara in klavir', 'Guitar and piano'],
  '05': ['Dnevna soba s klavirjem', 'Living room with piano'],
  '06': ['Kuhinja', 'Kitchen'], '07': ['Kuhinja z jedilnico', 'Kitchen with dining area'],
  '08': ['Kuhinjski pult', 'Kitchen counter'], '09': ['Jedilnica', 'Dining area'],
  '10': ['Velika spalnica', 'Main bedroom'], '11': ['Velika spalnica z omaro', 'Main bedroom with wardrobe'],
  '12': ['Velika spalnica', 'Main bedroom'], '13': ['Velika spalnica', 'Main bedroom'],
  '14': ['Manjša spalnica s sedalnimi vrečami', 'Second bedroom with bean bags'], '15': ['Manjša spalnica', 'Second bedroom'],
};
const img = (n: string, cls = '', loading: 'lazy' | 'eager' = 'lazy') =>
  `<img src="../assets/strato-${n}.jpg" width="950" height="632" loading="${loading}" decoding="async" class="${cls}" alt="${photos[n][0]}" data-alt-sl="${photos[n][0]}" data-alt-en="${photos[n][1]}">`;
const S = d.facts_sl as any, E = d.facts_en as any;
const mailSl = 'Povpraševanje – Strato Apartment', mailEn = 'Enquiry – Strato Apartment';
const dsl = (x: string) => x.split(' / ')[0], den = (x: string) => x.split(' / ')[1] || x;
const all = Object.keys(photos);
---
<!doctype html>
<html lang="sl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Strato Apartment – Kočevje</title>
<meta name="description" content="Strato Apartment, Kočevje: apartma 74 m² za do 5 oseb, 270 m od Kočevskega jezera. Predogled.">
<meta name="robots" content="noindex">
<script is:inline>try{var l=localStorage.getItem('strato-lang');if(l==='en'||l==='sl')document.documentElement.lang=l}catch(e){}</script>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">
<style is:global>
:root{--green:#023f2f;--gold:#d7a850;--cream:#f7f5e9;--ink:#242424;--grey:#5e5e5e;--max:1200px}
*{box-sizing:border-box}
html{scroll-behavior:smooth}@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:#fff;color:var(--ink);font-family:'Montserrat',sans-serif;font-size:16px;line-height:1.75}
html[lang=sl] [data-lang=en],html[lang=en] [data-lang=sl]{display:none!important}
img{display:block;max-width:100%;height:auto}
a{color:inherit}
p{margin:0}
h1,h2,h3,h4{margin:0;font-family:'Marcellus',serif;font-weight:400;line-height:1.15;color:var(--green)}
h1{font-size:clamp(2.4rem,5vw,4.2rem);color:#fff}
h2{font-size:clamp(2rem,3.4vw,3rem)}
h3{font-size:1.5rem}
.wrap{max-width:var(--max);margin:0 auto;padding:0 24px}
.btn{display:inline-block;background:var(--gold);color:#fff;font-size:.8rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;padding:14px 36px;text-decoration:none;border:0;cursor:pointer;font-family:inherit;transition:background .2s}
.btn:hover{background:#c4953f}
.btn.out{background:transparent;border:1px solid var(--green);color:var(--green)}
section{padding:90px 0}
@media (max-width:760px){section{padding:60px 0}}
/* header */
header{background:var(--green);color:#fff;position:sticky;top:0;z-index:50}
header .wrap{display:grid;grid-template-columns:auto 1fr auto auto;align-items:center;gap:30px;min-height:140px;padding:16px 60px}
.logo{text-decoration:none;text-align:center;color:var(--gold);font-family:'Marcellus',serif;font-size:1.9rem;line-height:1;letter-spacing:.04em}
.logo small{display:block;font-family:'Montserrat',sans-serif;font-size:.6rem;letter-spacing:.24em;color:#cdbf98;margin-top:6px}
nav.main{display:grid;grid-template-rows:auto auto;gap:14px;justify-items:center;font-size:1.25rem}
nav.main div{display:flex;gap:40px}
nav.main a{text-decoration:none;color:#fff}
.lang{display:grid;gap:14px;justify-items:center;font-size:1.2rem}
.lang button{border:0;background:none;color:#fff;font:inherit;cursor:pointer;padding:0;display:flex;align-items:center;gap:8px}
.lang button i{width:18px;height:12px;border:1px solid rgba(255,255,255,.6);display:inline-block}
.lang button[aria-pressed=true]{color:var(--gold)}
nav.main .lang{display:none}
.burger{display:none;border:0;background:none;cursor:pointer;width:34px;height:26px;position:relative;justify-self:end}
.burger span,.burger span::before,.burger span::after{content:"";position:absolute;left:0;width:30px;height:4px;border-radius:2px;background:#fff;top:11px}
.burger span::before{top:-10px}.burger span::after{top:10px}
@media (max-width:1000px){
  header .wrap{grid-template-columns:1fr auto;min-height:80px;padding:10px 24px}
  nav.main,header>.wrap>.lang,header .btn{display:none}
  .logo{text-align:left;font-size:1.5rem}
  .burger{display:block}
  nav.main.open{display:grid;position:absolute;top:100%;left:0;right:0;background:var(--green);padding:24px;gap:16px;font-size:1.05rem}
  nav.main.open div{flex-direction:column;gap:12px}
  nav.main.open .lang{display:flex;gap:20px}
}
/* hero */
.hero{position:relative;height:100svh;min-height:600px;display:grid;place-items:center;text-align:center;padding:0;overflow:hidden}
.hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.35) brightness(.55)}
.hero .in{position:relative;z-index:1;display:grid;gap:30px;justify-items:center;padding:0 24px}
/* three column sections */
.three{display:grid;grid-template-columns:1fr 1fr 1fr;gap:40px;align-items:center}
.three .stack2{display:grid;gap:20px}
.three img{width:100%;object-fit:cover;aspect-ratio:3/2}
.three .txt{text-align:center;padding:0 10px}
.three .txt h2,.three .txt h3{margin-bottom:18px}
.three .txt p{color:var(--grey);margin-bottom:28px}
.three .txt .lbl{font-size:.72rem;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);display:block;margin-bottom:10px}
@media (max-width:900px){.three{grid-template-columns:1fr}.three .stack2{grid-template-columns:1fr 1fr}}
/* half photo sections */
.half{display:grid;grid-template-columns:1fr 1fr;min-height:560px}
.half .pic{position:relative;overflow:hidden}
.half .pic img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.half .txt{padding:90px 80px;display:grid;align-content:center;gap:20px;background:var(--cream)}
.half .txt p{color:var(--grey)}
.half .txt ol{margin:0;padding-left:20px;color:var(--grey)}
.half .txt .btn{justify-self:start}
.half.alt .txt{background:#fff}
@media (max-width:900px){.half{grid-template-columns:1fr;min-height:0}.half .pic{height:320px;order:-1}.half .txt{padding:50px 24px}}
/* two col heading/text */
.two{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start}
.two p{color:var(--grey);margin-bottom:28px}
@media (max-width:900px){.two{grid-template-columns:1fr;gap:24px}}
/* cards */
.cards{display:grid;grid-template-columns:1fr 1fr 1fr;gap:50px;text-align:center}
.cards img{aspect-ratio:1;object-fit:cover;width:100%;margin-bottom:26px}
.cards h3{margin-bottom:12px}
.cards p{color:var(--grey);font-size:.95rem}
@media (max-width:900px){.cards{grid-template-columns:1fr;gap:40px}}
/* reviews */
.revs{background:var(--cream)}
.revs .top{display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap;margin-bottom:46px}
.scores{display:flex;gap:40px}
.scores b{display:block;font-family:'Marcellus',serif;font-size:2.4rem;line-height:1;color:var(--green)}
.scores>div>span{font-size:.8rem;color:var(--grey);letter-spacing:.08em;text-transform:uppercase}
.rgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
.rev{background:#fff;padding:34px 30px;border-top:3px solid var(--gold);font-size:.95rem;color:var(--grey)}
.rev .stars{color:var(--gold);letter-spacing:3px;margin-bottom:14px}
.rev b{display:block;margin-top:18px;font-family:'Marcellus',serif;font-size:1.15rem;color:var(--green)}
.rev small{display:block;font-size:.76rem;letter-spacing:.1em;text-transform:uppercase}
@media (max-width:900px){.rgrid{grid-template-columns:1fr}}
/* faq */
.faq h2{text-align:center;margin-bottom:50px}
details{border-bottom:1px solid #ddd}
details:first-of-type{border-top:1px solid #ddd}
summary{cursor:pointer;list-style:none;padding:22px 0;display:flex;justify-content:space-between;gap:14px;font-family:'Marcellus',serif;font-size:1.25rem;color:var(--green)}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";color:var(--gold);font-size:1.6rem;line-height:1}
details[open] summary::after{content:"–"}
details p{padding:0 0 22px;color:var(--grey)}
/* gallery */
.gal{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}
.gal a{display:block;overflow:hidden}
.gal img{aspect-ratio:1;object-fit:cover;width:100%;transition:transform .6s}
.gal a:hover img{transform:scale(1.05)}
@media (max-width:900px){.gal{grid-template-columns:repeat(3,1fr)}}
@media (max-width:560px){.gal{grid-template-columns:1fr 1fr}}
/* booking + contact */
.book{background:var(--green);color:#fff;text-align:center}
.book h2{color:#fff}
.widget{margin:40px auto 30px;max-width:900px;border:1px dashed var(--gold);min-height:300px;display:grid;place-items:center;padding:30px;background:rgba(255,255,255,.04)}
.widget span{display:block;font-size:.72rem;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);margin-bottom:10px}
.actions{display:flex;justify-content:center;gap:14px;flex-wrap:wrap}
.btn.white{background:#fff;color:var(--green)}
.contact .two{align-items:start}
form{display:grid;gap:14px}
label{display:grid;gap:6px;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;color:var(--grey)}
input,textarea{font:inherit;font-family:'Montserrat',sans-serif;padding:14px 16px;border:1px solid #ddd;background:var(--cream);color:var(--ink);width:100%}
textarea{min-height:120px;resize:vertical}
.hint{font-size:.82rem;color:var(--grey)}
dl{margin:0;display:grid;gap:14px}
dt{font-family:'Marcellus',serif;font-size:1.15rem;color:var(--green)}
dd{margin:2px 0 0;color:var(--grey)}
/* footer */
footer{background:var(--green);color:#fff}
.fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:40px;padding:70px 0 50px}
.fgrid p{color:#cfd8d2;font-size:.95rem;margin-top:16px;max-width:360px}
.fgrid h4{color:var(--gold);font-size:1.1rem;letter-spacing:.08em;margin-bottom:16px}
.fgrid a{display:block;text-decoration:none;color:#fff;font-size:.95rem;margin-bottom:8px}
.logo-slot{width:150px;height:84px;border:1px dashed #9fb3a8;display:grid;place-items:center;text-align:center;font-size:.66rem;color:#cfd8d2;padding:8px}
@media (max-width:900px){.fgrid{grid-template-columns:1fr 1fr}}
@media (max-width:560px){.fgrid{grid-template-columns:1fr}}
.fbot{border-top:1px solid rgba(255,255,255,.15);font-size:.85rem;color:#cfd8d2}
.fbot .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;padding-top:18px;padding-bottom:18px}
.rv{opacity:1}
@media (prefers-reduced-motion:no-preference){.rv{opacity:0;transform:translateY(18px);transition:opacity .8s,transform .8s}.rv.in{opacity:1;transform:none}}

/* ---- mobile QA (owner checks on phone): tap targets, readable sizes, iOS zoom, header offsets ---- */
@media (max-width:1000px){
  input,textarea,select{font-size:16px!important}
  .btn{min-height:44px;display:inline-flex;align-items:center;justify-content:center;font-size:13px}
  .burger{width:44px;height:44px;display:grid;place-items:center;padding:0}
  .burger span{position:relative;top:auto;left:auto}
  #menu a{min-height:44px;display:flex;align-items:center}
  [data-set-lang]{min-width:44px;min-height:44px}
  main p a:not(.btn),main dd a:not(.btn),main li a:not(.btn){display:inline-block;padding:12px 0;margin:-12px 0}
  .hint{font-size:15px}
  .logo-slot{font-size:11.5px}
}

@media (max-width:1000px){
  .lbl,.three .txt .lbl,.widget span{font-size:12px}
  .rev small{font-size:13px}
  .scores>div>span{font-size:13px}
  label{font-size:13px}
  .lang button{min-width:44px;min-height:44px}
  .fgrid a{min-height:44px;display:flex;align-items:center;margin-bottom:0}
  .logo{min-height:44px;display:inline-grid;align-content:center}
  [id]{scroll-margin-top:90px}
}
@media (max-width:1000px){.fbot span{font-size:14px}main p a:not(.btn),main dd a:not(.btn),main li a:not(.btn){padding:12px 6px;margin:-12px -6px}}
@media (max-width:1000px){.btn{gap:.3em}}
</style>
</head>
<body>
<header>
  <div class="wrap">
    <a class="logo" href="#top">STRATO<small>APARTMENT · KOČEVJE</small></a>
    <nav class="main" id="menu" aria-label="Meni">
      <div><a href="#apartma"><Fragment set:html={t('Apartma','Apartment')} /></a><a href="#oprema"><Fragment set:html={t('Oprema','Amenities')} /></a><a href="#galerija"><Fragment set:html={t('Galerija','Gallery')} /></a></div>
      <div><a href="#okolica"><Fragment set:html={t('Okolica','Nearby')} /></a><a href="#ocene"><Fragment set:html={t('Ocene','Reviews')} /></a><a href="#vprasanja"><Fragment set:html={t('Pogosta vprašanja','FAQ')} /></a></div>
      <div class="lang" role="group" aria-label="Jezik / Language"><button type="button" data-set-lang="sl" aria-pressed="true"><i></i>SL</button><button type="button" data-set-lang="en" aria-pressed="false"><i></i>EN</button></div>
    </nav>
    <div class="lang" role="group" aria-label="Jezik / Language"><button type="button" data-set-lang="sl" aria-pressed="true"><i></i>SL</button><button type="button" data-set-lang="en" aria-pressed="false"><i></i>EN</button></div>
    <a class="btn" href="#kontakt"><Fragment set:html={t('Kontakt','Contact')} /></a>
    <button class="burger" type="button" aria-label="Meni" aria-controls="menu" aria-expanded="false"><span></span></button>
  </div>
</header>

<main id="top">
  <section class="hero">
    <Fragment set:html={img('02','','eager')} />
    <div class="in"><h1><Fragment set:html={t('Apartma ob Kočevskem jezeru','An apartment by Lake Kočevje')} /></h1><a class="btn" href="#bentral"><Fragment set:html={t('Rezervacija','Reservation')} /></a></div>
  </section>

  <section id="apartma"><div class="wrap three rv">
    <div class="stack2"><Fragment set:html={img('01')} /><Fragment set:html={img('05')} /></div>
    <div class="txt"><h2><Fragment set:html={t('Dnevna soba','Living room')} /></h2><p><Fragment set:html={t(S.living,E.living)} /></p><a class="btn" href="#bentral"><Fragment set:html={t('Rezervacija','Reservation')} /></a></div>
    <div><Fragment set:html={img('04')} /></div>
  </div></section>

  <section style="padding-top:0"><div class="wrap three rv">
    <div><Fragment set:html={img('06')} /></div>
    <div class="txt"><span class="lbl"><Fragment set:html={t('Kuhinja in jedilnica','Kitchen and dining')} /></span><h3><Fragment set:html={t('Popolnoma opremljena KUHINJA','A fully equipped KITCHEN')} /></h3><p><Fragment set:html={t(S.kitchen,E.kitchen)} /></p><a class="btn" href="#bentral"><Fragment set:html={t('Rezervacija','Reservation')} /></a></div>
    <div><Fragment set:html={img('09')} /></div>
  </div></section>

  <div class="half rv"><div class="pic"><Fragment set:html={img('11')} /></div><div class="txt"><h2><Fragment set:html={t('Dve spalnici','Two bedrooms')} /></h2><p><Fragment set:html={t(`${S.bedrooms}. ${S.bedroom1}.`,`${E.bedrooms}. ${E.bedroom1}.`)} /></p><p><Fragment set:html={t(`${S.bedroom2}. ${S.extras}.`,`${E.bedroom2}. ${E.extras}.`)} /></p></div></div>

  <div class="half alt rv"><div class="txt"><h2><Fragment set:html={t('Terasa v objemu narave','A terrace in the embrace of nature')} /></h2><p><Fragment set:html={t(`${S.outdoor}. ${S.living.split(';')[1] ? 'Neposreden izhod iz dnevne sobe na teraso.' : ''} ${S.rules}.`,`${E.outdoor}. Direct access from the living room to the terrace. ${E.rules}.`)} /></p><a class="btn" href="#bentral"><Fragment set:html={t('Rezervacija','Reservation')} /></a></div><div class="pic"><Fragment set:html={img('15')} /></div></div>

  <div class="half rv" id="okolica"><div class="pic"><Fragment set:html={img('07')} /></div><div class="txt"><h2><Fragment set:html={t('Utrip Kočevskega','The pulse of Kočevje')} /></h2><p><Fragment set:html={t(`${S.lake}, ${S.center}. Iz vodiča gostiteljev:`,`${E.lake}, ${E.center}. From the hosts’ guide:`)} /></p><ol>{d.things_to_do_from_hosts_folio_guide.map(p => (<li><Fragment set:html={t(p.sl,p.en)} /> – <Fragment set:html={t(p.note_sl,p.note_en)} /></li>))}</ol><p style="font-size:.9rem"><Fragment set:html={t('Več','More')} />: {d.more_from_guide.join(', ')}</p></div></div>

  <section id="oprema"><div class="wrap two rv">
    <h2><Fragment set:html={t('Oprema in udobje po meri gostov','Amenities and comfort for our guests')} /></h2>
    <div><p><Fragment set:html={t(`${S.bathroom}. ${S.climate}. ${S.parking}. ${S.renovated}. ${S.languages}.`,`${E.bathroom}. ${E.climate}. ${E.parking}. ${E.renovated}. ${E.languages}.`)} /></p><a class="btn" href="#kontakt"><Fragment set:html={t('Kontakt','Contact')} /></a></div>
  </div></section>

  <section style="padding-top:0"><div class="wrap cards rv">
    <div><Fragment set:html={img('03')} /><h3><Fragment set:html={t('Prenovljen leta 2025','Renovated in 2025')} /></h3><p><Fragment set:html={t(S.renovated,E.renovated)} /></p></div>
    <div><Fragment set:html={img('10')} /><h3><Fragment set:html={t('Prostor za do 5 oseb','Room for up to 5 guests')} /></h3><p><Fragment set:html={t(`${S.size}, ${S.bedrooms}.`,`${E.size}, ${E.bedrooms}.`)} /></p></div>
    <div><Fragment set:html={img('13')} /><h3><Fragment set:html={t('Osebni ali samostojni sprejem','In person or self check-in')} /></h3><p><Fragment set:html={t(`${S.checkin}. ${S.checkout}.`,`${E.checkin}. ${E.checkout}.`)} /></p></div>
  </div></section>

  <section class="revs" id="ocene"><div class="wrap">
    <div class="top rv"><h2><Fragment set:html={t('Ocene gostov','Guest reviews')} /></h2><div class="scores"><div><b><Fragment set:html={t('9,9','9.9')} /></b><span>Booking.com · <Fragment set:html={t('10 ocen','10 reviews')} /></span></div><div><b><Fragment set:html={t('5,0','5.0')} /></b><span>Airbnb · <Fragment set:html={t('9 ocen','9 reviews')} /></span></div></div></div>
    <div class="rgrid rv">{d.ratings.reviews.map(r => (<div class="rev"><div class="stars">★★★★★</div><Fragment set:html={t(r.sl,r.en)} /><b>{r.name}</b><small>{r.source} · <Fragment set:html={t(dsl(r.date),den(r.date))} />{r.translated && <Fragment set:html={t(' · prevedeno',' · translated')} />}</small></div>))}</div>
  </div></section>

  <section class="faq" id="vprasanja"><div class="wrap rv" style="max-width:900px">
    <h2><Fragment set:html={t('Pogosta vprašanja','Frequently asked questions')} /></h2>
    <details><summary><Fragment set:html={t('Kaj si lahko ogledam v bližini?','What can I see nearby?')} /></summary><p><Fragment set:html={t(d.things_to_do_from_hosts_folio_guide.map(p=>p.sl).join(', ')+'; '+d.more_from_guide.join(', ')+'.',d.things_to_do_from_hosts_folio_guide.map(p=>p.en).join(', ')+'; '+d.more_from_guide.join(', ')+'.')} /></p></details>
    <details><summary><Fragment set:html={t('Ali je parkirišče na voljo?','Is parking available?')} /></summary><p><Fragment set:html={t(S.parking,E.parking)} /></p></details>
    <details><summary><Fragment set:html={t('Ali so med bivanjem dovoljene živali?','Are pets allowed?')} /></summary><p><Fragment set:html={t(S.rules,E.rules)} /></p></details>
    <details><summary><Fragment set:html={t('Kdaj lahko opravim prijavo?','When can I check in?')} /></summary><p><Fragment set:html={t(`${S.checkin}. ${S.checkout}.`,`${E.checkin}. ${E.checkout}.`)} /></p></details>
    <details><summary><Fragment set:html={t('Kakšna je največja kapaciteta?','What is the maximum capacity?')} /></summary><p><Fragment set:html={t(`${S.guests}; ${S.bedrooms}. ${S.extras}.`,`${E.guests}; ${E.bedrooms}. ${E.extras}.`)} /></p></details>
    <details><summary><Fragment set:html={t('Katere jezike govorita gostitelja?','Which languages do the hosts speak?')} /></summary><p><Fragment set:html={t(S.languages,E.languages)} /></p></details>
  </div></section>

  <section id="galerija" style="padding-top:0"><div class="wrap gal rv">{all.map(n => (<a href={`../assets/strato-${n}.jpg`}><Fragment set:html={img(n)} /></a>))}</div></section>

  <section class="book" id="bentral"><div class="wrap rv">
    <h2><Fragment set:html={t('Rezervacija','Reservation')} /></h2>
    <div class="widget"><div><span>Bentral</span><p><Fragment set:html={t('Tu bo Bentral rezervacijski koledar (vstavimo kodo vtičnika).','The Bentral booking calendar will appear here (plugin code to be inserted).')} /></p></div></div>
    <div class="actions"><a class="btn" href={d.phone_href}><Fragment set:html={t('Pokliči','Call')} /> {d.phone}</a><a class="btn white" href={`mailto:${d.email}`}><Fragment set:html={t('Piši na e-pošto','Send an e-mail')} /></a></div>
  </div></section>

  <section class="contact" id="kontakt"><div class="wrap two rv">
    <div><h2 style="margin-bottom:24px"><Fragment set:html={t('Kontakt','Contact')} /></h2>
      <dl>
        <div><dt><Fragment set:html={t('Naslov','Address')} /></dt><dd>{d.address} · <a href={d.maps} target="_blank" rel="noopener"><Fragment set:html={t('zemljevid','map')} /></a></dd></div>
        <div><dt><Fragment set:html={t('Telefon in e-pošta','Phone and e-mail')} /></dt><dd><a href={d.phone_href}>{d.phone}</a> · <a href={`mailto:${d.email}`}>{d.email}</a></dd></div>
        <div><dt><Fragment set:html={t('Hišni red','House rules')} /></dt><dd><Fragment set:html={t(S.rules,E.rules)} /></dd></div>
        <div><dt><Fragment set:html={t('Gostitelja','Hosts')} /></dt><dd>{d.hosts}</dd></div>
      </dl></div>
    <form method="post" enctype="text/plain" action={`mailto:${d.email}?subject=${encodeURIComponent(mailSl)}`} data-subject-sl={mailSl} data-subject-en={mailEn}>
      <label><Fragment set:html={t('Ime in priimek','Full name')} /><input name="ime" required autocomplete="name"></label>
      <label><Fragment set:html={t('E-pošta','E-mail')} /><input name="eposta" type="email" required autocomplete="email"></label>
      <label><Fragment set:html={t('Termin (prihod – odhod)','Dates (arrival – departure)')} /><input name="termin" data-ph-sl="npr. 12. 7. – 16. 7." data-ph-en="e.g. 12 Jul – 16 Jul" placeholder="npr. 12. 7. – 16. 7."></label>
      <label><Fragment set:html={t('Sporočilo','Message')} /><textarea name="sporocilo"></textarea></label>
      <div><button class="btn" type="submit"><Fragment set:html={t('Odpri v e-pošti','Open in e-mail')} /></button></div>
      <p class="hint"><Fragment set:html={t(`Obrazec nima strežnika: gumb odpre vaš e-poštni program s pripravljenim sporočilom na ${d.email}, pošljete ga vi.`,`This form has no server: the button opens your e-mail app with a prepared message to ${d.email}; you send it yourself.`)} /></p>
    </form>
  </div></section>
</main>

<footer>
  <div class="wrap fgrid">
    <div><a class="logo" href="#top" style="text-align:left;display:inline-block">STRATO<small>APARTMENT · KOČEVJE</small></a><p><Fragment set:html={t(`Apartma ${S.size} za ${S.guests}, ${S.lake}. Gostitelja ${d.hosts}.`,`A ${E.size} apartment for ${E.guests}, ${E.lake}. Hosts ${d.hosts}.`)} /></p></div>
    <div><h4><Fragment set:html={t('Povezave','Links')} /></h4><a href="#apartma"><Fragment set:html={t('Apartma','Apartment')} /></a><a href="#galerija"><Fragment set:html={t('Galerija','Gallery')} /></a><a href="#vprasanja"><Fragment set:html={t('Pogosta vprašanja','FAQ')} /></a><a href="#bentral"><Fragment set:html={t('Rezervacija','Reservation')} /></a></div>
    <div><h4><Fragment set:html={t('Kontakt','Contact')} /></h4><a href={d.phone_href}>{d.phone}</a><a href={`mailto:${d.email}`}>{d.email}</a><a href={d.maps} target="_blank" rel="noopener">{d.address}</a><a href={d.kocevsko_link} target="_blank" rel="noopener"><Fragment set:html={t('Najdete nas tudi na Kočevsko.com','Find us also on Kočevsko.com')} /></a></div>
    <div><h4>Green &amp; Safe</h4><div class="logo-slot"><Fragment set:html={t('Logo Green &amp; Safe (pošljeta gostitelja)','Green &amp; Safe logo (to be sent by the hosts)')} /></div></div>
  </div>
  <div class="fbot"><div class="wrap"><span>© Strato Apartment · {d.hosts}</span><span><Fragment set:html={t('Predogled: AK agencija','Preview: AK agencija')} /></span></div></div>
</footer>

<script is:inline>
(function(){
  var root=document.documentElement;
  function apply(l){root.lang=l;try{localStorage.setItem('strato-lang',l)}catch(e){}
    document.querySelectorAll('[data-set-lang]').forEach(function(b){b.setAttribute('aria-pressed',String(b.getAttribute('data-set-lang')===l))});
    document.querySelectorAll('[data-alt-sl]').forEach(function(i){i.alt=i.getAttribute('data-alt-'+l)||i.alt});
    document.querySelectorAll('[data-ph-sl]').forEach(function(i){i.placeholder=i.getAttribute('data-ph-'+l)||''});
    document.querySelectorAll('form[data-subject-sl]').forEach(function(f){var m=f.action.split('?')[0];f.action=m+'?subject='+encodeURIComponent(f.getAttribute('data-subject-'+l))});
    document.title=l==='en'?'Strato Apartment – Kočevje, Slovenia':'Strato Apartment – Kočevje';}
  document.querySelectorAll('[data-set-lang]').forEach(function(b){b.addEventListener('click',function(){apply(b.getAttribute('data-set-lang'))})});
  apply(root.lang==='en'?'en':'sl');
  var bg=document.querySelector('.burger'),menu=document.getElementById('menu');
  bg.addEventListener('click',function(){var o=menu.classList.toggle('open');bg.setAttribute('aria-expanded',String(o))});
  menu.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(){menu.classList.remove('open')})});
  var els=document.querySelectorAll('.rv');
  if('IntersectionObserver' in window&&!matchMedia('(prefers-reduced-motion: reduce)').matches){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{rootMargin:'0px 0px -2% 0px'});els.forEach(function(e){io.observe(e)})}else{els.forEach(function(e){e.classList.add('in')})}
})();
</script>
</body>
</html>
