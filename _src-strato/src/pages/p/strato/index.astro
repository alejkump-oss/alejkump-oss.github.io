---
// Strato Apartment – chooser: 7 predlogov, eden na referenčno stran, ki sta jo poslala Barbara in Rok.
import d from '../../../data/strato.json';
const A = 'assets/';
const cards = [
  { n: 1, img: '05', ref: 'neu-residences.com/en/workation', sl: 'Kot NEU Residences: bela glava z logotipom v okvirju, terakota gumbi, izmenični obrobljeni bloki s fotografijami.', en: 'Like NEU Residences: white header with a boxed logo, terracotta buttons, alternating outlined blocks with photos.' },
  { n: 2, img: '09', ref: 'resort-beatrice.si', sl: 'Kot Resort Beatrice: zlata vrstica, fotografija čez cel zaslon, temen vrtiljak sob, zeleni pas z opremo, kartice z ocenami.', en: 'Like Resort Beatrice: gold bar, full-screen photo, a dark room carousel, a green amenities band, review cards.' },
  { n: 3, img: '11', ref: 'vilaspecial.com', sl: 'Kot Vila Special: temen drsnik z vrstico za prihod/odhod, elegantna serifna pisava, svetlo-temni pasovi.', en: 'Like Vila Special: dark slider with an arrival/departure bar, elegant serif type, light and dark bands.' },
  { n: 4, img: '01', ref: 'carolinaluxurystay.com', sl: 'Kot Carolina Luxury Stay: temno zelena glava z zlatim logotipom, mirna velika fotografija, kremni odseki, harmonika vprašanj.', en: 'Like Carolina Luxury Stay: deep-green header with a gold logo, a calm large photo, cream sections, FAQ accordion.' },
  { n: 5, img: '02', ref: 'bohinjmountaindreams.com/sl', sl: 'Enaka postavitev kot referenca: osrednji serifni logotip nad celozaslonsko fotografijo, rjava rezervacijska vrstica, sivi gumbi, bež poziv, štiristolpčna noga. (Vajin »dober vmesnik«.)', en: 'Same layout as the reference: centred serif logo over a full-screen photo, tan booking bar, grey buttons, beige call-to-action, four-column footer. (Your "good interface".)', star: true },
  { n: 6, img: '07', ref: 'oldsquarehouse.com/sl', sl: 'Enaka postavitev kot referenca: krepki Manrope naslovi s poševno zeleno vrstico, stekleni okvirji na junaku, zelene kapsule, tri kartice sob, zelena plošča »Dostopnost«, pogosta vprašanja.', en: 'Same layout as the reference: heavy Manrope headlines with an italic teal line, glass boxes on the hero, teal pills, three room cards, teal "Getting around" panel, FAQ.' },
  { n: 7, img: '03', ref: 'cirus-apartments.com/sl/domov', sl: 'Enaka postavitev kot referenca: rožnata stranska vrstica, deljen junak z monogramom, tanka serifna pisava s črtami, temni pasovi z okvirji, dvojno obrobljeni gumbi, drsnik mnenj.', en: 'Same layout as the reference: pink sidebar, split hero with a monogram, thin serif type with stripes, dark framed bands, double-bordered buttons, review slider.' },
];
---
<!doctype html>
<html lang="sl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Strato Apartment – 7 predlogov</title>
<meta name="robots" content="noindex" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
<style is:global>
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:Inter,system-ui,sans-serif;background:#f4f3ef;color:#1b1b1b;line-height:1.55;padding:clamp(24px,5vw,64px) clamp(16px,4vw,48px)}
  .wrap{max-width:1180px;margin:0 auto}
  h1{font-size:clamp(28px,4vw,44px);font-weight:600;letter-spacing:-.02em}
  .sub{color:#5d5d57;margin-top:10px;max-width:70ch}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:18px;margin-top:36px}
  a.card{display:block;background:#fff;border:1px solid #e3e1da;border-radius:14px;overflow:hidden;color:inherit;text-decoration:none;transition:transform .25s,box-shadow .25s;position:relative}
  a.card:hover{transform:translateY(-3px);box-shadow:0 20px 40px -28px rgba(0,0,0,.35)}
  a.card img{width:100%;aspect-ratio:16/10;object-fit:cover;display:block}
  .b{padding:16px 18px 20px}
  .n{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#7a776f;font-weight:600}
  .ref{font-size:13px;color:#2c6a9c;margin-top:4px;word-break:break-all}
  .d{font-size:14px;color:#3d3d39;margin-top:10px}
  .d em{display:block;font-style:normal;color:#7a776f;margin-top:4px;font-size:13px}
  .go{display:inline-block;margin-top:14px;font-weight:600;font-size:14px}
  .star{position:absolute;top:12px;left:12px;background:#1b1b1b;color:#fff;font-size:11px;letter-spacing:.1em;text-transform:uppercase;padding:6px 10px;border-radius:999px}
  footer{margin-top:40px;font-size:13px;color:#7a776f}
  @media (prefers-reduced-motion:reduce){a.card{transition:none}}
</style>
</head>
<body>
<div class="wrap">
  <h1>Strato Apartment, 7 predlogov</h1>
  <p class="sub">Za vsako referenčno stran, ki sta jo poslala, en celoten predlog z vajinimi fotografijami in podatki. Vsak ima slovenščino in angleščino (SL | EN), rezervacijski razdelek za Bentral, ocene, kontaktni obrazec in »things to do«. Kliknite predlog in ga preizkusite na telefonu in računalniku.<br /><small>One full proposal per reference site you sent. Each has SL | EN, a Bentral booking slot, ratings, a contact form and things to do.</small></p>
  <div class="grid">
    {cards.map((c) => (
      <a class="card" href={`v${c.n}/`}>
        {c.star && <span class="star">dober vmesnik</span>}
        <img src={A+'strato-'+c.img+'.jpg'} alt={`Predlog ${c.n}`} loading={c.n > 3 ? 'lazy' : 'eager'} />
        <div class="b">
          <div class="n">Predlog {c.n}</div>
          <div class="ref">navdih: {c.ref}</div>
          <p class="d">{c.sl}<em>{c.en}</em></p>
          <span class="go">Odpri predlog {c.n} →</span>
        </div>
      </a>
    ))}
  </div>
  <footer>Predogled: AK agencija · {d.hosts} · {d.email}</footer>
</div>
</body>
</html>
