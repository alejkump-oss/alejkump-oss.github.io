      <div class="lbl" set:html={t('Lega', 'Location')} /><p set:html={t(`${f.lake}. ${f.center}. ${f.parking}.`, `${e.lake}. ${e.center}. ${e.parking}.`)} />
      <div class="btns"><a class="btn o" href={d.maps} target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg><span set:html={t('Odpri v Google Zemljevidih', 'Open in Google Maps')} /></a></div>
      <div class="badges"><div class="gs" set:html={t('Logo Green &amp; Safe<br>(pošljeta gostitelja)', 'Green &amp; Safe logo<br>(hosts will send it)')} /><a class="koc" href={d.kocevsko_link} target="_blank" rel="noopener" set:html={t('Najdete nas tudi na Kočevsko.com', 'Also find us on Kočevsko.com')} /></div>
