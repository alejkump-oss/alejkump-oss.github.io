          {s.pins.map((p) => (
            <button class={'pin'+(p.y<22?' flip':'')+(p.x<14?' left':'')+(p.x>86?' right':'')} type="button" style={`left:${p.x}%;top:${p.y}%`} aria-expanded="false"><i></i><span class="tip"><Fragment set:html={t(p.sl,p.en)} /></span></button>
          ))}
        </div>
      </div>
    ))}
    <div class="stop" data-room="rest" data-i={stops.length}>
      <div class="textstop"><div>
        <h3><Fragment set:html={t('Kar še ni na fotografijah','What the photos do not show yet')} /></h3>
        <ul>
          <li><Fragment set:html={t(f.bathroom,e.bathroom)} /></li>
