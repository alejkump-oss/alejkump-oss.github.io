      </div></div>
    </div>
  </div>
  <div class="hud t">
    <div class="name" aria-live="polite"><b id="tname"></b><small id="tsub"></small></div>
    <button class="x" type="button" id="tclose" aria-label="Zapri sprehod / Close the walk">×</button>
  </div>
  <div class="hud b">
    <p class="cap" id="tcap"></p>
    <div class="chips" role="tablist" aria-label="Sobe / Rooms">
      {rooms.map((r) => (<button class="chip" type="button" role="tab" data-room={r.id} aria-current="false"><Fragment set:html={t(r.sl,r.en)} /></button>))}
