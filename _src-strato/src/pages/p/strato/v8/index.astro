      <label for="cn" set:html={t('Ime in priimek', 'Name')} /><input id="cn" name="name" type="text" autocomplete="name" required />
      <label for="ce" set:html={t('Vaš e-naslov', 'Your e-mail')} /><input id="ce" name="email" type="email" autocomplete="email" required />
