      <button class="btn" type="submit" set:html={t('Pošlji po e-pošti', 'Send by e-mail')} />
      <p class="note" set:html={t('Gumb odpre vaš e-poštni program s pripravljenim sporočilom za ' + d.email + '. Nič se ne pošlje samodejno.', 'The button opens your e-mail app with a prepared message to ' + d.email + '. Nothing is sent automatically.')} />
