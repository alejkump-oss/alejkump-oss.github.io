---
// Strato Apartment – predlog 8 ("bolj virtualno"): v5's layout language (the clients' "dober vmesnik")
// plus a virtual walk-through built ONLY from their real photos, a stylised live-location map,
// parallax / scroll-reveal / tilt depth, and a clearly labelled slot for the real video or 360° tour.
// Own code, own text, Strato photos only. Facts come from strato.json and nowhere else.
import d from '../../../../data/strato.json';
const f = d.facts_sl, e = d.facts_en;
const A = '../assets/';
const t = (sl, en) => `<span data-lang="sl">${sl}</span><span data-lang="en">${en}</span>`;
const todo = d.things_to_do_from_hosts_folio_guide;
const reviews = d.ratings.reviews;
const split = (s) => s.split(' / ');
const gallery = ['01','03','04','05','06','07','08','10','11','12','13','14','15'];
const amen = [[f.bedrooms,e.bedrooms],[f.living,e.living],[f.kitchen,e.kitchen],[f.bedroom1,e.bedroom1],[f.bedroom2,e.bedroom2],[f.bathroom,e.bathroom],[f.climate,e.climate],[f.outdoor,e.outdoor],[f.parking,e.parking],[f.extras,e.extras],[f.renovated,e.renovated],[f.languages,e.languages]];

// Rooms that a real photo actually shows. Bathroom, terrace/garden and the entrance door have no photo:
// they appear as a text card at the end of the walk, never as a staged picture.
const rooms = [
  { id:'living',  sl:'Dnevna soba',     en:'Living room',     fact:[f.living,e.living],     cover:'02' },
  { id:'kitchen', sl:'Kuhinja',         en:'Kitchen',         fact:[f.kitchen,e.kitchen],   cover:'09' },
  { id:'bed1',    sl:'Velika spalnica', en:'Large bedroom',   fact:[f.bedroom1,e.bedroom1], cover:'11' },
  { id:'bed2',    sl:'Manjša spalnica', en:'Smaller bedroom', fact:[f.bedroom2,e.bedroom2], cover:'15' },
];
// Every pin text is a fact from strato.json (facts_sl / facts_en). x/y are percentages of the photo.
const stops = [
  { room:'living', img:'01', alt_sl:'Dnevna soba: kavč, preproga in delovni kotiček', alt_en:'Living room: sofa, rug and desk corner',
    pins:[{x:60,y:62,sl:'Raztegljiv kavč',en:'Sofa bed'},{x:45,y:86,sl:'Otroške igrače in družabne igre',en:"Children's toys and board games"},{x:36,y:54,sl:'Ogrevanje s toplotno črpalko',en:'Heat-pump heating'}] },
  { room:'living', img:'02', alt_sl:'Dnevna soba proti terasi, TV in kitara', alt_en:'Living room towards the terrace, TV and guitar',
    pins:[{x:80,y:38,sl:'TV',en:'TV'},{x:88,y:70,sl:'Kitara',en:'Guitar'},{x:52,y:45,sl:'Neposreden izhod na teraso',en:'Direct access to the terrace'}] },
  { room:'living', img:'03', alt_sl:'Glasbeni kotiček s klavirjem in tolkali', alt_en:'Music corner with piano and percussion',
    pins:[{x:25,y:58,sl:'Klavir',en:'Piano'},{x:57,y:77,sl:'Tolkala',en:'Percussion'},{x:30,y:22,sl:'Leta 2025 v celoti prenovljen',en:'Fully renovated in 2025'}] },
  { room:'kitchen', img:'09', alt_sl:'Kuhinja z jedilno mizo pri oknu', alt_en:'Kitchen with the dining table by the window',
    pins:[{x:36,y:52,sl:'Indukcijska plošča',en:'Induction hob'},{x:43,y:66,sl:'Pečica',en:'Oven'},{x:18,y:78,sl:'Pomivalni stroj',en:'Dishwasher'}] },
  { room:'kitchen', img:'08', alt_sl:'Kuhinjski pult s kavnima aparatoma', alt_en:'Kitchen worktop with the coffee machines',
    pins:[{x:80,y:60,sl:'Kavni aparati',en:'Coffee machines'},{x:6,y:54,sl:'Kuhalnik vode',en:'Kettle'},{x:70,y:38,sl:'Osnovna živila',en:'Basic supplies'},{x:37,y:66,sl:'Indukcijska plošča',en:'Induction hob'}] },
  { room:'bed1', img:'11', alt_sl:'Velika spalnica z leseno omaro in zakonsko posteljo', alt_en:'Large bedroom with the wooden wardrobe and king-size bed',
    pins:[{x:60,y:65,sl:'Velika zakonska postelja',en:'King-size bed'},{x:85,y:52,sl:'Ambientna osvetlitev',en:'Ambient lighting'},{x:40,y:88,sl:'Otroška posteljica na voljo',en:'Baby cot available'}] },
  { room:'bed1', img:'13', alt_sl:'Velika spalnica: knjige in multimedija ob oknu', alt_en:'Large bedroom: books and media by the window',
    pins:[{x:85,y:63,sl:'Knjige',en:'Books'},{x:90,y:76,sl:'Multimedija',en:'Media'},{x:35,y:57,sl:'Ambientna osvetlitev',en:'Ambient lighting'}] },
  { room:'bed2', img:'14', alt_sl:'Manjša spalnica s sedalnima vrečama', alt_en:'Smaller bedroom with the bean bags',
    pins:[{x:62,y:72,sl:'Dve sedalni vreči',en:'Two bean bags'},{x:5,y:32,sl:'TV',en:'TV'},{x:10,y:60,sl:'Zakonska postelja',en:'Double bed'}] },
  { room:'bed2', img:'15', alt_sl:'Manjša spalnica: TV z igralno konzolo in postelja', alt_en:'Smaller bedroom: TV with the games console and bed',
    pins:[{x:50,y:40,sl:'TV in igralna konzola Xbox',en:'TV and Xbox console'},{x:80,y:66,sl:'Zakonska postelja',en:'Double bed'},{x:14,y:75,sl:'Sedalna vreča',en:'Bean bag'}] },
];
const roomOf = (id) => rooms.find((r) => r.id === id);
const firstStop = Object.fromEntries(rooms.map((r) => [r.id, stops.findIndex((s) => s.room === r.id)]));
// Map pins: only the lake carries a distance (from the JSON); the other four have no distance and sit in a
// clearly labelled "no scale" band. x/y are percentages of the map box.
const mapPins = [
  { i:0, x:76, y:56, route:true },
  { i:1, x:14, y:13 }, { i:2, x:38, y:13 }, { i:3, x:62, y:13 }, { i:4, x:86, y:13 },
];
---
<!doctype html>
<html lang="sl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>Strato Apartment · Kočevje</title>
<meta name="description" content="Strato Apartment, Kočevje – apartma za do 5 oseb, 270 m od Kočevskega jezera. Virtualni sprehod iz fotografij. Predlog spletne strani (AK agencija)." />
<meta name="robots" content="noindex" />
<script is:inline>
  (function(){var h=document.documentElement;h.classList.add('js');try{var l=localStorage.getItem('strato-lang');if(l==='en'||l==='sl')h.lang=l;}catch(e){}})();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bona+Nova:ital,wght@0,400;0,700;1,400&family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
<style is:global>
  :root{
    --ink:#000; --text:#393939; --mute:#6d6d6d; --line:#e4e4e4;
    --brown:#6b5b44; --brown2:#6f5736; --tan:#9a7b4e; --beige:#f5f0ea; --grey:#69727d;
    --serif:'Bona Nova',Georgia,'Times New Roman',serif; --sans:'Work Sans',Arial,sans-serif;
    --max:1100px; --gut:clamp(16px,4vw,40px);
    --rx:0deg; --ry:0deg; --gx:50%; --gy:50%;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  html.lock,html.lock body{overflow:hidden}
  body{background:#fff;color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.7;font-weight:400;overflow-x:hidden}
  img{display:block;max-width:100%;height:auto}
  a{color:inherit;text-decoration:none}
  html[lang=sl] [data-lang=en]{display:none!important}
  html[lang=en] [data-lang=sl]{display:none!important}
  .wrap{max-width:var(--max);margin:0 auto;padding:0 var(--gut)}
  h1,h2,h3{font-family:var(--serif);font-weight:400;line-height:1.15;color:var(--ink)}
  h1{font-size:34px}
  h2{font-size:28px}
  h3{font-size:24px}
  p{margin:0 0 22px}
  .over{display:block;font-size:14px;text-transform:uppercase;letter-spacing:.02em;color:var(--ink);line-height:1.3}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--grey);color:#fff;font:400 15px/1.2 var(--sans);text-transform:uppercase;padding:13px 24px;min-height:44px;border-radius:3px;border:0;cursor:pointer;transition:background .25s,transform .25s}
  .btn:hover{background:#525a63}
  .btn.brown{background:var(--brown2);text-transform:none;font-weight:600;font-size:14px;padding:16px 30px}
  .btn.brown:hover{background:#5a4629}
  .btn.outline{background:transparent;color:var(--brown2);border:1px solid var(--brown2);font-size:13px;padding:16px 34px}
  .btn.outline:hover{background:var(--brown2);color:#fff}
  .btn.ghost{background:rgba(255,255,255,.14);color:#fff;border:1px solid rgba(255,255,255,.7);text-transform:none;font-weight:600;font-size:14px;padding:15px 26px;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
  .btn.ghost:hover{background:rgba(255,255,255,.26)}
  .btn svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:1.8;flex:0 0 18px}

  /* header over hero */
  .top{position:absolute;inset:0 0 auto 0;z-index:30;color:#fff}
  .top .bar{display:flex;justify-content:space-between;align-items:center;padding:calc(8px + env(safe-area-inset-top)) max(var(--gut),env(safe-area-inset-right)) 8px max(var(--gut),env(safe-area-inset-left));font-size:15px}
  .top .bar a,.top .bar button{color:#fff;background:none;border:0;font:400 15px/1 var(--sans);cursor:pointer;padding:4px 10px;opacity:.9;min-height:44px;min-width:44px;display:inline-flex;align-items:center;justify-content:center}
  .top .bar [aria-pressed=true]{text-decoration:underline;text-underline-offset:4px;opacity:1}
  .top .bar .r{display:flex;gap:14px}
  .brandrow{position:relative;display:flex;justify-content:center;align-items:flex-start;padding:4px var(--gut) 0}
  .brand{text-align:center;display:flex;flex-direction:column;align-items:center;gap:2px}
  .brand svg{width:58px;height:40px;stroke:#fff;fill:none;stroke-width:1.6}
  .brand b{font:400 20px/1.2 var(--serif);letter-spacing:.06em;text-transform:uppercase}
  .brand small{font:300 12px/1.2 var(--sans);letter-spacing:.3em;text-transform:uppercase;opacity:.92}
  .burger{position:absolute;right:calc(var(--gut) + 260px);top:30px;width:60px;height:44px;background:none;border:0;cursor:pointer;display:grid;gap:9px;padding:6px 0;align-content:center}
  .burger i{display:block;height:2px;background:#fff;width:60px}
  @media (max-width:1250px){.burger{right:var(--gut)}}
  @media (max-width:640px){.top .bar{font-size:13px}.burger{width:40px;top:18px;gap:7px}.burger i{width:40px}.brand svg{width:48px}.brand b{font-size:16px}.brand small{font-size:10px}}
  .overlay{position:fixed;inset:0;background:#000;color:#fff;z-index:40;display:none;flex-direction:column;align-items:center;justify-content:center;gap:22px;font-family:var(--serif);font-size:30px}
  .overlay.open{display:flex}
  .overlay a:hover{color:#d9c7a6}
  .overlay .x{position:absolute;top:22px;right:var(--gut);background:none;border:0;color:#fff;font:300 44px/1 var(--sans);cursor:pointer;min-width:44px;min-height:44px}

  /* hero (parallax background layer + Ken Burns) */
  .hero{position:relative;height:100svh;min-height:620px;display:grid;place-items:center;isolation:isolate;overflow:hidden}
  .hero .bg{position:absolute;inset:-12% 0 0 0;z-index:-2;will-change:transform}
  .hero .bg img{width:100%;height:100%;object-fit:cover;transform:scale(1.06);animation:kb 18s ease-out forwards}
  @keyframes kb{to{transform:scale(1)}}
  .hero::after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(0,0,0,.55),rgba(0,0,0,.22) 45%,rgba(0,0,0,.5))}
  .hero .hc{text-align:center;padding:0 var(--gut);color:#fff;display:grid;justify-items:center;gap:22px;will-change:transform,opacity}
  .hero h2{color:#fff;font-size:clamp(34px,4vw,50px);text-shadow:0 2px 12px rgba(0,0,0,.4)}
  .hero .hc small{font-size:13px;letter-spacing:.14em;text-transform:uppercase;opacity:.85}
  .hero .acts{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}
  .scrollhint{position:absolute;bottom:72px;left:50%;transform:translateX(-50%);width:22px;height:36px;border:1.5px solid rgba(255,255,255,.7);border-radius:12px;z-index:1}
  .scrollhint::after{content:'';position:absolute;left:50%;top:7px;width:3px;height:7px;margin-left:-1.5px;border-radius:2px;background:#fff;animation:wheel 1.8s ease-in-out infinite}
  @keyframes wheel{0%{transform:translateY(0);opacity:1}70%{transform:translateY(12px);opacity:0}100%{opacity:0}}

  /* booking bar overlapping hero */
  .bookwrap{position:relative;z-index:5;margin-top:-50px}
  .book{max-width:var(--max);margin:0 auto;background:var(--tan);padding:22px 20px;display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr) auto;gap:20px;align-items:end;box-shadow:0 30px 60px -40px rgba(0,0,0,.5)}
  .book label,.book .bk{display:grid;gap:4px;color:#fff;font:600 12px/1.2 var(--sans)}
  .book .d{flex:1 1 130px;display:grid;gap:0;color:var(--mute);padding:5px 0 4px}
  .book .d small{font:600 11px/1.2 var(--sans);letter-spacing:.06em;text-transform:uppercase;color:var(--mute)}
  .book .d input{height:auto;padding:2px 0 0;line-height:1.3}
  .book .field{background:#fff;border:1px solid #c9b48f;min-height:44px;display:flex;flex-wrap:wrap;align-items:center;gap:0 10px;padding:0 12px;color:var(--mute)}
  .book .field svg{width:18px;height:18px;stroke:#444;fill:none;stroke-width:1.6;flex:0 0 18px}
  .book input{flex:1 1 130px;width:auto;height:44px;border:0;outline:none;font:400 16px/1 var(--sans);color:var(--text);background:transparent;min-width:0}
  .book .btn{height:44px}
  @media (max-width:820px){.book{grid-template-columns:minmax(0,1fr);margin:0 var(--gut)}.bookwrap{margin-top:-30px}}

  /* text sections */
  .story{padding:72px 0 10px}
  .story p{color:var(--ink)}
  .figure{display:flex;justify-content:center;margin:26px 0 36px;perspective:1200px}
  .figure img{width:100%;max-width:1024px;aspect-ratio:3/2;object-fit:cover}
  .figure.narrow img{max-width:946px}
  .block{margin-bottom:34px}
  .block h2{margin-bottom:10px}
  .block .btn{margin-top:2px}
  .amen{list-style:none;columns:2;column-gap:40px;margin:18px 0 40px}
  .amen li{break-inside:avoid;padding:8px 0;border-bottom:1px solid var(--line);font-size:15px}
  @media (max-width:760px){.amen{columns:1}}

  /* 3D tilt cards (pointer on desktop, scroll-driven on touch) */
  .tilt{transform:perspective(900px) rotateX(var(--rx)) rotateY(var(--ry));transition:transform .25s ease-out;transform-style:preserve-3d;position:relative}
  .tilt::after{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at var(--gx) var(--gy),rgba(255,255,255,.22),transparent 55%);opacity:0;transition:opacity .3s}
  .tilt:hover::after{opacity:1}

  /* walk-through teaser section */
  .walk{padding:40px 0 20px;position:relative;overflow:hidden}
  .walk .lead{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:40px;align-items:end;margin-bottom:26px}
  .walk .lead p{color:var(--text);margin:0}
  .walk .lead .btn{justify-self:start}
  @media (max-width:820px){.walk .lead{grid-template-columns:minmax(0,1fr);gap:16px}}
  .roomgrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;perspective:1200px}
  .room{display:block;position:relative;aspect-ratio:3/4;overflow:hidden;background:#000;color:#fff;border:0;padding:0;cursor:pointer;text-align:left;font:inherit;border-radius:4px}
  .room img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.4s ease}
  .room:hover img{transform:scale(1.08)}
  .room::before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(0,0,0,.72));z-index:1}
  .room .lb{position:absolute;left:16px;right:16px;bottom:16px;z-index:2;display:grid;gap:4px}
  .room .lb b{font:400 22px/1.15 var(--serif)}
  .room .lb small{font-size:12px;letter-spacing:.12em;text-transform:uppercase;opacity:.85}
  .room .lb span{display:inline-flex;align-items:center;gap:6px;font-size:13px;text-decoration:underline;text-underline-offset:3px;margin-top:4px}
  @media (max-width:820px){.roomgrid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  .honest{font-size:13px;color:var(--mute);margin:12px 0 0;display:flex;gap:8px;align-items:center}
  .honest svg{width:16px;height:16px;stroke:var(--mute);fill:none;stroke-width:1.6;flex:0 0 16px}
  .video{margin-top:34px;border:1px dashed var(--tan);background:var(--beige);aspect-ratio:16/9;max-height:420px;display:grid;place-items:center;text-align:center;padding:28px;color:var(--text);position:relative;overflow:hidden}
  .video b{display:block;font:400 24px/1.2 var(--serif);color:var(--brown2);margin-bottom:8px}
  .video .play{width:64px;height:64px;border-radius:50%;border:1.5px solid var(--brown2);display:grid;place-items:center;margin:0 auto 14px}
  .video .play svg{width:22px;height:22px;fill:var(--brown2);margin-left:3px}
  .video p{margin:0;font-size:15px}
  .video small{display:block;margin-top:8px;font-size:13px;color:var(--mute)}
  .layer{position:absolute;pointer-events:none;border-radius:50%;background:radial-gradient(circle,rgba(154,123,78,.14),transparent 70%);will-change:transform}

  /* full-screen walk-through */
  .tour{position:fixed;inset:0;z-index:60;background:#000;color:#fff;display:none}
  .tour.open{display:block}
  .tour .stage{position:absolute;inset:0;overflow:hidden;overflow:clip}
  .tour .stop{position:absolute;inset:0;opacity:0;transition:opacity .9s ease;pointer-events:none;overflow:hidden;overflow:clip}
  .tour .stop.on{opacity:1;pointer-events:auto}
  .tour .ph{position:absolute;aspect-ratio:950/632;will-change:transform}
  .tour .ph img{width:100%;height:100%;object-fit:cover}
  @media (orientation:landscape){
    .tour .ph{left:50%;top:50%;width:max(100%,calc(100vh * 1.5032));width:max(100%,calc(100lvh * 1.5032));transform:translate(-50%,-50%)}
    .tour .stop.on .ph.a{animation:kbA 10s ease-in-out forwards}
    .tour .stop.on .ph.b{animation:kbB 10s ease-in-out forwards}
    @keyframes kbA{from{transform:translate(-50%,-50%) scale(1.02)}to{transform:translate(-50%,-50%) scale(1.13)}}
    @keyframes kbB{from{transform:translate(-50%,-50%) scale(1.13)}to{transform:translate(-50%,-50%) scale(1.02)}}
  }
  @media (orientation:portrait){
    .tour .ph{left:0;top:0;height:100%;width:auto}
    .tour .stop.on .ph.a{animation:panA 11s ease-in-out forwards}
    .tour .stop.on .ph.b{animation:panB 11s ease-in-out forwards}
    @keyframes panA{from{transform:translateX(0)}to{transform:translateX(calc(100vw - 100%))}}
    @keyframes panB{from{transform:translateX(calc(100vw - 100%))}to{transform:translateX(0)}}
  }
  .tour .stage::after{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(0,0,0,.55),transparent 22%,transparent 60%,rgba(0,0,0,.75))}
  .pin{position:absolute;width:44px;height:44px;margin:-22px 0 0 -22px;border:0;background:none;cursor:pointer;z-index:3;padding:0}
  .pin i{position:absolute;left:50%;top:50%;width:14px;height:14px;margin:-7px 0 0 -7px;border-radius:50%;background:#fff;box-shadow:0 0 0 3px rgba(111,87,54,.9),0 2px 10px rgba(0,0,0,.5)}
  .pin::before{content:'';position:absolute;left:50%;top:50%;width:14px;height:14px;margin:-7px 0 0 -7px;border-radius:50%;border:2px solid #fff;animation:pulse 2.2s ease-out infinite}
  @keyframes pulse{0%{transform:scale(1);opacity:.9}100%{transform:scale(2.6);opacity:0}}
  .pin .tip{position:absolute;left:50%;bottom:calc(100% - 4px);transform:translate(-50%,6px);background:rgba(255,255,255,.96);color:var(--ink);font:500 14px/1.35 var(--sans);padding:10px 14px;border-radius:4px;white-space:nowrap;max-width:min(260px,80vw);white-space:normal;width:max-content;opacity:0;visibility:hidden;transition:opacity .25s,transform .25s;box-shadow:0 10px 30px rgba(0,0,0,.35);text-align:left}
  .pin .tip::after{content:'';position:absolute;left:50%;top:100%;margin-left:-6px;border:6px solid transparent;border-top-color:rgba(255,255,255,.96)}
  .pin[aria-expanded=true] .tip{opacity:1;visibility:visible;transform:translate(-50%,0)}
  .pin.flip .tip{bottom:auto;top:calc(100% - 4px);transform:translate(-50%,-6px)}
  .pin.flip .tip::after{top:auto;bottom:100%;border-top-color:transparent;border-bottom-color:rgba(255,255,255,.96)}
  .pin.flip[aria-expanded=true] .tip{transform:translate(-50%,0)}
  .pin.left .tip{left:0;transform:translate(0,6px)}.pin.left .tip::after{left:22px}.pin.left[aria-expanded=true] .tip{transform:translate(0,0)}
  .pin.right .tip{left:auto;right:0;transform:translate(0,6px)}.pin.right .tip::after{left:auto;right:16px}.pin.right[aria-expanded=true] .tip{transform:translate(0,0)}
  .tour .textstop{position:absolute;inset:0;display:grid;place-items:center;padding:90px var(--gut) 190px;overflow:auto;background:radial-gradient(ellipse at 50% 30%,#2a2219,#000 70%)}
  .tour .textstop>div{max-width:620px}
  .tour .textstop h3{color:#fff;font-size:30px;margin-bottom:14px}
  .tour .textstop ul{list-style:none;display:grid;gap:10px;font-size:15px;color:#e9e2d6}
  .tour .textstop li{padding-left:18px;position:relative}
  .tour .textstop li::before{content:'';position:absolute;left:0;top:11px;width:7px;height:7px;border-radius:50%;background:var(--tan)}
  .tour .textstop p{margin:16px 0 0;font-size:13px;color:#bdb3a4}
  .tour .hud{position:absolute;left:0;right:0;z-index:5;padding:0 max(var(--gut),env(safe-area-inset-right)) 0 max(var(--gut),env(safe-area-inset-left))}
  .tour .hud{pointer-events:none}
  .tour .hud button,.tour .hud .chips{pointer-events:auto}
  .tour .hud.t{top:calc(12px + env(safe-area-inset-top));display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
  .tour .hud.t .name b{display:block;font:400 24px/1.1 var(--serif)}
  .tour .hud.t .name small{display:block;font-size:12px;letter-spacing:.1em;text-transform:uppercase;opacity:.8;margin-top:4px}
  .tour .x{width:44px;height:44px;border-radius:50%;border:1px solid rgba(255,255,255,.6);background:rgba(0,0,0,.35);color:#fff;font:300 30px/1 var(--sans);cursor:pointer;flex:0 0 44px}
  .tour .hud.b{bottom:calc(10px + env(safe-area-inset-bottom));display:grid;gap:10px}
  .tour .cap{font-size:14px;line-height:1.5;color:#efe9df;max-width:720px;text-shadow:0 1px 6px rgba(0,0,0,.6)}
  .tour .chips{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding:2px 0;margin:0}
  .tour .chips::-webkit-scrollbar{display:none}
  .chip{flex:0 0 auto;min-height:44px;padding:10px 16px;border-radius:999px;border:1px solid rgba(255,255,255,.55);background:rgba(0,0,0,.35);color:#fff;font:500 13px/1.2 var(--sans);cursor:pointer;white-space:nowrap}
  .chip[aria-current=true]{background:#fff;color:var(--ink);border-color:#fff}
  .tour .ctl{display:flex;align-items:center;gap:10px}
  .tour .ctl button{min-width:44px;min-height:44px;border-radius:999px;border:1px solid rgba(255,255,255,.55);background:rgba(0,0,0,.35);color:#fff;font:400 20px/1 var(--sans);cursor:pointer;padding:0 14px;display:inline-flex;align-items:center;gap:8px}
  .tour .ctl button[aria-pressed=true]{background:#fff;color:var(--ink)}
  .tour .ctl .auto{font-size:13px;font-weight:500}
  .tour .ctl .cnt{margin-left:auto;font-size:13px;opacity:.85;font-variant-numeric:tabular-nums}
  .tour .bar{height:3px;background:rgba(255,255,255,.25);border-radius:2px;overflow:hidden}
  .tour .bar i{display:block;height:100%;background:#fff;width:0;transition:width .5s}
  .tour .hon{font-size:11px;letter-spacing:.06em;text-transform:uppercase;opacity:.7}
  @media (max-width:640px){.tour .hud.t .name b{font-size:20px}.tour .cap{font-size:13px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}}

  /* gallery */
  .gal{padding:30px 0 50px}
  .grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:22px;perspective:1200px}
  .grid3 img{width:100%;aspect-ratio:3/2;object-fit:cover}
  @media (max-width:760px){.grid3{grid-template-columns:repeat(2,minmax(0,1fr))}}

  /* ratings */
  .ocene{padding:50px 0}
  .scores{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px;margin:26px 0 36px;perspective:1200px}
  .score{border:1px solid var(--line);padding:26px 28px;display:flex;gap:22px;align-items:center;background:#fff}
  .score b{font:400 56px/1 var(--serif);color:var(--brown2)}
  .score small{display:block;font:600 13px/1.4 var(--sans);text-transform:uppercase;letter-spacing:.04em}
  .score span{font-size:14px;color:var(--text)}
  @media (max-width:640px){.scores{grid-template-columns:minmax(0,1fr)}}
  .cards{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 80px)/3);gap:40px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:4px 0 10px}
  .cards::-webkit-scrollbar{display:none}
  .cards>div{scroll-snap-align:start}
  .cards h3{margin-bottom:6px}
  .cards p{font-size:15px;line-height:1.75;margin-bottom:8px}
  .cards .meta{font-size:14px;color:var(--text)}
  .cards .meta i{font-style:normal;color:var(--mute)}
  .cards .more{font-size:15px;color:var(--ink);text-decoration:underline;text-underline-offset:3px}
  .arrows{display:flex;gap:14px;margin-top:18px;font-size:26px;line-height:1}
  .arrows button{background:none;border:0;cursor:pointer;color:var(--ink);font:400 26px/1 var(--sans);padding:0 4px;min-width:44px;min-height:44px}
  @media (max-width:900px){.cards{grid-auto-columns:calc((100% - 40px)/2)}}
  @media (max-width:600px){.cards{grid-auto-columns:88%}}
  .tr{font-size:12px;color:var(--mute);font-style:italic}

  /* beige CTA */
  .cta{max-width:var(--max);margin:40px auto;background:var(--beige);padding:34px 42px;display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:28px;align-items:center}
  .cta svg{width:42px;height:42px;stroke:var(--brown2);fill:none;stroke-width:1.5}
  .cta h3{font-size:34px;color:var(--brown2);margin-bottom:6px}
  .cta p{margin:0;color:var(--mute);font-size:15px}
  @media (max-width:820px){.cta{grid-template-columns:minmax(0,1fr);margin:30px var(--gut);text-align:center;justify-items:center}}

  /* reservation */
  .res{padding:30px 0 50px}
  .widget{margin-top:22px;border:1px dashed var(--tan);background:var(--beige);min-height:360px;display:grid;place-items:center;text-align:center;padding:30px;color:var(--text)}
  .widget b{display:block;font:400 24px/1.2 var(--serif);color:var(--brown2);margin-bottom:8px}
  .res .acts{display:flex;flex-wrap:wrap;gap:12px;margin-top:20px}
  .kv{margin-top:26px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;font-size:15px}
  .kv b{display:block;font:400 20px/1.3 var(--serif);margin-bottom:4px}
  @media (max-width:760px){.kv{grid-template-columns:minmax(0,1fr)}}

  /* live location map */
  .lok{padding:40px 0 20px;position:relative;overflow:hidden}
  .mapbox{position:relative;margin-top:22px;aspect-ratio:16/10;background:linear-gradient(180deg,#f7f3ec,#efe7da);border:1px solid #e6dccb;overflow:hidden;border-radius:4px}
  @media (max-width:640px){.mapbox{aspect-ratio:4/5}}
  .mapbox svg{position:absolute;inset:0;width:100%;height:100%}
  .mapbox .band{position:absolute;left:0;right:0;top:0;height:24%;background:repeating-linear-gradient(135deg,rgba(154,123,78,.05) 0 8px,transparent 8px 16px);border-bottom:1px dashed rgba(154,123,78,.5)}
  .mapbox .bandlb{position:absolute;left:12px;top:8px;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--brown2)}
  .route{fill:none;stroke:var(--brown2);stroke-width:2.5;stroke-linecap:round;stroke-dasharray:6 8}
  html.js .in .route{animation:march 1.6s linear infinite}
  @keyframes march{to{stroke-dashoffset:-28}}
  .route.draw{stroke-dasharray:400;stroke-dashoffset:400;stroke:rgba(111,87,54,.3);animation:none}
  html.js .in .route.draw{animation:draw 2.4s ease-out forwards}
  @keyframes draw{to{stroke-dashoffset:0}}
  .lake{fill:#cfe0e6;stroke:#9cbcc7;stroke-width:1.5}
  .town rect{fill:#e6dccb;stroke:#d3c6ae;stroke-width:1}
  .mlab{position:absolute;transform:translate(-50%,-50%);display:grid;justify-items:center;text-align:center;pointer-events:none;font-size:11px;color:var(--text);line-height:1.3}
  .mlab b{font:600 12px/1.3 var(--sans);color:var(--ink)}
  .home{fill:var(--brown2)}
  .mpin{position:absolute;transform:translate(-50%,-50%);min-width:44px;min-height:44px;border:0;background:none;cursor:pointer;display:grid;justify-items:center;align-content:center;gap:2px;padding:0;font:inherit}
  .mpin i{width:16px;height:16px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);background:var(--brown2);border:2px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.3);transition:transform .25s}
  .mpin.lake i{background:#3d7d92}
  .mpin.home i{background:var(--ink);width:20px;height:20px}
  .mpin[aria-pressed=true] i{transform:rotate(-45deg) scale(1.3)}
  .mpin b{font:600 11px/1.2 var(--sans);color:var(--ink);background:rgba(255,255,255,.85);padding:2px 6px;border-radius:3px;white-space:nowrap;max-width:140px;overflow:hidden;text-overflow:ellipsis}
  .mpin small{font:400 10px/1.2 var(--sans);color:var(--text);background:rgba(255,255,255,.85);padding:1px 5px;border-radius:3px;white-space:nowrap}
  .mpin.dist i{animation:bob 3s ease-in-out infinite}
  .mpin.dist:nth-child(odd) i{animation-delay:1.5s}
  @keyframes bob{50%{transform:rotate(-45deg) translate(3px,3px)}}
  .mpanel{margin-top:16px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px;align-items:center;border:1px solid var(--line);padding:18px 22px;background:#fff}
  .mpanel h3{font-size:22px;margin-bottom:2px}
  .mpanel p{margin:0;font-size:15px;color:var(--text)}
  .mpanel [hidden]{display:none}
  @media (max-width:640px){.mpanel{grid-template-columns:minmax(0,1fr)}.mapbox .band{height:28%}.mpin.dist b{white-space:normal;max-width:84px;text-align:center;font-size:10px}.mlab{font-size:10px}.mlab b{font-size:11px}}
  .mnote{font-size:13px;color:var(--mute);margin:10px 0 0}
  .chips{margin:18px 0 0;font-size:15px;color:var(--text)}
  .chips span{display:inline-block;margin:0 14px 6px 0}
  .chips>span::before{content:'·';margin-right:8px;color:var(--brown2)}

  /* contact form */
  .kontakt{padding:40px 0 60px}
  .kontakt h2{line-height:1.2}
  .form{margin-top:22px;display:grid;gap:22px}
  .form label{display:grid;gap:4px;font:600 13px/1.3 var(--sans)}
  .form input,.form textarea{width:100%;border:0;border-bottom:1px solid #bdbdbd;padding:12px 0;font:400 16px/1.4 var(--sans);color:var(--text);outline:none;background:transparent;border-radius:0}
  .form input:focus,.form textarea:focus{border-color:var(--brown2)}
  .form textarea{min-height:110px;resize:vertical}
  .two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:22px}
  .hint{font-size:13px;color:var(--mute);margin:0}
  @media (max-width:560px){.two{grid-template-columns:minmax(0,1fr)}}

  /* footer */
  footer{padding:50px 0 0}
  .fgrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:40px}
  .fgrid h2{font-size:28px;margin-bottom:10px}
  .fgrid ul{list-style:none}
  .fgrid li{padding:3px 0;font-size:16px}
  .fgrid li a{display:inline-block;padding:9px 0;min-height:44px}
  .koc a{display:inline-block;padding:12px 0}
  .fgrid .ico{display:flex;gap:10px;align-items:flex-start}
  .fgrid .ico svg{width:16px;height:16px;flex:0 0 16px;margin-top:7px;fill:var(--ink)}
  .tag{font:400 28px/1.2 var(--serif)}
  .slot{margin-top:14px;border:1px dashed #bbb;padding:16px;font-size:13px;color:var(--mute)}
  .slot b{display:block;color:var(--ink);font-weight:600;margin-bottom:4px}
  .koc{margin-top:10px;font-size:15px}
  .koc a{text-decoration:underline;text-underline-offset:3px;color:var(--brown2)}
  .copy{border-top:1px solid #ccc;margin-top:40px;padding:20px 0;font-size:15px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px}
  @media (max-width:900px){.fgrid{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}
  @media (max-width:560px){.fgrid{grid-template-columns:minmax(0,1fr)}}

  /* mobile QA */
  [id]{scroll-margin-top:16px}
  @media (max-width:760px){
    .top .bar a,.top .bar button{min-height:44px;min-width:44px;display:inline-flex;align-items:center;justify-content:center;padding:4px 10px}
    .overlay a{min-height:44px;display:inline-flex;align-items:center;padding:4px 12px}
    .overlay{font-size:26px;gap:12px}
    .top .bar .r{gap:4px}
    .burger{width:44px;height:44px;padding:0;justify-items:end}
    .burger i{width:40px}
    .book label,.book .cap{font-size:15px}
    .book .d small{font-size:12px}
    .book .d{flex-basis:100%;padding:6px 0 2px}
    .book .d input{height:44px;padding:0}
    .book .field{min-height:48px}
    .book input{height:46px}
    .form label{font-size:15px}
    .hint{font-size:15px}
    .arrows button{min-width:44px;min-height:44px}
    .cards .more{display:inline-block;padding:12px 16px 12px 0;min-width:44px}
    .koc a{display:inline-block;padding:12px 0}
    .fgrid li a{display:inline-block;padding:9px 0}
    .over{font-size:15px}
    .hero{min-height:560px}
    .hero h2{font-size:34px}
    .scrollhint{display:none}
  }
  html.js .rv{opacity:0;transform:translateY(18px);transition:opacity .8s ease,transform .8s ease}
  html.js .rv.in{opacity:1;transform:none}
  html.js .rv.d1{transition-delay:.12s}html.js .rv.d2{transition-delay:.24s}html.js .rv.d3{transition-delay:.36s}
  @media (prefers-reduced-motion:reduce){
    html.js .rv{opacity:1;transform:none;transition:none}
    .hero .bg img,.scrollhint::after,.pin::before,.mpin.dist i,.room img{animation:none!important;transition:none!important}
    .tilt{transform:none!important;transition:none}
    .tour .stop{transition:none}
    .tour .stop.on .ph{animation:none!important}
    @media (orientation:portrait){.tour .ph{left:50%;top:50%;height:auto;width:100%;transform:translate(-50%,-50%)!important}}
    html.js .in .route{animation:none;stroke-dashoffset:0}
    .layer{display:none}
  }
</style>
</head>
<body>

<header class="top">
  <div class="bar">
    <div class="l" role="group" aria-label="Jezik / Language">
      <button type="button" data-set="sl" aria-pressed="true">sl</button>
      <button type="button" data-set="en" aria-pressed="false">en</button>
    </div>
    <div class="r">
      <a href="#kontakt"><Fragment set:html={t('Kontakt','Contact')} /></a>
      <a href="#bentral"><Fragment set:html={t('Rezerviraj zdaj','Book now')} /></a>
    </div>
  </div>
  <div class="brandrow">
    <a class="brand" href="#top" aria-label="Strato Apartment">
      <svg viewBox="0 0 58 40" aria-hidden="true"><path d="M8 24 L29 6 L50 24"/><path d="M14 24 V36 H44 V24"/><path d="M4 39 C10 35 16 35 22 39 C28 35 34 35 40 39 C46 35 52 35 56 39"/></svg>
      <b>Strato Apartment</b>
      <small>Kočevje · Slovenija</small>
    </a>
    <button class="burger" type="button" aria-label="Meni / Menu" id="burger"><i></i><i></i><i></i></button>
  </div>
</header>
<nav class="overlay" id="overlay" aria-label="Meni">
  <button class="x" type="button" id="close" aria-label="Zapri / Close">×</button>
  <a href="#sprehod"><Fragment set:html={t('Virtualni sprehod','Virtual walk-through')} /></a>
  <a href="#apartma"><Fragment set:html={t('Apartma','Apartment')} /></a>
  <a href="#galerija"><Fragment set:html={t('Galerija','Gallery')} /></a>
  <a href="#ocene"><Fragment set:html={t('Ocene gostov','Guest reviews')} /></a>
  <a href="#lokacija"><Fragment set:html={t('Lokacija v živo','Live location')} /></a>
  <a href="#bentral"><Fragment set:html={t('Rezervacija','Reservation')} /></a>
  <a href="#kontakt"><Fragment set:html={t('Kontakt','Contact')} /></a>
</nav>

<main id="top">

<section class="hero">
  <div class="bg" id="herobg"><img src={A+'strato-02.jpg'} alt="Dnevna soba apartmaja Strato, Kočevje" fetchpriority="high" /></div>
  <div class="hc" id="heroc">
    <small><Fragment set:html={t('Kočevje · 270 m od jezera','Kočevje · 270 m from the lake')} /></small>
    <h2><Fragment set:html={t('Kjer se mir sreča z jezerom','Where calm meets the lake')} /></h2>
    <div class="acts">
      <button class="btn brown" type="button" data-tour="living"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7l6-3 4 2 6-3v14l-6 3-4-2-6 3z"/><path d="M10 4v14M14 6v14"/></svg><Fragment set:html={t('Začni virtualni sprehod','Start the virtual walk-through')} /></button>
      <a class="btn ghost" href="#bentral"><Fragment set:html={t('Preveri razpoložljivost','Check availability')} /></a>
    </div>
  </div>
  <span class="scrollhint" aria-hidden="true"></span>
</section>

<div class="bookwrap">
  <form class="book" id="quick" action="#bentral" method="get" autocomplete="off">
    <div class="bk"><span class="cap"><Fragment set:html={t('Datumi','Dates')} /></span><span class="field"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg><label class="d"><small><Fragment set:html={t('Prihod','Check-in')} /></small><input type="date" name="od" /></label><label class="d"><small><Fragment set:html={t('Odhod','Check-out')} /></small><input type="date" name="do" /></label></span></div>
    <label><Fragment set:html={t('Gostje','Guests')} /><span class="field"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/></svg><input type="number" name="gostje" min="1" max="5" placeholder="1–5" /></span></label>
    <button class="btn brown" type="submit"><Fragment set:html={t('Preveri razpoložljivost','Check availability')} /></button>
  </form>
</div>

<section id="sprehod" class="walk">
  <span class="layer" data-depth="1.2" style="width:420px;height:420px;right:-160px;top:40px" aria-hidden="true"></span>
  <span class="layer" data-depth="-0.8" style="width:300px;height:300px;left:-120px;bottom:0" aria-hidden="true"></span>
  <div class="wrap">
    <div class="lead">
      <div>
        <span class="over rv"><Fragment set:html={t('Virtualni sprehod','Virtual walk-through')} /></span>
        <h2 class="rv"><Fragment set:html={t('Sprehodite se skozi apartma, preden pridete','Walk through the apartment before you arrive')} /></h2>
        <p class="rv d1"><Fragment set:html={t('Soba za sobo, s počasnim premikom kamere in oznakami, ki jih tapnete. Deluje na telefonu s potegom prsta.','Room by room, with a slow camera move and pins you tap. Works on your phone with a swipe.')} /></p>
      </div>
      <button class="btn brown rv d2" type="button" data-tour="living"><Fragment set:html={t('Odpri celozaslonski sprehod','Open the full-screen walk')} /></button>
    </div>
    <div class="roomgrid rv">
      {rooms.map((r, i) => (
        <button class={'room tilt'} type="button" data-tour={r.id}>
          <img src={A+'strato-'+r.cover+'.jpg'} alt="" loading="lazy" />
          <span class="lb"><small>{String(i+1).padStart(2,'0')}</small><b><Fragment set:html={t(r.sl,r.en)} /></b><span><Fragment set:html={t('Vstopi','Enter')} /> →</span></span>
        </button>
      ))}
    </div>
    <p class="honest rv"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><Fragment set:html={t('Sprehod iz fotografij apartmaja. Kopalnica, terasa in vrt bodo dodani, ko gostitelja pošljeta fotografije.','Walk-through made from apartment photos. Bathroom, terrace and garden will be added once the hosts send photos.')} /></p>
    <div class="video rv">
      <div><span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 4l14 8-14 8z"/></svg></span><b><Fragment set:html={t('Tu bo video ali 360° ogled (pošljeta gostitelja)','The video or 360° tour will be here (to be supplied by the hosts)')} /></b><p><Fragment set:html={t('Prostor je pripravljen za pravi videoposnetek apartmaja ali 360° posnetek, ko ga Barbara in Rok posnameta.','The slot is ready for a real video of the apartment or a 360° capture once Barbara and Rok record one.')} /></p><small><Fragment set:html={t('Do takrat je zgoraj sprehod iz fotografij.','Until then, the photo walk-through above is live.')} /></small></div>
    </div>
  </div>
</section>

<section id="apartma" class="story">
  <div class="wrap">
    <span class="over rv"><Fragment set:html={t('Naša zgodba na kratko','Our story in short')} /></span>
    <h1 class="rv">Strato Apartment</h1>
    <p class="rv" style="margin-top:40px"><Fragment set:html={t(
      `Strato Apartment je družinsko voden apartma v Kočevju, ki ga gostita Barbara in Rok. ${f.renovated}, meri ${f.size} in sprejme ${f.guests}. ${f.lake}, ${f.center}.`,
      `Strato Apartment is a family-run apartment in Kočevje hosted by Barbara and Rok. ${e.renovated}, it measures ${e.size} and sleeps ${e.guests}. ${e.lake}, ${e.center}.`)} /></p>
    <p class="rv"><Fragment set:html={t(`${f.bedrooms}. ${f.parking}. ${f.languages}.`,`${e.bedrooms}. ${e.parking}. ${e.languages}.`)} /></p>

    <span class="over rv" style="text-transform:none;margin-top:30px"><Fragment set:html={t('Apartma','Apartment')} /></span>
    <div class="figure rv"><img class="tilt" src={A+'strato-05.jpg'} alt="Dnevna soba s TV, kitaro in klavirjem" loading="lazy" /></div>
    <div class="block rv">
      <h2><Fragment set:html={t('Dnevna soba in spalnici','Living room and bedrooms')} /></h2>
      <p><Fragment set:html={t(`${f.living}. ${f.bedroom1}. ${f.bedroom2}.`,`${e.living}. ${e.bedroom1}. ${e.bedroom2}.`)} /></p>
