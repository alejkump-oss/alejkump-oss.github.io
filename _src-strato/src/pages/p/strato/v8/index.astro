<!-- full-screen walk-through, made only from the hosts' photos -->
<div class="tour" id="tour" role="dialog" aria-modal="true" aria-label="Virtualni sprehod / Virtual walk-through" hidden>
  <div class="stage" id="stage">
    {stops.map((s, i) => (
      <div class="stop" data-room={s.room} data-i={i}>
        <div class={'ph '+(i%2 ? 'b' : 'a')}>
