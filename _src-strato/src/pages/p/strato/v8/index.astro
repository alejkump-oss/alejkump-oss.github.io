<div id="detail" role="dialog" aria-modal="true" aria-label="Prostor"><div class="dband"></div><div class="dwrap" id="dwrap"></div></div>
<div id="fly" aria-hidden="true"></div>

<script is:inline set:html={payload} />
<script is:inline>
const P=window.STRATO,A=P.A,S=P.S;
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const H=document.documentElement;
const lang=()=>H.lang==='en'?'en':'sl';
const L=(sl,en)=>`<span data-lang="sl">${sl}</span><span data-lang="en">${en}</span>`;
const T=(o,k)=>o[k+lang()];
const s=k=>S[lang()][k];
const RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
const FINE=matchMedia('(hover: hover) and (pointer: fine)').matches;
const CALI='<svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>';
const USRI='<svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c1-3.8 3.7-6 7-6s6 2.2 7 6"/></svg>';
const PEACH="linear-gradient(135deg,#fff5ee 0%,#f3cdb8 100%)";

/* ---------- slides ---------- */
const slidesEl=$('#slides');
const words=lines=>lines.map(line=>line.split(' ').map(w=>`<span class="w"><span>${w}</span></span>`).join(' ')).join('<br>');
P.slides.forEach((sd,i)=>{
  const d=document.createElement('div');d.className='slide';d.dataset.i=i;
  d.innerHTML=`<div class="ph" style="background-image:url('${A}strato-${sd.img}.jpg');background-position:${sd.pos}"></div><div class="tint"></div><div class="ttl" data-lang="sl">${words(sd.tsl)}</div><div class="ttl" data-lang="en">${words(sd.ten)}</div>`;
  d.style.zIndex=i===0?2:0;d.style.visibility=i===0?'visible':'hidden';
  slidesEl.appendChild(d);
});
const CLOUD=`url('${A}strato-clouds.webp')`;
$$('#clouds div').forEach(d=>d.style.backgroundImage=CLOUD);
$('#topcloud').style.backgroundImage=CLOUD;
const rail=$('#rail');
const thumbs=P.thumbs.map((k,i)=>{const t=document.createElement('button');t.type='button';t.className='thumb';t.style.backgroundImage=`url('${A}strato-${k}.jpg')`;t.dataset.i=i;const n=P.slides.findIndex(x=>x.thumb===i);t.setAttribute('aria-label',P.slides[n].hsl+' / '+P.slides[n].hen);rail.appendChild(t);return t;});
let cur=0,busy=false,timer=null;
const slideEls=$$('.slide');

function layoutRail(active,instant){
  const W=innerWidth,Hh=Math.max(innerHeight,680);
  const B=Math.max(96,Math.min(W*.113,190)),Sz=Math.max(46,Math.min(W*.054,92)),gap=Math.max(8,W*.009);
  const cx=W*.855,top=74+Hh*.085;
  let y=top;const ti=P.slides[active].thumb;
  thumbs.forEach((t,i)=>{
    const d=i===ti?B:Sz;
    if(instant)t.style.transition='none';
    t.style.width=t.style.height=d+'px';t.style.left=(cx-d/2)+'px';t.style.top=y+'px';
    t.classList.toggle('on',i===ti);
    if(i===ti)t._c=y+d/2;
    y+=d+gap;
    if(instant){t.offsetWidth;t.style.transition='';}
  });
  const cy=thumbs[ti]._c;
  [['#r1',B*.5+W*.05],['#r2',B*.5+W*.108]].forEach(([q,r])=>{const el=$(q);el.style.width=el.style.height=2*r+'px';el.style.left=(cx-r)+'px';el.style.top=(cy-r)+'px';});
  const cn=$('#conn'),Ln=Math.max(40,W*.047);cn.style.width=Ln+'px';cn.style.left=(cx-B/2-Ln-W*.008)+'px';cn.style.top=(cy-1.5)+'px';
  const cap=$('#cap'),bh=Math.max(84,W*.065);cap.querySelector('.bar').style.height=bh+'px';
  cap.style.left='auto';cap.style.right=(W-(cx-B/2-Ln-W*.008)+Math.max(16,W*.014))+'px';cap.style.top=(cy-bh*.42)+'px';
}
function setCap(i,show){
  const cap=$('#cap'),sd=P.slides[i];
  const fill=()=>{cap.querySelector('h3').textContent=T(sd,'h');cap.querySelector('p').textContent=T(sd,'p');};
  if(RM){fill();cap.classList.add('show');cap.querySelector('.bar').style.transform='';$('#conn').style.transform='';return;}
  cap.classList.remove('show');cap.querySelector('.bar').style.transform='scaleY(0)';$('#conn').style.transform='scaleX(0)';
  setTimeout(()=>{fill();$('#conn').style.transform='scaleX(1)';cap.querySelector('.bar').style.transform='scaleY(1)';setTimeout(()=>cap.classList.add('show'),180);},show===undefined?650:show);
}
const ease=t=>t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2;
function mask(el,p){const a=(p*135-35).toFixed(2),b=(p*135).toFixed(2);const m=`linear-gradient(to left,#000 ${a}%,rgba(0,0,0,.6) ${((+a+ +b)/2).toFixed(2)}%,transparent ${b}%)`;el.style.webkitMaskImage=m;el.style.maskImage=m;}
function go(n){
  if(busy||n===cur)return;busy=true;clearTimeout(timer);
  const Ae=slideEls[cur],Be=slideEls[n];
  slideEls.forEach((x,i)=>{if(i!==cur&&i!==n){x.style.visibility='hidden';x.style.zIndex=0;}});
  Be.querySelectorAll('.w>span').forEach(x=>{x.style.transition='none';x.style.transform='none';});
  layoutRail(n);setCap(n,RM?0:undefined);
  if(RM){Be.style.visibility='visible';Be.style.zIndex=2;Ae.style.visibility='hidden';Ae.style.zIndex=0;cur=n;busy=false;return;}
  Be.style.visibility='visible';Be.style.zIndex=3;Ae.style.zIndex=2;mask(Be,0);
  const pa=Ae.querySelector('.ph'),pb=Be.querySelector('.ph'),mist=$('#mist');
  const t0=performance.now(),D=1250;
  (function f(){const t=Math.min(1,(performance.now()-t0)/D),e=ease(t);
    mask(Be,e);pb.style.transform=`scale(${1.12-.08*e}) translateX(${(1-e)*2}%)`;pa.style.transform=`scale(${1.04+.05*e}) translateX(${-e*2}%)`;
    const edge=100-(e*135-17.5);mist.style.left=edge+'%';mist.style.opacity=(Math.sin(Math.PI*t)*.95).toFixed(3);
    if(t<1)requestAnimationFrame(f);else{Be.style.webkitMaskImage=Be.style.maskImage='none';Ae.style.visibility='hidden';Ae.style.zIndex=0;Be.style.zIndex=2;mist.style.opacity=0;cur=n;busy=false;kb();sched();}
  })();
}
let px=0,py=0;
function kb(){ // slow Ken Burns on the live slide
  if(RM)return;
  const ph=slideEls[cur].querySelector('.ph'),t0=performance.now(),me=cur;
  (function f(){if(cur!==me||busy||document.hidden)return;const t=(performance.now()-t0)/1000;ph.style.transform=`scale(${1.04+Math.min(t,12)*.0035}) translate(${px*-.6}%,${py*-.5}%)`;requestAnimationFrame(f);})();
}
function sched(){clearTimeout(timer);if(RM)return;timer=setTimeout(()=>go((cur+1)%P.slides.length),5200);}
thumbs.forEach(t=>t.addEventListener('click',()=>{const n=P.slides.findIndex(x=>x.thumb===+t.dataset.i);go(n);}));
document.addEventListener('visibilitychange',()=>{if(document.hidden)clearTimeout(timer);else{kb();sched();}});
if(FINE&&!RM)addEventListener('pointermove',e=>{px=(e.clientX/innerWidth-.5)*2;py=(e.clientY/innerHeight-.5)*2;});

/* ---------- intro ---------- */
layoutRail(0,true);
setTimeout(()=>{
  const hero=$('#hero');
  slideEls[0].querySelectorAll('.w>span').forEach((x,i)=>{x.style.transition=`transform 1.15s var(--out) ${i*.09}s`;});
  thumbs.forEach((t,i)=>{t.style.transition+=`, transform .9s var(--out) ${.35+i*.14}s`;});
  hero.classList.remove('intro');
  setTimeout(()=>thumbs.forEach(t=>t.style.transition=''),1600);
  setCap(0,RM?0:900);kb();sched();
},RM?0:250);

/* ---------- scroll ---------- */
const nav=$('#nav');
function onScroll(){
  const y=scrollY,Hh=innerHeight;
  nav.classList.toggle('solid',y>Hh*.3||$('#detail').classList.contains('open'));
  if(RM)return;
  slidesEl.style.transform=`translateY(${y*.42}px)`;
  $('#clouds').style.transform=`translateY(${-y*.38}px) scale(${1+y/Hh*.35})`;
  const tc=$('#topcloud');tc.style.opacity=Math.min(1,y/(Hh*.45)).toFixed(3);tc.style.transform=`scaleY(-1) translateY(${-y*.25}px)`;
  rail.style.transform=`translateY(${y*.2}px)`;rail.style.opacity=Math.max(0,1-y/(Hh*.5));
}
addEventListener('scroll',onScroll,{passive:true});
addEventListener('resize',()=>{layoutRail(cur,true);onScroll();});
onScroll();

/* ---------- mobile menu ---------- */
const burger=$('#burger');
burger.addEventListener('click',()=>{const on=nav.classList.toggle('menu');burger.setAttribute('aria-expanded',on);});
$('#links').addEventListener('click',()=>{nav.classList.remove('menu');burger.setAttribute('aria-expanded','false');});

/* ---------- cards ---------- */
function cardHTML(r,i){
  const chip=`<span class="price">${L(r.csl,r.cen)}</span>`;
  if(!r.img.length)return `<button type="button" class="card txt" data-i="${i}">${chip}<div class="tmeta"><h4>${L(r.sl,r.en)}</h4><p>${L(r.tsl,r.ten)}</p><small>${L(r.ssl,r.sen)}</small></div></button>`;
  return `<button type="button" class="card" data-i="${i}"><div class="im" style="background-image:url('${A}strato-${r.img[0]}.jpg')"></div><div class="sh2"></div>${chip}<div class="meta"><h4>${L(r.sl,r.en)}</h4><div class="loc">${L(r.ssl,r.sen)}</div></div></button>`;
}
$('#g1').innerHTML=P.rooms.slice(0,4).map((r,i)=>cardHTML(r,i)).join('');
$('#g2').innerHTML=P.rooms.slice(4).map((r,i)=>cardHTML(r,i+4)).join('');
const io=new IntersectionObserver(es=>es.forEach(en=>{if(en.isIntersecting){const c=en.target;if(c.classList.contains('card'))c.style.transitionDelay=(+c.dataset.i%4)*.09+'s';c.classList.add('in');setTimeout(()=>c.style.transitionDelay='',1300);io.unobserve(c);}}),{threshold:.12});
$$('.stays .card,.rv').forEach(c=>{if(RM)c.classList.add('in');else io.observe(c);});
document.addEventListener('click',e=>{
  const c=e.target.closest('.card');if(c)openDetail(+c.dataset.i,c);
});

/* ---------- booking bar popovers ---------- */
const today=new Date();today.setHours(0,0,0,0);
let ci=null,co=null,picking='in',month=new Date(today.getFullYear(),today.getMonth(),1),ga=2,gc=0;
const MAXG=5;
const fmt=d=>lang()==='sl'?`${d.getDate()}. ${s('months')[d.getMonth()].slice(0,3)}`:`${d.getDate()} ${s('months')[d.getMonth()].slice(0,3)}`;
const fmtFull=d=>lang()==='sl'?`${d.getDate()}. ${d.getMonth()+1}. ${d.getFullYear()}`:`${d.getDate()} ${s('months')[d.getMonth()]} ${d.getFullYear()}`;
const gWord=n=>lang()==='sl'?(n===1?'gost':n===2?'gosta':n<5?'gostje':'gostov'):(n===1?'guest':'guests');
const gLabel=()=>`${ga+gc} ${gWord(ga+gc)}`;
function drawCal(){
  const y=month.getFullYear(),m=month.getMonth(),first=(new Date(y,m,1).getDay()+6)%7,days=new Date(y,m+1,0).getDate();
  let h=`<h4><button type="button" data-mv="-1" aria-label="‹">‹</button><span>${s('months')[m]} ${y}</span><button type="button" data-mv="1" aria-label="›">›</button></h4><div class="g">`+s('days').map(d=>`<span>${d}</span>`).join('')+'<i></i>'.repeat(first);
  for(let d=1;d<=days;d++){const dt=new Date(y,m,d),t=+dt;let c='';if(ci&&t===+ci)c='s';else if(co&&t===+co)c='e';else if(ci&&co&&t>+ci&&t<+co)c='in';if(t<+today||(picking==='out'&&ci&&t<=+ci))c+=' x';h+=`<button type="button" class="${c}" data-d="${t}">${d}</button>`;}
  $('#pCal').innerHTML=h+`</div><button type="button" class="pdone">${L('V redu','Done')}</button>`;
}
function refreshLabels(){
  $('#ciL').textContent=ci?fmt(ci):s('addDate');$('#coL').textContent=co?fmt(co):s('addDate');$('#gL').textContent=gLabel();
  $('#ga').textContent=ga;$('#gc').textContent=gc;
  $$('[data-g]').forEach(b=>{const inc=+b.dataset.d>0;b.disabled=inc?(ga+gc>=MAXG):(b.dataset.g==='a'?ga<=1:gc<=0);});
  updatePick();
}
function updatePick(){
  const el=$('#pick'),m=$('#mailbtn');if(!el)return;
  if(!ci){el.textContent='';m.href='mailto:'+P.email;return;}
  const when=fmt(ci)+(co?' – '+fmt(co):''),whenFull=fmtFull(ci)+(co?' – '+fmtFull(co):'');
  el.textContent=`${s('pick')}: ${when} · ${gLabel()}`;
  m.href='mailto:'+P.email+'?subject='+encodeURIComponent(`${s('subj')}: ${whenFull}, ${gLabel()}`);
}
function closePops(){$$('.pop').forEach(p=>p.classList.remove('open'));}
function selFld(p){$$('.fld').forEach(x=>x.classList.toggle('act',x.dataset.p===p));if(p==='out')$('#pCal').style.left='46%';}
$('#search').addEventListener('click',e=>{
  const mv=e.target.closest('[data-mv]');if(mv){e.stopPropagation();month.setMonth(month.getMonth()+ +mv.dataset.mv);drawCal();return;}
  const dd=e.target.closest('[data-d]');
  if(dd&&e.target.closest('#pCal')){e.stopPropagation();const d=new Date(+dd.dataset.d);
    if(picking==='in'){ci=d;co=null;picking='out';refreshLabels();selFld('out');}
    else{co=d;picking='in';refreshLabels();drawCal();setTimeout(()=>{closePops();selFld('gst');$('#pGst').classList.add('open');},320);return;}
    drawCal();return;}
  const gb=e.target.closest('[data-g]');
  if(gb){e.stopPropagation();const dlt=+gb.dataset.d;if(gb.dataset.g==='a')ga=Math.min(MAXG-gc,Math.max(1,ga+dlt));else gc=Math.min(MAXG-ga,Math.max(0,gc+dlt));refreshLabels();return;}
  if(e.target.closest('.pdone')){e.stopPropagation();closePops();return;}
  if(e.target.closest('.pop'))return;
  if(e.target.closest('#send')){closePops();updatePick();goTo('bentral');return;}
  const fl=e.target.closest('.fld:not(.static)');if(!fl)return;
  const p=fl.dataset.p,wasOpen=fl.classList.contains('act')&&$$('.pop.open').length;
  closePops();selFld(p);if(wasOpen)return;
  if(p==='in'||p==='out'){picking=p==='out'&&ci?'out':'in';drawCal();$('#pCal').style.left=p==='in'?'30%':'46%';$('#pCal').classList.add('open');}
  if(p==='gst')$('#pGst').classList.add('open');
});
document.addEventListener('click',e=>{if(!e.target.closest('#search'))closePops();});
function goTo(id){const el=document.getElementById(id);if(!el)return;el.scrollIntoView({behavior:RM?'auto':'smooth',block:'start'});}

/* ---------- detail page with shared-element flight ---------- */
let dOpen=false,dIdx=0,dFrom=null;
function renderDetail(i){
  const r=P.rooms[i],others=P.rooms.filter((_,j)=>j!==i);
  const main=r.img.length?`<div class="im" style="background-image:url('${A}strato-${r.img[0]}.jpg')"></div>`:`<div class="nop"><b>${L(r.sl,r.en)}</b><span>${L(r.ssl,r.sen)}</span></div>`;
  const th=r.img.length>1?`<div class="thumbs3">${r.img.slice(1,4).map(k=>`<button type="button" data-src="${A}strato-${k}.jpg" style="background-image:url('${A}strato-${k}.jpg')" aria-label="${r.sl}"></button>`).join('')}</div>`:'';
  $('#dwrap').innerHTML=`<div class="crumb"><a href="#stays" data-home>${L('Domov','Home')}</a><i>›</i><span>${L('Prostori apartmaja','The apartment')}</span><i>›</i><span>${L(r.sl,r.en)}</span><button type="button" class="dclose" id="dclose" aria-label="${s('close')}">✕</button></div>
  <div class="dgrid"><div><div class="dmain">${main}</div>${th}</div>
   <div class="dinfo"><h1>${L(r.sl,r.en)}</h1><div class="host">${L('Gostitelja','Hosts')} <b>${P.hosts}</b> · Strato Apartment, Kočevje</div>
    <h2>${L('O prostoru','About this space')}</h2><p class="ab">${L(r.tsl,r.ten)}</p>
    <div class="book"><div class="pr">${L('Bivanje','Your stay')}</div>
     <div class="bx"><div>${CALI}<span><small>${L('Prijava','Check-in')}</small>${L('od 15:00','from 15:00')}</span></div>
      <div>${CALI}<span><small>${L('Odjava','Check-out')}</small>${L('do 11:00','until 11:00')}</span></div>
      <div class="gsel"><span style="display:flex;gap:12px">${USRI}<span><small>${L('Gostje','Guests')}</small>${L(P.guests.sl,P.guests.en)}</span></span><span class="nop2">${L('Hišni ljubljenčki niso dovoljeni','Pets are not allowed')}</span></div></div>
     <button type="button" class="bnow" data-goto="bentral">${L('Preveri termin','Check availability')}</button></div>
    <div class="rate"><div><div class="num">${L(P.bk.split(' / ')[0],P.bkEn.split(' / ')[0])}<sup>/10</sup></div><small>Booking.com · ${L(P.bk.split('(')[1].replace(')','')+' · Izjemno',P.bkEn.split('(')[1].replace(')','')+' · Exceptional')}</small></div>
     <div><div class="num">${L(P.ab.split(' / ')[0],P.abEn.split(' / ')[0])}<sup>/5</sup></div><small>Airbnb · ${L(P.ab.split('(')[1].replace(')','')+' · Izbira gostov',P.abEn.split('(')[1].replace(')','')+' · Guest favourite')}</small></div>
     <button type="button" class="rnow" data-goto="reviews">${L('Mnenja gostov','Guest reviews')}</button></div>
    <div class="am"><h2>${L('Oprema','Amenities')}</h2><div class="amg">${P.am.map(a=>`<div><svg viewBox="0 0 24 24">${a.i}</svg>${L(a.sl,a.en)}</div>`).join('')}</div></div></div></div>
  <div class="sim"><div class="sh"><h2 style="font-family:'Gilda Display',Georgia,serif;font-weight:400;font-size:clamp(24px,2.2vw,32px)">${L('Drugi prostori','Other spaces')}</h2></div><div class="grid">${others.map(x=>cardHTML(x,P.rooms.indexOf(x))).join('')}</div></div>`;
}
function openDetail(i,cardEl){
  const r=P.rooms[i];dIdx=i;dFrom=cardEl;renderDetail(i);
  const D=$('#detail');D.scrollTop=0;
  const from=cardEl.getBoundingClientRect();
  D.classList.add('open');dOpen=true;nav.classList.add('solid');nav.classList.remove('menu');H.style.overflow='hidden';
  const main=D.querySelector('.dmain');
  if(!RM){
    main.style.visibility='hidden';
    requestAnimationFrame(()=>{
      const to=main.getBoundingClientRect(),fly=$('#fly');
      fly.style.backgroundImage=r.img.length?`url('${A}strato-${r.img[0]}.jpg')`:PEACH;fly.style.display='block';
      const t0=performance.now(),Dur=900;
      (function f(){const t=Math.min(1,(performance.now()-t0)/Dur),e=ease(t);
        fly.style.left=from.left+(to.left-from.left)*e+'px';fly.style.top=from.top+(to.top-from.top)*e+'px';
        fly.style.width=from.width+(to.width-from.width)*e+'px';fly.style.height=from.height+(to.height-from.height)*e+'px';fly.style.borderRadius=(12-2*e)+'px';
        if(t<1)requestAnimationFrame(f);else{main.style.visibility='visible';fly.style.display='none';}
      })();
    });
    $$('#detail .thumbs3 button,#detail .dinfo>*,#detail .sim').forEach((el,k)=>{el.animate([{transform:'translateY(26px)',opacity:0},{transform:'none',opacity:1}],{duration:900,delay:250+k*70,easing:'cubic-bezier(.16,1,.3,1)',fill:'backwards'});});
  }
  setTimeout(()=>{const b=$('#dclose');if(b)b.focus({preventScroll:true});},50);
}
function closeDetail(){const D=$('#detail');if(!dOpen)return;D.classList.remove('open');dOpen=false;H.style.overflow='';onScroll();if(dFrom&&document.contains(dFrom))dFrom.focus({preventScroll:true});}
document.addEventListener('click',e=>{
  if(e.target.closest('#dclose')){closeDetail();return;}
  const th=e.target.closest('#detail .thumbs3 button');
  if(th){const im=$('#detail .dmain .im');if(im){im.style.backgroundImage=`url('${th.dataset.src}')`;if(!RM)im.animate([{opacity:.35},{opacity:1}],{duration:500,easing:'ease-out'});}return;}
  const g=e.target.closest('[data-goto]');
  if(g){closeDetail();setTimeout(()=>goTo(g.dataset.goto),30);return;}
  const hm=e.target.closest('[data-home]');
  if(hm){e.preventDefault();if(dOpen){closeDetail();if(hm.getAttribute('href')==='#stays')setTimeout(()=>goTo('stays'),30);}else scrollTo({top:0,behavior:RM?'auto':'smooth'});return;}
  const lk=e.target.closest('.links a,.pillbtn');
  if(lk&&dOpen){closeDetail();}
});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(dOpen)closeDetail();else closePops();}});

/* ---------- language ---------- */
function setLang(l){
  H.lang=l;document.title=S[l].title;
  try{localStorage.setItem('strato-lang',l)}catch(e){}
  $$('.lang button').forEach(b=>b.classList.toggle('on',b.dataset.set===l));
  setCap(cur,0);refreshLabels();
  if($('#pCal').classList.contains('open'))drawCal();
  if(dOpen)renderDetail(dIdx);
}
$$('[data-set]').forEach(b=>b.addEventListener('click',()=>setLang(b.dataset.set)));
setLang(lang());

/* ---------- contact form -> mailto ---------- */
$('#cform').addEventListener('submit',e=>{
  e.preventDefault();
  const n=$('#cn').value.trim(),m=$('#ce').value.trim(),msg=$('#cm').value.trim();
  const body=(lang()==='sl'?`Pozdravljeni,\n\n${msg}\n\nLep pozdrav,\n${n}\n${m}`:`Hello,\n\n${msg}\n\nKind regards,\n${n}\n${m}`);
  location.href='mailto:'+P.email+'?subject='+encodeURIComponent(s('subj')+(n?' – '+n:''))+'&body='+encodeURIComponent(body);
});

/* ---------- cursor (fine pointers only) ---------- */
if(FINE){
  const C=$('#cur');
  addEventListener('pointermove',e=>{C.style.transform=`translate(${e.clientX}px,${e.clientY}px)`;C.classList.toggle('hov',!!e.target.closest('button,a,.card,.thumb,.fld'));});
  addEventListener('pointerdown',()=>C.classList.add('down'));
  addEventListener('pointerup',()=>C.classList.remove('down'));
}
</script>
</body>
</html>
