      <span class="cnt" id="tcnt"></span>
    </div>
    <span class="hon"><Fragment set:html={t('Sprehod iz fotografij apartmaja','Walk-through made from apartment photos')} /></span>
  </div>
</div>

<script is:inline define:vars={{ roomsJson: rooms.map((r) => ({ id:r.id, sl:r.sl, en:r.en, fsl:r.fact[0], fen:r.fact[1] })), firstStop }}>
(function(){
  var h=document.documentElement;
  var rm=matchMedia('(prefers-reduced-motion: reduce)').matches;
  var hoverable=matchMedia('(hover: hover) and (pointer: fine)').matches;
  var titles={sl:'Strato Apartment · Kočevje',en:'Strato Apartment · Kočevje, Slovenia'};
  function lang(){return h.lang==='en'?'en':'sl'}
  function setLang(l){h.lang=l;document.title=titles[l];try{localStorage.setItem('strato-lang',l)}catch(e){}
    document.querySelectorAll('[data-set]').forEach(function(b){b.setAttribute('aria-pressed',String(b.dataset.set===l))});
    document.querySelectorAll('#tour img[data-alt-sl]').forEach(function(im){im.alt=im.getAttribute('data-alt-'+l)||''});
    if(tourOpen) paintHud();}
  document.querySelectorAll('[data-set]').forEach(function(b){b.addEventListener('click',function(){setLang(b.dataset.set)})});

  /* menu */
  var ov=document.getElementById('overlay');
  document.getElementById('burger').addEventListener('click',function(){ov.classList.add('open')});
  document.getElementById('close').addEventListener('click',function(){ov.classList.remove('open')});
  ov.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(){ov.classList.remove('open')})});

  /* scroll reveals */
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}})},{threshold:.08,rootMargin:'0px 0px -5% 0px'});
    document.querySelectorAll('.rv').forEach(function(el){var r=el.getBoundingClientRect();if(r.top<innerHeight&&r.bottom>0){el.classList.add('in')}else{io.observe(el)}});
  } else { document.querySelectorAll('.rv').forEach(function(el){el.classList.add('in')}); }
  addEventListener('scroll',function(){document.querySelectorAll('.rv:not(.in)').forEach(function(el){if(el.getBoundingClientRect().top<innerHeight)el.classList.add('in')})},{passive:true});

  /* card scrollers */
  document.querySelectorAll('.arrows button').forEach(function(b){b.addEventListener('click',function(){
    var s=document.getElementById(b.dataset.for); var c=s.firstElementChild; var w=c.getBoundingClientRect().width+40;
    s.scrollBy({left:w*Number(b.dataset.dir),behavior:rm?'auto':'smooth'});
  })});

  /* depth: parallax hero, floating layers, tilt cards (pointer on desktop, scroll-driven on touch) */
  var heroBg=document.getElementById('herobg'), heroC=document.getElementById('heroc');
  var layers=[].slice.call(document.querySelectorAll('.layer'));
  var tilts=[].slice.call(document.querySelectorAll('.tilt'));
  if(!rm){
    if(hoverable){
      tilts.forEach(function(c){
        c.addEventListener('pointermove',function(ev){var r=c.getBoundingClientRect();var x=(ev.clientX-r.left)/r.width-.5,y=(ev.clientY-r.top)/r.height-.5;
          c.style.setProperty('--rx',(-y*7).toFixed(2)+'deg');c.style.setProperty('--ry',(x*9).toFixed(2)+'deg');c.style.setProperty('--gx',(x*100+50).toFixed(1)+'%');c.style.setProperty('--gy',(y*100+50).toFixed(1)+'%')});
        c.addEventListener('pointerleave',function(){c.style.setProperty('--rx','0deg');c.style.setProperty('--ry','0deg')});
      });
    }
    var ticking=false;
    function frame(){ticking=false;var vh=innerHeight,y=scrollY;
      if(y<vh*1.2){heroBg.style.transform='translate3d(0,'+(y*.35).toFixed(1)+'px,0)';heroC.style.transform='translate3d(0,'+(y*.18).toFixed(1)+'px,0)';heroC.style.opacity=Math.max(0,1-y/(vh*.75)).toFixed(3);}
      layers.forEach(function(l){var r=l.parentElement.getBoundingClientRect();if(r.bottom<0||r.top>vh)return;var p=(r.top+r.height/2-vh/2)/vh;l.style.transform='translate3d(0,'+(p*-80*(parseFloat(l.dataset.depth)||1)).toFixed(1)+'px,0)'});
      if(!hoverable){tilts.forEach(function(c){var r=c.getBoundingClientRect();if(r.bottom<0||r.top>vh)return;var p=(r.top+r.height/2-vh/2)/(vh/2);c.style.setProperty('--rx',(p*5).toFixed(2)+'deg');c.style.setProperty('--gy',(50+p*40).toFixed(1)+'%')})}
    }
    addEventListener('scroll',function(){if(!ticking){ticking=true;requestAnimationFrame(frame)}},{passive:true});
    addEventListener('resize',function(){if(!ticking){ticking=true;requestAnimationFrame(frame)}});
    frame();
  }

  /* live location: pins + panel */
  var mpins=[].slice.call(document.querySelectorAll('.mpin')), panel=document.getElementById('mpanel');
  mpins.forEach(function(b){b.addEventListener('click',function(){
    mpins.forEach(function(o){o.setAttribute('aria-pressed',String(o===b))});
    panel.querySelectorAll('[data-p]').forEach(function(p){p.hidden=p.dataset.p!==b.dataset.i});
  })});

  /* walk-through */
  var tour=document.getElementById('tour'), stage=document.getElementById('stage');
  var stops=[].slice.call(stage.querySelectorAll('.stop')), chips=[].slice.call(tour.querySelectorAll('.chip'));
  var tname=document.getElementById('tname'), tsub=document.getElementById('tsub'), tcap=document.getElementById('tcap'), tbar=document.getElementById('tbar'), tcnt=document.getElementById('tcnt'), tauto=document.getElementById('tauto'), tico=document.getElementById('tauto-ico');
  var idx=0, auto=!rm, timer=null, tourOpen=false, lastFocus=null, DUR=rm?7000:10000;
  var roomsById={}; roomsJson.forEach(function(r){roomsById[r.id]=r});
  var L={sl:{rest:'Ostalo',restsub:'brez fotografije',view:'pogled',of:'od'},en:{rest:'More',restsub:'no photo yet',view:'view',of:'of'}};
  function closeTips(){stage.querySelectorAll('.pin[aria-expanded=true]').forEach(function(p){p.setAttribute('aria-expanded','false')})}
  function paintHud(){var l=lang(), s=stops[idx], room=s.dataset.room, r=roomsById[room];
    var sameRoom=stops.filter(function(x){return x.dataset.room===room}), k=sameRoom.indexOf(s)+1;
    tname.textContent=r?r[l]:L[l].rest;
    tsub.textContent=r?(L[l].view+' '+k+' '+L[l].of+' '+sameRoom.length):L[l].restsub;
    tcap.textContent=r?(l==='en'?r.fen:r.fsl):'';
    tcnt.textContent=(idx+1)+' / '+stops.length;
    tauto.setAttribute('aria-pressed',String(auto)); tico.textContent=auto?'❚❚':'▶';
    chips.forEach(function(c){c.setAttribute('aria-current',String(c.dataset.room===room))});
    tbar.style.width=((idx+1)/stops.length*100).toFixed(1)+'%';}
  function restart(){clearTimeout(timer);if(auto&&tourOpen)timer=setTimeout(function(){show(idx+1)},DUR)}
  function show(i){idx=(i+stops.length)%stops.length;closeTips();stage.scrollLeft=0;stage.scrollTop=0;stops.forEach(function(s){s.scrollLeft=0;s.scrollTop=0});
    stops.forEach(function(s,k){s.classList.toggle('on',k===idx)});
    var nxt=stops[(idx+1)%stops.length].querySelector('img'); if(nxt) nxt.loading='eager';
    paintHud(); restart();}
  function openTour(room){lastFocus=document.activeElement;tourOpen=true;tour.hidden=false;tour.classList.add('open');h.classList.add('lock');
    stops.forEach(function(s){var im=s.querySelector('img');if(im)im.loading='eager'});
    setLang(lang()); show(firstStop[room]!==undefined?firstStop[room]:0); document.getElementById('tclose').focus();}
  function closeTour(){tourOpen=false;clearTimeout(timer);tour.classList.remove('open');tour.hidden=true;h.classList.remove('lock');stops.forEach(function(s){s.classList.remove('on')});if(lastFocus&&lastFocus.focus)lastFocus.focus();}
  document.querySelectorAll('[data-tour]').forEach(function(b){b.addEventListener('click',function(){openTour(b.dataset.tour)})});
  document.getElementById('tclose').addEventListener('click',closeTour);
  document.getElementById('tprev').addEventListener('click',function(){show(idx-1)});
  document.getElementById('tnext').addEventListener('click',function(){show(idx+1)});
  tauto.addEventListener('click',function(){auto=!auto;paintHud();restart()});
  chips.forEach(function(c){c.addEventListener('click',function(){var r=c.dataset.room; show(r==='rest'?stops.length-1:firstStop[r])})});
  stage.addEventListener('click',function(ev){var p=ev.target.closest('.pin');if(!p)return;var open=p.getAttribute('aria-expanded')==='true';closeTips();p.setAttribute('aria-expanded',String(!open));clearTimeout(timer);if(open)restart();});
  document.addEventListener('keydown',function(ev){if(!tourOpen)return;if(ev.key==='Escape')closeTour();else if(ev.key==='ArrowRight')show(idx+1);else if(ev.key==='ArrowLeft')show(idx-1);});
  var sx=0,sy=0,st=0;
  stage.addEventListener('touchstart',function(ev){var t0=ev.changedTouches[0];sx=t0.clientX;sy=t0.clientY;st=Date.now()},{passive:true});
  stage.addEventListener('touchend',function(ev){var t0=ev.changedTouches[0],dx=t0.clientX-sx,dy=t0.clientY-sy;if(Date.now()-st<800&&Math.abs(dx)>40&&Math.abs(dx)>Math.abs(dy)*1.3){show(dx<0?idx+1:idx-1)}},{passive:true});
  document.addEventListener('visibilitychange',function(){if(document.hidden)clearTimeout(timer);else restart()});

  setLang(lang());

  /* forms: quick bar pre-fills the enquiry; the enquiry opens the visitor's e-mail app (no backend) */
  var quick=document.getElementById('quick'), cf=document.getElementById('cf');
  quick.addEventListener('submit',function(ev){ev.preventDefault();
    if(quick.od.value) cf.od.value=quick.od.value; if(quick.do.value) cf.do.value=quick.do.value;
    if(quick.gostje.value && !cf.sporocilo.value) cf.sporocilo.value=(lang()==='en'?'Guests: ':'Število gostov: ')+quick.gostje.value;
    document.getElementById('bentral').scrollIntoView({behavior:rm?'auto':'smooth'});
  });
  cf.addEventListener('submit',function(ev){ev.preventDefault();
    var en=lang()==='en';
    var body=(en?'Name: ':'Ime: ')+cf.ime.value+'\n'+(en?'E-mail: ':'E-pošta: ')+cf.email.value+'\n'+(en?'Dates: ':'Termin: ')+(cf.od.value||'–')+' – '+(cf.do.value||'–')+'\n\n'+cf.sporocilo.value;
    location.href='mailto:'+'strato.apartment@gmail.com'+'?subject='+encodeURIComponent(en?'Enquiry – Strato Apartment':'Povpraševanje – Strato Apartment')+'&body='+encodeURIComponent(body);
  });
})();
</script>
</body>
</html>
