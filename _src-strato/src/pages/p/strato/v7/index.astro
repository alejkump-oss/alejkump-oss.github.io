---
// Strato Apartment – predlog 7
// Same layout language as cirus-apartments.com/sl/domov: fixed dusty-pink left sidebar (menu on top, contact icons
// and language at the bottom), split hero (logo panel + photo), thin serif centred intro with vertical pink stripes,
// dark #3a3a3a bands holding framed cards, photos with an offset pink block, double-bordered italic buttons,
// "MNENJA" testimonial slider, pink footer strip. Own code, own text, own monogram, Strato photos only.
import d from '../../../../data/strato.json';
const f = d.facts_sl, e = d.facts_en;
const A = '../assets/';
const t = (sl, en) => `<span data-lang="sl">${sl}</span><span data-lang="en">${en}</span>`;
const todo = d.things_to_do_from_hosts_folio_guide;
const reviews = d.ratings.reviews;
const split = (s) => s.split(' / ');
const spaces = [
  { img: '05', sl: 'Dnevna soba', en: 'Living room', ssl: 'Klavir, kitara, TV', sen: 'Piano, guitar, TV', tsl: f.living, ten: e.living },
  { img: '09', sl: 'Kuhinja', en: 'Kitchen', ssl: 'Popolnoma opremljena', sen: 'Fully equipped', tsl: f.kitchen, ten: e.kitchen },
  { img: '11', sl: 'Velika spalnica', en: 'Large bedroom', ssl: 'Zakonska postelja', sen: 'King-size bed', tsl: f.bedroom1, ten: e.bedroom1 },
  { img: '14', sl: 'Manjša spalnica', en: 'Second bedroom', ssl: 'TV in Xbox', sen: 'TV and Xbox', tsl: f.bedroom2, ten: e.bedroom2 },
];
const gallery = ['01','03','04','06','07','08','10','12','15'];
---
<!doctype html>
<html lang="sl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>Strato Apartment · Kočevje</title>
<meta name="description" content="Strato Apartment, Kočevje – apartma za do 5 oseb, 270 m od Kočevskega jezera. Predlog spletne strani (AK agencija)." />
<meta name="robots" content="noindex" />
<script is:inline>
  (function(){var h=document.documentElement;h.classList.add('js');try{var l=localStorage.getItem('strato-lang');if(l==='en'||l==='sl')h.lang=l;}catch(e){}})();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Tinos:ital,wght@0,400;0,700;1,400&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet" />
<style is:global>
  :root{
    --bg:#f0f0f0; --ink:#3a3a3a; --text:#4a4a4a; --dark:#3a3a3a; --pink:#c3a291; --pink2:#dcc9bf; --white:#f7f7f7;
    --serif:'Tinos','Times New Roman',Times,serif; --sans:'Open Sans',Arial,sans-serif;
    --side:60px; --max:1240px; --gut:clamp(16px,4vw,70px);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  body{background:var(--bg) repeating-linear-gradient(135deg,rgba(255,255,255,.35) 0 2px,transparent 2px 6px);color:var(--text);font-family:var(--serif);font-size:16px;line-height:1.8;overflow-x:hidden;padding-left:var(--side)}
  img{display:block;max-width:100%;height:auto}
  a{color:inherit;text-decoration:none}
  html[lang=sl] [data-lang=en]{display:none!important}
  html[lang=en] [data-lang=sl]{display:none!important}
  h1,h2,h3{font-family:var(--serif);font-weight:400;color:var(--ink);line-height:1.1;letter-spacing:.01em}
  h1{font-size:43px;text-transform:uppercase}
  h2{font-size:29px;text-transform:uppercase}
  h2 em,h1 em{display:block;font-style:italic;text-transform:none;font-size:.72em;margin-top:2px}
  .center{text-align:center}
  .wrap{max-width:var(--max);margin:0 auto;padding:0 var(--gut)}
  .btn{display:inline-block;background:var(--dark);color:#fff;font:italic 17px/1 var(--serif);padding:13px 40px;min-height:44px;border:3px double var(--pink);border-radius:1px;cursor:pointer;transition:background .25s,color .25s}
  .btn:hover{background:var(--pink);color:var(--dark)}
  .btn.light{background:transparent;color:var(--ink);border-color:var(--pink)}
  .btn.light:hover{background:var(--dark);color:#fff}

  /* sidebar */
  .side{position:fixed;left:0;top:0;bottom:0;width:var(--side);background:var(--pink2);border-right:1px solid #cdb9ad;z-index:50;display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:calc(26px + env(safe-area-inset-top)) 0 calc(18px + env(safe-area-inset-bottom)) env(safe-area-inset-left)}
  .side .burger{background:none;border:0;cursor:pointer;display:flex;gap:4px;padding:6px;min-width:44px;min-height:44px;align-items:center;justify-content:center}
  .side .burger i{display:block;width:3px;height:20px;background:var(--ink)}
  .side .icons{display:flex;flex-direction:column;gap:8px;align-items:center}
  .side .icons a{display:grid;place-items:center;width:44px;height:44px}
  .side .icons svg{width:20px;height:20px;stroke:var(--ink);fill:none;stroke-width:1.7}
  .side .lang{display:flex;flex-direction:column;gap:6px;margin-top:26px}
  .side .lang button{border:1px solid var(--ink);background:none;font:600 10px/1 var(--sans);letter-spacing:.08em;padding:9px 0;width:34px;color:var(--ink);cursor:pointer}
  .side .lang button[aria-pressed=true]{background:var(--ink);color:#fff}
  .overlay{position:fixed;inset:0;background:rgba(58,58,58,.97);color:#fff;z-index:60;display:none;flex-direction:column;align-items:center;justify-content:center;gap:24px;font:400 30px/1.2 var(--serif);text-transform:uppercase;letter-spacing:.06em}
  .overlay.open{display:flex}
  .overlay a:hover{color:var(--pink2)}
  .overlay .x{position:absolute;top:18px;right:28px;background:none;border:0;color:#fff;font:300 46px/1 var(--sans);cursor:pointer}
  @media (max-width:760px){
    body{padding-left:0;padding-top:calc(56px + env(safe-area-inset-top))}
    .side{top:0;bottom:auto;width:100%;height:calc(56px + env(safe-area-inset-top));flex-direction:row;padding:env(safe-area-inset-top) max(8px,env(safe-area-inset-right)) 0 max(8px,env(safe-area-inset-left));border-right:0;border-bottom:1px solid #cdb9ad}
    .side .icons{flex-direction:row;gap:0}
    .side .lang{flex-direction:row;margin:0 0 0 6px;gap:4px}
    .side .lang button{width:44px;padding:0;height:44px}
    .side .icons a{width:44px;height:44px}
  }

  /* hero split */
  .hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);min-height:100svh}
  .hero .panel{display:grid;place-items:center;padding:40px}
  .mono{text-align:center;display:grid;justify-items:center;gap:8px}
  .mono .glyph{position:relative;width:180px;height:180px;display:grid;place-items:center}
  .mono .glyph::before{content:'';position:absolute;left:62px;top:0;bottom:0;width:70px;background:repeating-linear-gradient(90deg,var(--pink2) 0 14px,transparent 14px 28px)}
  .mono .glyph b{position:relative;font:400 190px/1 var(--serif);color:var(--ink);letter-spacing:-.04em}
  .mono .name{font:400 34px/1 var(--serif);letter-spacing:.08em;color:var(--ink);margin-top:8px}
  .mono .sub{font:400 14px/1 var(--serif);letter-spacing:.32em;text-transform:uppercase;color:var(--ink)}
  .hero .photo{position:relative;min-height:420px}
  .hero .photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  @media (max-width:860px){.hero{grid-template-columns:minmax(0,1fr);min-height:0}.hero .panel{padding:60px 20px}.mono .glyph{width:140px;height:140px}.mono .glyph b{font-size:140px}.mono .glyph::before{left:48px;width:54px}}

  /* intro with stripes */
  .intro{position:relative;padding:150px 0 120px;overflow:hidden}
  .stripes{position:absolute;right:0;top:0;bottom:0;width:320px;background:repeating-linear-gradient(90deg,transparent 0 36px,var(--pink2) 36px 68px);opacity:.9;pointer-events:none}
  .intro .txt{max-width:840px;margin:0 auto;text-align:center;position:relative;padding:0 var(--gut)}
  .intro p{margin:8px 0 26px;font-size:16px;line-height:1.85}
  @media (max-width:1100px){.stripes{width:160px}}
  @media (max-width:760px){.stripes{display:none}.intro{padding:80px 0 60px}}

  /* dark band with framed box */
  .band{background:var(--dark);padding:70px 0;border:1px solid #777;border-left:0;border-right:0;margin:0 0 0 0}
  .band .box{max-width:var(--max);margin:0 auto;padding:0 var(--gut)}
  .frame{border:1px solid #9a9a9a;display:grid;grid-template-columns:30% minmax(0,1fr)}
  .card{background:var(--white);outline:1px solid var(--pink);outline-offset:-4px;padding:60px 40px;display:grid;place-items:center;text-align:center;min-height:490px}
  .card h2{margin-bottom:8px}
  .card p{font-size:15px;line-height:1.75}
  .pattern{position:relative;background:#5a5a5a repeating-linear-gradient(45deg,rgba(255,255,255,.06) 0 3px,transparent 3px 8px);display:grid;place-items:center;color:rgba(255,255,255,.14);font:400 clamp(60px,10vw,170px)/1 var(--serif);text-transform:uppercase;letter-spacing:.08em;overflow:hidden}
  .pattern.photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.9}
  @media (max-width:860px){.frame{grid-template-columns:minmax(0,1fr)}.card{min-height:0;padding:40px 24px}.pattern{min-height:220px}}

  /* apartments blocks */
  .apts{padding:100px 0}
  .apt{max-width:var(--max);margin:0 auto 120px;padding:0 var(--gut);position:relative}
  .apt .inner{border:1px solid #9a9a9a;background:var(--dark);display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);min-height:450px;position:relative}
  .apt .ph{position:relative;padding:12px 0 12px 46px}
  .apt .ph::before{content:'';position:absolute;left:0;top:-20px;bottom:-24px;width:70%;background:var(--pink2);z-index:0}
  .apt .ph img{position:relative;z-index:1;width:100%;height:100%;object-fit:cover;min-height:300px;border:1px solid #999}
  .apt .tx{color:#fff;display:grid;place-items:center;text-align:center;padding:50px 50px}
  .apt .tx h2{color:#fff}
  .apt .tx p{font-size:15px;line-height:1.75;margin:10px 0 28px;color:#fff}
  .apt.rev .inner{grid-template-columns:minmax(0,1fr) minmax(0,1.2fr)}
  .apt.rev .ph{order:2;padding:12px 46px 12px 0}
  .apt.rev .ph::before{left:auto;right:0;top:-28px;bottom:-20px}
  @media (max-width:860px){.apt .inner,.apt.rev .inner{grid-template-columns:minmax(0,1fr)}.apt .ph,.apt.rev .ph{order:0;padding:12px 24px}.apt .ph::before,.apt.rev .ph::before{left:0;right:auto;width:60%}.apt{margin-bottom:70px}.apt .tx{padding:30px 22px 40px}}

  /* gallery */
  .gal{padding:0 0 100px}
  .gal .grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:40px}
  .gal img{width:100%;aspect-ratio:3/2;object-fit:cover;border:1px solid #bbb;outline:3px double var(--pink2);outline-offset:-10px}
  @media (max-width:760px){.gal .grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}

  /* reviews slider */
  .mnenja{position:relative;padding:120px 0 80px;overflow:hidden}
  .mnenja .txt{max-width:900px;margin:0 auto;text-align:center;padding:0 var(--gut);position:relative}
  .mnenja h2{font-size:43px}
  .mnenja h2 em{font-size:.6em}
  .scores{display:flex;justify-content:center;gap:40px;flex-wrap:wrap;margin:26px 0 40px;font-size:15px}
  .scores b{font:400 42px/1 var(--serif);color:var(--ink);display:block}
  .scores span{display:block;font:600 12px/1.4 var(--sans);letter-spacing:.1em;text-transform:uppercase;color:var(--pink)}
  .slider{position:relative}
  .slide{display:none}
  .slide.on{display:block;animation:fade .6s ease}
  @keyframes fade{from{opacity:0}to{opacity:1}}
  .slide q{quotes:none;display:block;font-style:italic;font-size:19px;line-height:1.6;color:var(--pink);max-width:720px;margin:0 auto 26px}
  .slide .n{font-size:16px;color:var(--ink)}
  .slide .c{font-size:14px;color:var(--pink)}
  .slide .tr{font-size:12px;color:#888;font-style:italic}
  .dots{display:flex;justify-content:center;gap:10px;margin-top:30px}
  .dots{gap:0}
  .dots button{width:44px;height:44px;border:0;background:none;cursor:pointer;padding:0;display:grid;place-items:center}
  .dots button::after{content:"";width:10px;height:10px;border-radius:50%;border:1px solid var(--pink)}
  .dots button[aria-current=true]::after{background:var(--pink)}
  .sarrow{position:absolute;top:50%;transform:translateY(-50%);background:none;border:0;font:400 34px/1 var(--serif);color:var(--pink);cursor:pointer;padding:10px;min-width:44px;min-height:44px}
  .sarrow.l{left:0}.sarrow.r{right:0}
  @media (prefers-reduced-motion:reduce){.slide.on{animation:none}}

  /* reservation band */
  .res .frame{grid-template-columns:minmax(0,1fr) 34%}
  .res .widget{background:var(--white);display:grid;place-items:center;text-align:center;padding:40px;min-height:420px;color:var(--text);border:1px dashed var(--pink);margin:14px}
  .res .widget b{display:block;font:400 28px/1.2 var(--serif);text-transform:uppercase;color:var(--ink);margin-bottom:8px}
  .res .card{min-height:0}
  .res .card .btn{margin:6px 0}
  .res .card p{margin-top:16px}
  @media (max-width:860px){.res .frame{grid-template-columns:minmax(0,1fr)}}

  /* contact */
  .kontakt{padding:100px 0}
  .kontakt .grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:60px;margin-top:40px}
  .form{display:grid;gap:18px}
  .form label{display:grid;gap:4px;font:600 12px/1.4 var(--sans);letter-spacing:.08em;text-transform:uppercase;color:var(--ink)}
  .form input,.form textarea{width:100%;border:1px solid #bbb;background:#fff;padding:12px 14px;font:400 16px/1.4 var(--serif);color:var(--ink);outline:none;border-radius:0}
  .form input:focus,.form textarea:focus{border-color:var(--pink)}
  .form textarea{min-height:120px;resize:vertical}
  .two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18px}
  .hint{font-size:13px;color:#777}
  .info p{margin-bottom:10px}
  .info .slot{border:1px dashed var(--pink);padding:18px;margin-top:20px;font-size:14px;color:#777}
  .info .slot b{display:block;color:var(--ink);text-transform:uppercase;margin-bottom:4px}
  .info a.u{text-decoration:underline;text-underline-offset:3px;color:var(--pink)}
  @media (max-width:860px){.kontakt .grid{grid-template-columns:minmax(0,1fr)}}
  @media (max-width:520px){.two{grid-template-columns:minmax(0,1fr)}}

  /* footer */
  footer{background:var(--dark);padding:70px 0 20px;border-top:1px solid #777;color:#fff}
  footer .strip{max-width:var(--max);margin:0 auto;padding:0 var(--gut)}
  footer .pinkbar{background:var(--pink2);display:grid;grid-template-columns:minmax(0,1fr) 206px;min-height:100px;border:1px solid #c9b5a9}
  footer .icons{display:flex;justify-content:center;align-items:center;gap:60px}
  footer .icons a{display:grid;place-items:center;width:44px;height:44px}
  footer .icons svg{width:28px;height:28px;stroke:#111;fill:none;stroke-width:1.5}
  footer .kocbox{background:var(--white);display:grid;place-items:center;text-align:center;padding:12px;color:var(--ink);font:400 15px/1.3 var(--serif)}
  footer .kocbox a{text-decoration:underline;text-underline-offset:3px}
  footer .copy{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;padding:18px 0 0;font:italic 13px/1.4 var(--serif);color:#fff}
  @media (max-width:760px){footer .pinkbar{grid-template-columns:minmax(0,1fr)}footer .icons{gap:34px;padding:18px 0}}

  /* mobile QA */
  [id]{scroll-margin-top:16px}
  @media (max-width:760px){
    [id]{scroll-margin-top:calc(68px + env(safe-area-inset-top))}
    .form label{font-size:15px}
    .hint,.slide .c,.slide .tr,.info .slot,.scores{font-size:15px}
    .info a.u,footer .kocbox a{display:inline-block;padding:11px 0}
    .card p,.apt .tx p{font-size:15px}
    .mono .glyph b{font-size:120px}
    .mono .glyph{width:120px;height:120px}
    .mono .glyph::before{left:40px;width:46px}
    .sarrow.l{left:-10px}.sarrow.r{right:-10px}
    .slide q{padding:0 30px}
  }
  html.js .rv{opacity:0;transform:translateY(16px);transition:opacity .7s ease,transform .7s ease}
  html.js .rv.in{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){html.js .rv{opacity:1;transform:none;transition:none}}
</style>
</head>
<body>

<aside class="side">
  <button class="burger" type="button" id="burger" aria-label="Meni / Menu"><i></i><i></i><i></i></button>
  <div class="icons">
    <a href={d.phone_href} aria-label="Telefon"><svg viewBox="0 0 24 24"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.6 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .6 3.6 1 1 0 0 1-.25 1z"/></svg></a>
    <a href={'mailto:'+d.email} aria-label="E-pošta"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 7l9 6 9-6"/></svg></a>
    <a href={d.maps} target="_blank" rel="noopener" aria-label="Zemljevid"><svg viewBox="0 0 24 24"><path d="M12 21s7-7 7-12a7 7 0 1 0-14 0c0 5 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/></svg></a>
    <div class="lang" role="group" aria-label="Jezik / Language">
      <button type="button" data-set="sl" aria-pressed="true">SL</button>
      <button type="button" data-set="en" aria-pressed="false">EN</button>
    </div>
  </div>
</aside>
<nav class="overlay" id="overlay" aria-label="Meni">
  <button class="x" type="button" id="close" aria-label="Zapri / Close">×</button>
  <a href="#top"><Fragment set:html={t('Domov','Home')} /></a>
  <a href="#apartma"><Fragment set:html={t('Apartma','Apartment')} /></a>
  <a href="#galerija"><Fragment set:html={t('Galerija','Gallery')} /></a>
  <a href="#okolica"><Fragment set:html={t('Okolica','Things to do')} /></a>
  <a href="#mnenja"><Fragment set:html={t('Mnenja','Reviews')} /></a>
  <a href="#bentral"><Fragment set:html={t('Rezervacija','Reservation')} /></a>
  <a href="#kontakt"><Fragment set:html={t('Kontakt','Contact')} /></a>
</nav>

<main id="top">

<section class="hero">
  <div class="panel">
    <div class="mono">
      <div class="glyph" aria-hidden="true"><b>S</b></div>
      <div class="name">STRATO</div>
      <div class="sub">Apartment</div>
      <a class="btn light" href="#bentral" style="margin-top:34px"><Fragment set:html={t('Preveri razpoložljivost','Check availability')} /></a>
    </div>
  </div>
  <div class="photo"><img src={A+'strato-02.jpg'} alt="Dnevna soba apartmaja Strato, Kočevje" fetchpriority="high" /></div>
</section>

<section class="intro" id="apartma">
  <div class="stripes" aria-hidden="true"></div>
  <div class="txt rv">
    <h1>Strato Apartment</h1>
    <p><Fragment set:html={t(
      `Strato Apartment se nahaja v Kočevju, na naslovu Trata VI 11. ${f.lake}, ${f.center}. ${f.parking}. ${f.renovated}, meri ${f.size} in sprejme ${f.guests}.`,
      `Strato Apartment is in Kočevje, at Trata VI 11. ${e.lake}, ${e.center}. ${e.parking}. ${e.renovated}, it measures ${e.size} and sleeps ${e.guests}.`)} /></p>
    <p><Fragment set:html={t(
      `${f.bedrooms}. ${f.living}. ${f.kitchen}. ${f.bathroom}. ${f.climate}. ${f.outdoor}. ${f.extras}. ${f.languages}.`,
      `${e.bedrooms}. ${e.living}. ${e.kitchen}. ${e.bathroom}. ${e.climate}. ${e.outdoor}. ${e.extras}. ${e.languages}.`)} /></p>
  </div>
</section>

<section class="band">
  <div class="box">
    <div class="frame rv">
      <div class="card"><div><h2><Fragment set:html={t('Dobrodošli','Welcome')} /></h2><p><Fragment set:html={t('Dobrodošli na spletni strani Strato Apartmenta. Gostitelja Barbara in Rok vas sprejmeta osebno ali s samostojno prijavo s kodo – v prelepi kočevski pokrajini.','Welcome to the Strato Apartment website. Your hosts Barbara and Rok welcome you in person or with a self check-in code – in the beautiful Kočevsko countryside.')} /></p></div></div>
      <div class="pattern"><span>Strato</span></div>
    </div>
  </div>
</section>

<section class="apts">
  {spaces.map((s, i) => (
    <article class={'apt rv' + (i % 2 ? ' rev' : '')}>
      <div class="inner">
        <div class="ph"><img src={A+'strato-'+s.img+'.jpg'} alt={s.sl} loading="lazy" /></div>
        <div class="tx"><div><h2><Fragment set:html={t(s.sl,s.en)} /><em><Fragment set:html={t(s.ssl,s.sen)} /></em></h2><p><Fragment set:html={t(s.tsl+'.',s.ten+'.')} /></p><a class="btn" href="#galerija"><Fragment set:html={t('Poglej','View')} /></a></div></div>
      </div>
    </article>
  ))}
</section>

<section class="gal" id="galerija">
  <div class="wrap">
    <h2 class="center rv"><Fragment set:html={t('Galerija','Gallery')} /><em><Fragment set:html={t('Fotografije apartmaja','Photos of the apartment')} /></em></h2>
    <div class="grid rv">{gallery.map((n) => (<img src={A+'strato-'+n+'.jpg'} alt="Strato Apartment" loading="lazy" />))}</div>
  </div>
</section>

<section class="band" id="okolica">
  <div class="box">
    <div class="frame rv">
      <div class="card"><div><h2><Fragment set:html={t('Okolica','Things to do')} /></h2><p><Fragment set:html={t('Pet krajev iz vodnika gostiteljev, ki jih priporočata Barbara in Rok. Vse je v bližini apartmaja.','Five places from the hosts’ guide, recommended by Barbara and Rok. All are close to the apartment.')} /></p><a class="btn light" href={d.maps} target="_blank" rel="noopener" style="margin-top:22px"><Fragment set:html={t('Obišči','Visit')} /></a></div></div>
      <div class="pattern" style="display:block;padding:40px 44px;color:#fff;font:400 16px/1.8 var(--serif);letter-spacing:0;text-transform:none">
        {todo.map((p, i) => (<p style="border-bottom:1px solid rgba(255,255,255,.18);padding:12px 0;display:flex;gap:18px;flex-wrap:wrap"><span style="color:var(--pink2);font-size:14px">0{i+1}</span><b style="font-weight:400;font-size:22px;text-transform:uppercase"><Fragment set:html={t(p.sl,p.en)} /></b><i style="margin-left:auto;color:var(--pink2)"><Fragment set:html={t(p.note_sl,p.note_en)} /></i></p>))}
        <p style="padding-top:16px;font-size:15px;color:var(--pink2)"><Fragment set:html={t('Več iz vodnika: ','More from the guide: ')} />{d.more_from_guide.join(' · ')}</p>
      </div>
    </div>
  </div>
</section>

<section class="mnenja" id="mnenja">
  <div class="stripes" aria-hidden="true"></div>
  <div class="txt rv">
    <h2><Fragment set:html={t('Mnenja','Reviews')} /><em><Fragment set:html={t('Kaj o nas povedo naši gosti','What our guests say about us')} /></em></h2>
    <div class="scores">
      <div><b>9,9</b><span>Booking.com</span><Fragment set:html={t(d.ratings.booking,'9.9 / 10 (10 reviews) – Exceptional; staff 10, cleanliness 10, comfort 10, location 9.6')} /></div>
      <div><b>5,0</b><span>Airbnb</span><Fragment set:html={t(d.ratings.airbnb,'5.0 / 5 (9 reviews) – Guest favourite')} /></div>
    </div>
    <div class="slider" id="slider">
      <button class="sarrow l" type="button" data-dir="-1" aria-label="Prejšnje / Previous">‹</button>
      {reviews.map((r, i) => (<div class={'slide' + (i===0?' on':'')}><q><Fragment set:html={t(r.sl,r.en)} /></q><div class="n">{r.name}</div><div class="c">{r.source} · <Fragment set:html={t(split(r.date)[0], split(r.date)[1] || split(r.date)[0])} /></div>{r.translated && <div class="tr"><Fragment set:html={t('prevedeno','translated')} /></div>}</div>))}
      <button class="sarrow r" type="button" data-dir="1" aria-label="Naslednje / Next">›</button>
      <div class="dots">{reviews.map((r, i) => (<button type="button" data-i={i} aria-current={i===0?'true':'false'} aria-label={'Mnenje '+(i+1)}></button>))}</div>
    </div>
  </div>
</section>

<section class="band res" id="bentral">
  <div class="box">
    <div class="frame rv">
      <div class="widget"><div><b><Fragment set:html={t('Rezervacija','Reservation')} /></b>Bentral<br /><Fragment set:html={t('Tu bo Bentral rezervacijski koledar (vstavimo kodo vtičnika).','The Bentral booking calendar will be here (plugin code to be inserted).')} /></div></div>
      <div class="card"><div><h2><Fragment set:html={t('Kontakt','Contact')} /></h2><a class="btn" href={d.phone_href}><Fragment set:html={t('Pokliči','Call')} /></a><br /><a class="btn light" href={'mailto:'+d.email}><Fragment set:html={t('Piši','E-mail')} /></a><p><Fragment set:html={t(`${f.checkin}. ${f.checkout}.`,`${e.checkin}. ${e.checkout}.`)} /></p><p><Fragment set:html={t(f.rules+'.',e.rules+'.')} /></p></div></div>
    </div>
  </div>
</section>

<section class="kontakt" id="kontakt">
  <div class="wrap">
    <h2 class="center rv"><Fragment set:html={t('Kontakt','Contact')} /><em><Fragment set:html={t('Pišite nama','Write to us')} /></em></h2>
    <div class="grid">
      <form class="form rv" id="cf" action={'mailto:'+d.email} method="post" enctype="text/plain">
        <label><Fragment set:html={t('Ime in priimek','Full name')} /><input name="ime" required autocomplete="name" /></label>
        <label><Fragment set:html={t('E-pošta','E-mail')} /><input name="email" type="email" required autocomplete="email" /></label>
        <div class="two"><label><Fragment set:html={t('Prihod','Check-in')} /><input name="od" type="date" /></label><label><Fragment set:html={t('Odhod','Check-out')} /><input name="do" type="date" /></label></div>
        <label><Fragment set:html={t('Sporočilo','Message')} /><textarea name="sporocilo" required></textarea></label>
        <div><button class="btn" type="submit"><Fragment set:html={t('Pošlji','Send')} /></button></div>
        <p class="hint"><Fragment set:html={t('Obrazec odpre vaš e-poštni program s pripravljenim sporočilom za strato.apartment@gmail.com – pošljete ga vi. Nič se ne shranjuje na strani.','This form opens your e-mail app with a message prepared for strato.apartment@gmail.com – you send it yourself. Nothing is stored on the site.')} /></p>
      </form>
      <div class="info rv">
        <p><b>{d.hosts}</b><br />{d.address}<br /><a href={d.phone_href}>{d.phone}</a><br /><a href={'mailto:'+d.email}>{d.email}</a><br /><a class="u" href={d.maps} target="_blank" rel="noopener"><Fragment set:html={t('Google zemljevid','Google Maps')} /></a></p>
        <p><Fragment set:html={t(`${f.checkin}. ${f.checkout}. ${f.rules}.`,`${e.checkin}. ${e.checkout}. ${e.rules}.`)} /></p>
        <div class="slot"><b>Green & Safe</b><Fragment set:html={t('Logo Green & Safe (pošljeta gostitelja)','Green & Safe logo (to be supplied by the hosts)')} /></div>
        <p style="margin-top:14px"><a class="u" href={d.kocevsko_link} target="_blank" rel="noopener"><Fragment set:html={t('Najdete nas tudi na Kočevsko.com','Find us on Kočevsko.com too')} /></a></p>
      </div>
    </div>
  </div>
</section>

</main>

<footer>
  <div class="strip">
    <div class="pinkbar">
      <div class="icons">
        <a href={d.phone_href} aria-label="Telefon"><svg viewBox="0 0 24 24"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.6 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .6 3.6 1 1 0 0 1-.25 1z"/></svg></a>
        <a href={'mailto:'+d.email} aria-label="E-pošta"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 7l9 6 9-6"/></svg></a>
        <a href={d.maps} target="_blank" rel="noopener" aria-label="Zemljevid"><svg viewBox="0 0 24 24"><path d="M12 21s7-7 7-12a7 7 0 1 0-14 0c0 5 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/></svg></a>
      </div>
      <div class="kocbox"><a href={d.kocevsko_link} target="_blank" rel="noopener"><Fragment set:html={t('Najdete nas tudi na<br />Kočevsko.com','Find us on<br />Kočevsko.com')} /></a></div>
    </div>
    <div class="copy"><span>Copyright 2026 Strato Apartment</span><span>Predogled: AK agencija</span></div>
  </div>
</footer>

<script is:inline>
(function(){
  var h=document.documentElement;
  var titles={sl:'Strato Apartment · Kočevje',en:'Strato Apartment · Kočevje, Slovenia'};
  function setLang(l){h.lang=l;document.title=titles[l];try{localStorage.setItem('strato-lang',l)}catch(e){}
    document.querySelectorAll('[data-set]').forEach(function(b){b.setAttribute('aria-pressed',String(b.dataset.set===l))});}
  document.querySelectorAll('[data-set]').forEach(function(b){b.addEventListener('click',function(){setLang(b.dataset.set)})});
  setLang(h.lang==='en'?'en':'sl');
  var ov=document.getElementById('overlay');
  document.getElementById('burger').addEventListener('click',function(){ov.classList.add('open')});
  document.getElementById('close').addEventListener('click',function(){ov.classList.remove('open')});
  ov.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(){ov.classList.remove('open')})});
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}})},{threshold:.08,rootMargin:'0px 0px -5% 0px'});
    document.querySelectorAll('.rv').forEach(function(el){var r=el.getBoundingClientRect();if(r.top<innerHeight&&r.bottom>0){el.classList.add('in')}else{io.observe(el)}});
  } else { document.querySelectorAll('.rv').forEach(function(el){el.classList.add('in')}); }
  addEventListener('scroll',function(){document.querySelectorAll('.rv:not(.in)').forEach(function(el){if(el.getBoundingClientRect().top<innerHeight)el.classList.add('in')})},{passive:true});
  var slides=[].slice.call(document.querySelectorAll('#slider .slide')), dots=[].slice.call(document.querySelectorAll('#slider .dots button')), cur=0;
  function go(i){cur=(i+slides.length)%slides.length;slides.forEach(function(s,k){s.classList.toggle('on',k===cur)});dots.forEach(function(b,k){b.setAttribute('aria-current',String(k===cur))});}
  document.querySelectorAll('#slider .sarrow').forEach(function(b){b.addEventListener('click',function(){go(cur+Number(b.dataset.dir))})});
  dots.forEach(function(b){b.addEventListener('click',function(){go(Number(b.dataset.i))})});
  var cf=document.getElementById('cf');
  cf.addEventListener('submit',function(ev){ev.preventDefault();
    var en=h.lang==='en';
    var body=(en?'Name: ':'Ime: ')+cf.ime.value+'\n'+(en?'E-mail: ':'E-pošta: ')+cf.email.value+'\n'+(en?'Dates: ':'Termin: ')+(cf.od.value||'–')+' – '+(cf.do.value||'–')+'\n\n'+cf.sporocilo.value;
    location.href='mailto:'+'strato.apartment@gmail.com'+'?subject='+encodeURIComponent(en?'Enquiry – Strato Apartment':'Povpraševanje – Strato Apartment')+'&body='+encodeURIComponent(body);
  });
})();
</script>
</body>
</html>
