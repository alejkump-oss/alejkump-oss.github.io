---
// PROMO-TEK – predlog 1: sodobna B2B katalog / e-shop domača stran.
// Iskanje, ploščice kategorij, izdelki s cenami in tok »Dodaj v povpraševanje« → obrazec → mailto.
// Vsi podatki iz src/data/promo-tek.json (prebrani s promo-tek.si 2026-11-27); fotografije so njihove.
import d from '../../../../data/promo-tek.json';
const A = '../assets/';
const c = d.company;
const featured = d.products.filter(p => ['ADA','MASTER MEN','ABSOLUT HOODY','2001','Termo lonček Liran','NAMIZNI LEŽEČI KOLEDAR FIX','Poslovni nahrbtnik Maren','Brezžični zvočnik OPERA','ADAMS','ALCANTARA','FORCE JACKET','Svinčnik v etuiju Tarel'].includes(p.name));
const mailSubject = 'Povpraševanje za ponudbo – promo-tek.si';
---
<!doctype html>
<html lang="sl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>PROMO-TEK – promocijski izdelki s tiskom | Predlog 1</title>
<meta name="description" content="Promocijski izdelki, tekstil, delovna zaščita in tisk. Približno 1.500 izdelkov v 13 kategorijah, dotisk logotipa v lastni delavnici v Novem mestu. Predogled prenove.">
<meta name="robots" content="noindex">
<link rel="icon" href={A + 'logo-cut.png'}>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style is:global>
:root{--navy:#0b2a5b;--navy2:#102f66;--blue:#1b8fe6;--blue2:#0f74c4;--ink:#17202b;--mute:#5b6775;--line:#e3e8ef;--bg:#f5f7fa;--white:#fff;--r:14px;--gut:16px}
*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
body{margin:0;background:var(--white);color:var(--ink);font-family:Inter,system-ui,sans-serif;font-size:16px;line-height:1.55;overflow-x:hidden}
img{display:block;max-width:100%;height:auto}
a{color:inherit}
h1,h2,h3{margin:0;font-family:Manrope,Inter,sans-serif;font-weight:800;line-height:1.1;letter-spacing:-.02em}
h1{font-size:clamp(1.9rem,5.5vw,3.4rem)}
h2{font-size:clamp(1.45rem,3.2vw,2.1rem)}
h3{font-size:1.05rem;font-weight:700}
p{margin:0}
.wrap{width:100%;max-width:1200px;margin:0 auto;padding-left:max(var(--gut),env(safe-area-inset-left));padding-right:max(var(--gut),env(safe-area-inset-right))}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:12px 22px;border-radius:10px;font-weight:600;font-size:15px;text-decoration:none;border:0;cursor:pointer;font-family:inherit;transition:background .2s,transform .1s}
.btn:active{transform:translateY(1px)}
.btn.p{background:var(--blue);color:#fff}.btn.p:hover{background:var(--blue2)}
.btn.n{background:var(--navy);color:#fff}.btn.n:hover{background:var(--navy2)}
.btn.o{background:#fff;color:var(--navy);border:1.5px solid var(--line)}.btn.o:hover{border-color:var(--navy)}
.btn.w{background:#fff;color:var(--navy)}
.kicker{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--blue)}
/* top bar */
.top{background:var(--navy);color:#dfe8f5;font-size:13px}
.top .wrap{display:flex;justify-content:space-between;align-items:center;min-height:44px;gap:12px}
.top a{color:#fff;text-decoration:none;display:inline-flex;align-items:center;gap:6px;min-height:44px;padding:0 4px}
.top .tag{display:none;letter-spacing:.08em;text-transform:uppercase;font-size:11px}
@media (min-width:860px){.top .tag{display:block}}
/* header */
header{position:sticky;top:0;z-index:50;background:#fff;border-bottom:1px solid var(--line)}
.hd{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;min-height:68px}
.logo{display:inline-flex;align-items:center;min-height:44px}
.logo img{height:40px;width:auto}
.search{display:none}
.search form{display:flex;border:1.5px solid var(--line);border-radius:10px;overflow:hidden;background:#fff}
.search input{flex:1;border:0;padding:0 14px;font:inherit;font-size:16px;min-height:44px;outline:0}
.search button{border:0;background:var(--navy);color:#fff;min-width:48px;cursor:pointer}
@media (min-width:860px){.search{display:block;max-width:520px;margin:0 auto;width:100%}}
.hact{display:flex;align-items:center;gap:8px}
.icbtn{width:44px;height:44px;border-radius:10px;display:grid;place-items:center;border:1.5px solid var(--line);background:#fff;text-decoration:none;color:var(--navy);cursor:pointer;position:relative}
.icbtn svg{width:22px;height:22px}
.badge{position:absolute;top:-6px;right:-6px;background:var(--blue);color:#fff;font-size:11px;font-weight:700;min-width:20px;height:20px;border-radius:999px;display:grid;place-items:center;padding:0 5px}
.badge:empty,.badge[data-n="0"]{display:none}
.desk{display:none;gap:4px;align-items:center}
.desk a{text-decoration:none;font-weight:500;font-size:15px;padding:10px 12px;border-radius:8px;min-height:44px;display:inline-flex;align-items:center}
.desk a:hover{background:var(--bg)}
@media (min-width:1024px){.desk{display:flex}.burger{display:none!important}}
nav.main{display:none;border-top:1px solid var(--line);background:#fff}
nav.main.open{display:block}
nav.main ul{list-style:none;margin:0;padding:8px 0}
nav.main a{display:flex;align-items:center;min-height:48px;padding:0 var(--gut);text-decoration:none;font-weight:500}
nav.main a:hover{background:var(--bg)}
@media (min-width:1024px){nav.main{display:none!important}}
/* hero */
.hero{background:var(--navy) url('../assets/banner-dark.webp') center/cover no-repeat;color:#fff;position:relative}
.hero::before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(11,42,91,.92),rgba(11,42,91,.6))}
.hero .wrap{position:relative;padding-top:48px;padding-bottom:48px;display:grid;gap:22px;max-width:1200px}
.hero p.lead{font-size:clamp(1rem,2.2vw,1.2rem);max-width:56ch;color:#dbe6f6}
.hero .kicker{color:#8fc6f5}
.hero form{display:flex;background:#fff;border-radius:12px;overflow:hidden;max-width:620px;box-shadow:0 10px 30px -14px rgba(0,0,0,.5)}
.hero input{flex:1;min-width:0;border:0;font:inherit;font-size:16px;padding:0 16px;min-height:52px;outline:0;color:var(--ink)}
.hero form button{min-width:56px;border:0;background:var(--blue);color:#fff;cursor:pointer;font-weight:600;padding:0 18px}
.hero .cta{display:flex;flex-wrap:wrap;gap:10px}
.hero .facts{display:flex;flex-wrap:wrap;gap:8px 20px;font-size:14px;color:#c8d8ee}
.hero .facts span::before{content:"✓";color:#8fc6f5;margin-right:6px;font-weight:700}
@media (min-width:860px){.hero .wrap{padding-top:72px;padding-bottom:72px}}
/* sections */
section{padding:44px 0}
@media (min-width:860px){section{padding:64px 0}}
.sh{display:flex;justify-content:space-between;align-items:end;gap:16px;margin-bottom:22px;flex-wrap:wrap}
.sh p{color:var(--mute);max-width:60ch;margin-top:6px}
.cats{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
@media (min-width:640px){.cats{grid-template-columns:repeat(3,1fr)}}
@media (min-width:1024px){.cats{grid-template-columns:repeat(4,1fr);gap:16px}}
.cat{display:block;text-decoration:none;background:var(--bg);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;transition:transform .2s,box-shadow .2s}
.cat:hover{transform:translateY(-2px);box-shadow:0 14px 30px -20px rgba(11,42,91,.4)}
.cat img{aspect-ratio:1;object-fit:contain;background:#fff;padding:14px;width:100%}
.cat .b{padding:12px 14px 14px}
.cat h3{font-size:15px}
.cat .n{font-size:13px;color:var(--mute);margin-top:2px}
.cat .s{display:none;font-size:13px;color:var(--mute);margin-top:6px}
@media (min-width:640px){.cat .s{display:block}}
/* products */
.sec-alt{background:var(--bg)}
.prods{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
@media (min-width:640px){.prods{grid-template-columns:repeat(3,1fr)}}
@media (min-width:1024px){.prods{grid-template-columns:repeat(4,1fr);gap:16px}}
.pr{background:#fff;border:1px solid var(--line);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column}
.pr img{aspect-ratio:1;object-fit:contain;padding:12px;width:100%;background:#fff}
.pr .b{padding:0 12px 12px;display:flex;flex-direction:column;gap:4px;flex:1}
.pr .c{font-size:12px;color:var(--mute);text-transform:uppercase;letter-spacing:.06em}
.pr h3{font-size:15px}
.pr .d{font-size:13px;color:var(--mute);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.pr .pz{margin-top:auto;padding-top:8px;display:flex;justify-content:space-between;align-items:center;gap:8px}
.pr .pz strong{font-family:Manrope,sans-serif;font-size:17px;color:var(--navy)}
.pr .pz small{display:block;font-size:11px;color:var(--mute);font-weight:400}
.add{min-width:44px;min-height:44px;border-radius:10px;border:1.5px solid var(--navy);background:#fff;color:var(--navy);font-weight:700;cursor:pointer;font-size:20px;line-height:1;display:grid;place-items:center}
.add[aria-pressed=true]{background:var(--navy);color:#fff}
.pr.hide{display:none}
#noRes{display:none;padding:24px;background:#fff;border:1px dashed var(--line);border-radius:var(--r);color:var(--mute);text-align:center}
/* packages */
.packs{display:grid;gap:12px}
@media (min-width:860px){.packs{grid-template-columns:repeat(3,1fr);gap:16px}}
.pk{display:grid;grid-template-columns:110px 1fr;gap:12px;background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:12px;align-items:center}
.pk img{aspect-ratio:1;object-fit:contain;border-radius:10px;background:var(--bg)}
.pk strong{font-family:Manrope,sans-serif;font-size:19px;color:var(--navy)}
.pk p{font-size:14px;color:var(--mute)}
.pk .note{font-size:12px;color:var(--blue);font-weight:600;margin-top:4px}
/* tisk */
.tech{display:grid;gap:12px}
@media (min-width:640px){.tech{grid-template-columns:repeat(2,1fr)}}
@media (min-width:1024px){.tech{grid-template-columns:repeat(4,1fr);gap:16px}}
.tc{border:1px solid var(--line);border-radius:var(--r);overflow:hidden;background:#fff}
.tc img{aspect-ratio:3/2;object-fit:cover;width:100%}
.tc .b{padding:14px}
.tc p{font-size:14px;color:var(--mute);margin-top:6px}
.tc .f{font-size:13px;color:var(--navy);margin-top:8px;font-weight:500}
/* steps */
.steps{display:grid;gap:12px;counter-reset:s}
@media (min-width:860px){.steps{grid-template-columns:repeat(4,1fr)}}
.st{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:18px;counter-increment:s}
.st::before{content:counter(s);display:grid;place-items:center;width:36px;height:36px;border-radius:999px;background:var(--navy);color:#fff;font-weight:700;font-family:Manrope,sans-serif;margin-bottom:10px}
.st p{font-size:14px;color:var(--mute);margin-top:4px}
/* quote */
.quote{background:var(--navy);color:#fff}
.quote .grid{display:grid;gap:24px}
@media (min-width:960px){.quote .grid{grid-template-columns:1fr 1.2fr;gap:48px;align-items:start}}
.quote .kicker{color:#8fc6f5}
.quote p.l{color:#c8d8ee;margin-top:10px}
.quote ul{margin:16px 0 0;padding:0;list-style:none;display:grid;gap:8px;color:#dbe6f6;font-size:15px}
.quote li::before{content:"—";margin-right:8px;color:#8fc6f5}
.contact-lines{display:grid;gap:10px;margin-top:22px}
.contact-lines a{display:inline-flex;align-items:center;gap:10px;color:#fff;text-decoration:none;min-height:44px;font-weight:600}
.contact-lines svg{width:20px;height:20px}
form.q{background:#fff;color:var(--ink);border-radius:var(--r);padding:18px;display:grid;gap:12px}
@media (min-width:640px){form.q{padding:24px;grid-template-columns:1fr 1fr}form.q .full{grid-column:1/-1}}
form.q label{display:grid;gap:6px;font-size:13px;font-weight:600;color:var(--mute)}
form.q input,form.q textarea,form.q select{font:inherit;font-size:16px;min-height:48px;padding:10px 12px;border:1.5px solid var(--line);border-radius:10px;width:100%;background:#fff;color:var(--ink)}
form.q textarea{min-height:110px;resize:vertical}
form.q input:focus,form.q textarea:focus,form.q select:focus{outline:2px solid var(--blue);outline-offset:1px;border-color:var(--blue)}
#sel{display:flex;flex-wrap:wrap;gap:6px;min-height:24px}
#sel span{background:var(--bg);border:1px solid var(--line);border-radius:999px;padding:6px 10px;font-size:13px;display:inline-flex;align-items:center;gap:6px}
#sel button{border:0;background:none;cursor:pointer;font-size:16px;line-height:1;color:var(--mute);min-width:24px;min-height:24px}
#sel:empty::before{content:"Še niste izbrali izdelkov – kliknite + pri izdelku ali napišite želje v sporočilo.";font-size:13px;color:var(--mute);font-weight:400}
form.q .hint{font-size:12px;color:var(--mute)}
form.q .btn{width:100%}
/* footer */
footer{background:#0a1f44;color:#b9c8df;font-size:14px;padding:36px 0 28px}
footer .cols{display:grid;gap:22px}
@media (min-width:860px){footer .cols{grid-template-columns:1.4fr 1fr 1fr 1fr}}
footer h3{color:#fff;font-size:14px;letter-spacing:.08em;text-transform:uppercase;margin-bottom:10px}
footer a{color:#fff;text-decoration:none;display:inline-flex;min-height:44px;align-items:center}
footer ul{list-style:none;margin:0;padding:0}
footer .logo-w{background:#fff;border-radius:10px;padding:10px 12px;display:inline-block;margin-bottom:12px}
footer .logo-w img{height:34px;width:auto}
footer .bot{border-top:1px solid rgba(255,255,255,.12);margin-top:26px;padding-top:16px;display:flex;flex-wrap:wrap;gap:8px 20px;justify-content:space-between;font-size:13px}
footer .bot strong{color:#fff}
/* sticky mobile bar */
.mbar{position:fixed;left:0;right:0;bottom:0;z-index:40;display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:8px max(12px,env(safe-area-inset-right)) max(8px,env(safe-area-inset-bottom)) max(12px,env(safe-area-inset-left));background:rgba(255,255,255,.96);backdrop-filter:blur(8px);border-top:1px solid var(--line)}
.mbar .btn{min-height:48px;font-size:15px}
@media (min-width:860px){.mbar{display:none}}
body{padding-bottom:76px}@media (min-width:860px){body{padding-bottom:0}}
</style>
</head>
<body>
<div class="top"><div class="wrap">
  <span class="tag">{c.tagline}</span>
  <a href={c.phoneHref}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>{c.phone}</a>
  <a href={'mailto:' + c.email}>{c.email}</a>
</div></div>

<header>
  <div class="wrap hd">
    <a class="logo" href="#" aria-label="PROMO-TEK, domov"><img src={A + 'logo.png'} width="640" height="202" alt="PROMO-TEK – Boost your promotion"></a>
    <div class="search"><form role="search" data-search><input type="search" name="q" placeholder="Išči med izdelki (npr. majica, steklenica, svinčnik)…" aria-label="Iskanje izdelkov"><button type="submit" aria-label="Išči"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button></form></div>
    <div class="hact">
      <nav class="desk" aria-label="Glavni meni"><a href="#kategorije">Kategorije</a><a href="#izdelki">Izdelki</a><a href="#paketi">Promo paketi</a><a href="#tisk">Tisk</a><a href="#kontakt">Kontakt</a></nav>
      <a class="icbtn" href="#povprasevanje" aria-label="Povpraševanje"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v12H7l-3 3z"/><path d="M8 9h8M8 12h5"/></svg><span class="badge" id="badge" data-n="0"></span></a>
      <button class="icbtn burger" id="burger" aria-expanded="false" aria-controls="mnav" aria-label="Meni"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
    </div>
  </div>
  <nav class="main" id="mnav" aria-label="Mobilni meni"><ul>
    <li><a href="#kategorije">Kategorije</a></li><li><a href="#izdelki">Izdelki</a></li><li><a href="#paketi">Promo paketi</a></li><li><a href="#tisk">Tisk in dodelava</a></li><li><a href="#kontakt">Kontakt</a></li><li><a href={c.phoneHref}>Pokliči {c.phone}</a></li>
  </ul></nav>
</header>

<main>
<div class="hero"><div class="wrap">
  <span class="kicker">Promocijski izdelki • Tekstil • Delovna zaščita • Tisk</span>
  <h1>Vaš logotip na izdelkih, ki ostanejo v uporabi.</h1>
  <p class="lead">Približno 1.500 promocijskih izdelkov v 13 kategorijah, dotisk v lastni delavnici v Novem mestu. Izberite izdelke, pošljite povpraševanje in prejmite ponudbo z dodelavo.</p>
  <form role="search" data-search><input type="search" name="q" placeholder="Išči: majica, steklenica, svinčnik, nahrbtnik…" aria-label="Iskanje izdelkov"><button type="submit">Išči</button></form>
  <div class="cta"><a class="btn p" href="#povprasevanje">Povpraševanje za ponudbo</a><a class="btn w" href="#kategorije">Preglej kategorije</a></div>
  <div class="facts"><span>DTF, UV, širokoformatni tisk, lasersko graviranje</span><span>Veliko izdelkov na zalogi</span><span>Showroom v Novem mestu</span></div>
</div></div>

<section id="kategorije"><div class="wrap">
  <div class="sh"><div><span class="kicker">Katalog</span><h2>Kategorije izdelkov</h2><p>Število izdelkov na kategorijo, kot ga danes kaže spletna trgovina. Povezave vodijo na obstoječo trgovino.</p></div></div>
  <div class="cats">
    {d.categories.map(k => (
      <a class="cat" href={`${c.site}/izdelek-kategorija/${k.slug}/`} target="_blank" rel="noopener">
        <img src={A + k.img} width="800" height="800" loading="lazy" alt={k.name}>
        <div class="b"><h3>{k.name}</h3><div class="n">{k.count} izdelkov</div><div class="s">{k.sub}</div></div>
      </a>
    ))}
  </div>
</div></section>

<section id="izdelki" class="sec-alt"><div class="wrap">
  <div class="sh"><div><span class="kicker">Izbor</span><h2>Primeri izdelkov in cen</h2><p>Cene so z DDV, za nepotiskan izdelek, kot so objavljene v trgovini. Dotisk ovrednotimo v ponudbi. Kliknite <strong>+</strong> in izdelek se doda v povpraševanje.</p></div><a class="btn o" href={c.site + '/trgovina/'} target="_blank" rel="noopener">Vsi izdelki v trgovini</a></div>
  <div class="prods" id="grid">
    {featured.map(p => (
      <article class="pr" data-name={p.name} data-cat={p.cat} data-q={(p.name + ' ' + p.cat + ' ' + p.desc).toLowerCase()}>
        <img src={A + p.img} width="800" height="800" loading="lazy" alt={p.name + ' – ' + p.desc}>
        <div class="b"><span class="c">{p.cat}</span><h3>{p.name}</h3><p class="d">{p.desc}</p>
          <div class="pz"><strong>{p.price}<small>z DDV, brez dotiska</small></strong><button class="add" type="button" aria-pressed="false" aria-label={'Dodaj ' + p.name + ' v povpraševanje'} data-add={p.name + ' (' + p.price + ')'}>+</button></div>
        </div>
      </article>
    ))}
  </div>
  <div id="noRes">Ni zadetkov med prikazanimi primeri. Poglejte <a href={c.site + '/trgovina/'} target="_blank" rel="noopener">celotno trgovino</a> ali opišite želeni izdelek v povpraševanju.</div>
</div></section>

<section id="paketi"><div class="wrap">
  <div class="sh"><div><span class="kicker">Posebna ponudba</span><h2>Promo paketi z vašim logotipom</h2><p>Majhne pozornosti, velik vtis. Pripravljeni kompleti s potiskom; priprave za tisk pri paketih ne zaračunamo.</p></div></div>
  <div class="packs">
    {d.packages.map(k => (
      <div class="pk"><img src={A + k.img} width="800" height="800" loading="lazy" alt={'Paket ' + k.name}>
        <div><strong>{k.name}</strong><p>{k.contents}</p><div class="note">{k.price} z DDV · priprava za tisk vključena</div>
          <button class="add" type="button" aria-pressed="false" style="margin-top:8px;width:auto;padding:0 12px;font-size:14px" data-add={'Paket ' + k.name + ' (' + k.price + ')'}>+ Dodaj v povpraševanje</button></div>
      </div>
    ))}
  </div>
</div></section>

<section id="tisk" class="sec-alt"><div class="wrap">
  <div class="sh"><div><span class="kicker">Lastna delavnica</span><h2>Tisk in dodelava</h2><p>Štiri tehnike v hiši; glede na izdelek svetujemo tudi sitotisk, tampotisk, preslikač ali vezenje. Grafično pripravo uredimo mi.</p></div></div>
  <div class="tech">
    {d.techniques.map(t => (
      <div class="tc"><img src={A + t.img} width="1400" height="933" loading="lazy" alt={t.title}>
        <div class="b"><h3>{t.name}</h3><p>{t.desc}</p><div class="f">Za: {t.for}</div>{t.note && <div class="f">{t.note}</div>}</div></div>
    ))}
  </div>
</div></section>

<section><div class="wrap">
  <div class="sh"><div><span class="kicker">Postopek</span><h2>Kako pride do ponudbe</h2></div></div>
  <div class="steps">
    <div class="st"><h3>Izberete izdelke</h3><p>Iz trgovine, katalogov ali s klikom + na tej strani. Navedite količine in rok.</p></div>
    <div class="st"><h3>Priložite logotip</h3><p>PDF, PNG ali JPG do 10 MB. Svetujemo tehniko tiska glede na material.</p></div>
    <div class="st"><h3>Prejmete ponudbo</h3><p>Cene, dobavljivost in možnosti dodelave preverimo ob povpraševanju.</p></div>
    <div class="st"><h3>Potrditev in izvedba</h3><p>Za naročilo z dodelavo priporočamo plačilo po predračunu. Rok dobave nepotiskanih izdelkov je 7–14 dni od potrditve, z dotiskom po dogovoru.</p></div>
  </div>
</div></section>

<section class="quote" id="povprasevanje"><div class="wrap grid">
  <div>
    <span class="kicker">Povpraševanje za ponudbo</span>
    <h2>Povejte, kaj potrebujete. Ponudbo pripravimo po meri.</h2>
    <p class="l">Obrazec odpre vaš e-poštni program s pripravljenim sporočilom na {c.email}. Nič se ne pošlje brez vašega klika.</p>
    <ul><li>Navedite izdelke, količine in roke.</li><li>Logotip priložite v e-pošti (PDF, PNG, JPG do 10 MB).</li><li>Veliko promocijskega materiala imamo na zalogi.</li></ul>
    <div class="contact-lines" id="kontakt">
      <a href={c.phoneHref}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>{c.phone}</a>
      <a href={'mailto:' + c.email}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>{c.email}</a>
      <a href="https://www.google.com/maps/search/?api=1&query=Podbev%C5%A1kova+ulica+15%2C+8000+Novo+mesto" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>Showroom: {c.showroom}</a>
    </div>
  </div>
  <form class="q" id="qf" action={'mailto:' + c.email} method="post" enctype="text/plain">
    <label class="full">Izbrani izdelki<div id="sel" aria-live="polite"></div></label>
    <label>Podjetje<input name="podjetje" autocomplete="organization" required></label>
    <label>Ime in priimek<input name="ime" autocomplete="name" required></label>
    <label>E-pošta<input type="email" name="email" autocomplete="email" required></label>
    <label>Telefon<input type="tel" name="telefon" autocomplete="tel"></label>
    <label>Količina (skupaj ali po izdelku)<input name="kolicina" inputmode="numeric" placeholder="npr. 100 kosov"></label>
    <label>Želeni rok<input name="rok" placeholder="npr. do 15. 12."></label>
    <label class="full">Sporočilo (izdelki, barve, mesto tiska)<textarea name="sporocilo"></textarea></label>
    <div class="full hint">Logotip priložite v e-pošti, ki se odpre (PDF, PNG, JPG do 10 MB). Pošiljate na {c.email}.</div>
    <button class="btn p full" type="submit">Pripravi e-pošto s povpraševanjem</button>
  </form>
</div></section>
</main>

<footer><div class="wrap">
  <div class="cols">
    <div><div class="logo-w"><img src={A + 'logo.png'} width="640" height="202" alt="PROMO-TEK" loading="lazy"></div><p>{c.name}<br>{c.street}, {c.city}<br>Matična št.: {c.maticna} · ID za DDV: {c.ddv}</p></div>
    <div><h3>Kontakt</h3><ul><li><a href={c.phoneHref}>{c.phone}</a></li><li><a href={'mailto:' + c.email}>{c.email}</a></li><li>Showroom: {c.showroom}</li></ul></div>
    <div><h3>Ponudba</h3><ul><li><a href="#kategorije">Kategorije</a></li><li><a href="#paketi">Promo paketi</a></li><li><a href="#tisk">Tisk in dodelava</a></li><li><a href={c.site + '/katalogi/'} target="_blank" rel="noopener">Katalogi (PDF)</a></li></ul></div>
    <div><h3>Pogoji</h3><ul><li>Cene z DDV, brez dotiska</li><li>Dobava 7–14 dni (nepotiskano)</li><li>Z dodelavo: plačilo po predračunu</li></ul></div>
  </div>
  <div class="bot"><span>© {c.name}</span><span><strong>{d.footerLine}</strong></span></div>
</div></footer>

<div class="mbar"><a class="btn n" href={c.phoneHref}>Pokliči {c.phone}</a><a class="btn p" href="#povprasevanje">Povpraševanje</a></div>

<script is:inline>
(function(){
  var b=document.getElementById('burger'),n=document.getElementById('mnav');
  b.addEventListener('click',function(){var o=n.classList.toggle('open');b.setAttribute('aria-expanded',o?'true':'false')});
  n.addEventListener('click',function(e){if(e.target.tagName==='A'){n.classList.remove('open');b.setAttribute('aria-expanded','false')}});
  // search (filters the sample grid)
  var cards=[].slice.call(document.querySelectorAll('#grid .pr')),noRes=document.getElementById('noRes');
  function filter(q){q=(q||'').trim().toLowerCase();var hits=0;cards.forEach(function(c){var h=!q||c.getAttribute('data-q').indexOf(q)>-1;c.classList.toggle('hide',!h);if(h)hits++});noRes.style.display=hits?'none':'block';}
  [].forEach.call(document.querySelectorAll('[data-search]'),function(f){var i=f.querySelector('input');f.addEventListener('submit',function(e){e.preventDefault();filter(i.value);document.getElementById('izdelki').scrollIntoView({behavior:'smooth'})});i.addEventListener('input',function(){filter(i.value)})});
  // quote basket
  var sel=[],selEl=document.getElementById('sel'),badge=document.getElementById('badge');
  function render(){selEl.innerHTML='';sel.forEach(function(s){var sp=document.createElement('span');sp.textContent=s;var x=document.createElement('button');x.type='button';x.setAttribute('aria-label','Odstrani '+s);x.textContent='×';x.addEventListener('click',function(){toggle(s)});sp.appendChild(x);selEl.appendChild(sp)});badge.textContent=sel.length||'';badge.setAttribute('data-n',String(sel.length));[].forEach.call(document.querySelectorAll('[data-add]'),function(bt){bt.setAttribute('aria-pressed',sel.indexOf(bt.getAttribute('data-add'))>-1?'true':'false')});}
  function toggle(s){var i=sel.indexOf(s);if(i>-1)sel.splice(i,1);else sel.push(s);render();}
  [].forEach.call(document.querySelectorAll('[data-add]'),function(bt){bt.addEventListener('click',function(){toggle(bt.getAttribute('data-add'))})});
  render();
  // mailto builder
  var f=document.getElementById('qf');
  f.addEventListener('submit',function(e){e.preventDefault();var v=function(n){return (f.elements[n]&&f.elements[n].value||'').trim()};
    var body='Pozdravljeni,\n\nprosim za ponudbo za naslednje izdelke:\n'+(sel.length?sel.map(function(s){return '- '+s}).join('\n'):'- (glej sporočilo)')+'\n\nKoličina: '+v('kolicina')+'\nŽeleni rok: '+v('rok')+'\n\nSporočilo:\n'+v('sporocilo')+'\n\nPodjetje: '+v('podjetje')+'\nKontakt: '+v('ime')+', '+v('email')+(v('telefon')?', '+v('telefon'):'')+'\n\nLogotip prilagam v tej e-pošti.\n';
    window.location.href='mailto:'+'info@promo-tek.si'+'?subject='+encodeURIComponent('Povpraševanje za ponudbo – promo-tek.si')+'&body='+encodeURIComponent(body);});
})();
</script>
</body>
</html>
