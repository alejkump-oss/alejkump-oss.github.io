---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base
  page="index"
  path=""
  title="Izdelava spletnih strani Kočevje in Dolenjska | AK agencija, Alej Kump"
  description="Izdelava spletnih strani za lokalna podjetja v Kočevju, po Dolenjski in Sloveniji. Brezplačen predogled, nato pisna ponudba s ceno po dogovoru, brez obveznosti."
>
  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow reveal">Kočevje · Dolenjska · Slovenija</p>
        <h1 class="h1 reveal" id="hero-h">Spletne strani <span class="serif">za lokalna</span> podjetja</h1>
        <p class="lead reveal">Enočlanski spletni studio, ki gradi pregledne in hitre spletne strani za trgovine, restavracije in obrtnike v Kočevju in po vsej Sloveniji.</p>
        <div class="btn-row reveal">
          <a class="btn btn--solid" href="tel:+38670479188"><Icon name="call" />Pokličite 070 479 188</a>
          <a class="btn" href="tel:+38670479188">Brezplačen predogled<Icon name="arrow" /></a>
        </div>
      </div>
      <figure class="hero-photo reveal">
        <img src="/img/alej-portret-760.webp" width="760" height="950" alt="Alej Kump, AK agencija" fetchpriority="high" decoding="async">
      </figure>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-label="Spletne strani za lokalna podjetja · Kočevje · Dolenjska · vsa Slovenija">
    <div class="marquee-track">
      <span>Spletne strani za lokalna podjetja</span><i aria-hidden="true">·</i>
      <span>Kočevje</span><i aria-hidden="true">·</i>
      <span>Dolenjska</span><i aria-hidden="true">·</i>
      <span>Vsa Slovenija</span><i aria-hidden="true">·</i>
      <span aria-hidden="true">Spletne strani za lokalna podjetja</span><i aria-hidden="true">·</i>
      <span aria-hidden="true">Kočevje</span><i aria-hidden="true">·</i>
      <span aria-hidden="true">Dolenjska</span><i aria-hidden="true">·</i>
      <span aria-hidden="true">Vsa Slovenija</span><i aria-hidden="true">·</i>
    </div>
  </div>

  <!-- POUDARKI -->
  <section class="sec" id="poudarki" aria-labelledby="poudarki-h">
    <div class="wrap">
      <p class="eyebrow reveal">Poudarki</p>
      <h2 class="h2 reveal" id="poudarki-h">Zakaj sodelovati z AK agencija</h2>
      <div class="cards cards--3">
        <article class="card reveal">
          <span class="icon-box"><Icon name="eye" /></span>
          <h3>Brezplačen predogled brez obveznosti</h3>
          <p>Predogled zgradim iz javno dostopnih podatkov o vašem podjetju in vam ga pokažem na telefonu, brez kakršnih koli obveznosti.</p>
        </article>
        <article class="card reveal">
          <span class="icon-box"><Icon name="globe" /></span>
          <h3>Domena vključena v prvem letu</h3>
          <p>Domeno za prvo leto registriram na vaše ime.</p>
        </article>
        <article class="card reveal">
          <span class="icon-box"><Icon name="doc" /></span>
          <h3>Cena dogovorjena pisno</h3>
          <p>Pisna ponudba določi ceno še pred začetkom dela.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- KAJ GRADIM -->
  <section class="sec sec--alt" id="storitve" aria-labelledby="gradim-h">
    <div class="wrap">
      <p class="eyebrow reveal">Storitve</p>
      <h2 class="h2 reveal" id="gradim-h">Kaj gradim</h2>
      <div class="cards cards--2">
        <article class="card card--row reveal">
          <span class="icon-box"><Icon name="store" /></span>
          <div><h3>Spletne strani za podjetja</h3><p>Dom, storitve in kontakt za trgovine, pisarne in storitve.</p></div>
        </article>
        <article class="card card--row reveal">
          <span class="icon-box"><Icon name="fork" /></span>
          <div><h3>Strani za restavracije z jedilnikom</h3><p>Jedilnik, tedenska ponudba in delovni čas, s klicnim gumbom.</p></div>
        </article>
        <article class="card card--row reveal">
          <span class="icon-box"><Icon name="image" /></span>
          <div><h3>Galerija fotografij</h3></div>
        </article>
        <article class="card card--row reveal">
          <span class="icon-box"><Icon name="phone" /></span>
          <div><h3>Prilagojeno za telefon</h3></div>
        </article>
      </div>
      <div class="btn-row reveal"><a class="btn" href="storitve.html">Vse storitve<Icon name="arrow" /></a></div>
    </div>
  </section>

  <!-- POSTOPEK -->
  <section class="sec sec--dark" id="postopek" aria-labelledby="postopek-h">
    <div class="wrap steps-grid">
      <div class="steps-head">
        <p class="eyebrow reveal">Kako deluje</p>
        <h2 class="h2 reveal" id="postopek-h">Štirje koraki, brez presenečenj</h2>
      </div>
      <ol class="steps">
        <li class="step reveal"><span class="step-n" aria-hidden="true">01</span><div><h3>Brezplačen predogled</h3><p>Iz javnih podatkov vašega podjetja pripravim predogled strani. Ogledate si ga na telefonu, brez obveznosti in brez plačila.</p></div></li>
        <li class="step reveal"><span class="step-n" aria-hidden="true">02</span><div><h3>Pisna ponudba</h3><p>S ceno, dogovorjeno vnaprej. Odločite se brez pritiska.</p></div></li>
        <li class="step reveal"><span class="step-n" aria-hidden="true">03</span><div><h3>Plačilo v celoti ali na obroke</h3><p>Kot se dogovoriva v ponudbi. Za vsako plačilo prejmete davčno potrjen račun.</p></div></li>
        <li class="step reveal"><span class="step-n" aria-hidden="true">04</span><div><h3>Objava</h3><p>Stran gre v splet.</p></div></li>
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sec" id="vprasanja" aria-labelledby="faq-h">
    <div class="wrap wrap--narrow">
      <h2 class="h2 reveal" id="faq-h">Pogosta vprašanja</h2>
      <div class="faq reveal">
        <details><summary>Ali moram kaj plačati za predogled?</summary><p>Ne. Predogled je brezplačen in brez obveznosti. Če vam ni všeč, ne plačate ničesar. Če rečete »ne«, vas ne kontaktiram več.</p></details>
        <details><summary>Koliko stane?</summary><p>Po dogovoru, odvisno od tega, kaj potrebujete. Ceno zapišem v pisno ponudbo, preden karkoli plačate. DDV se ne obračuna (čl. 94 ZDDV-1).</p></details>
        <details><summary>Je domena vključena?</summary><p>Da, prvo leto, registrirana na vaše ime. Podaljšanje po prvem letu plačate sami pri registrarju.</p></details>
        <details><summary>Mi obljubite prvo mesto na Googlu?</summary><p>Ne. Noben paket ne vključuje obljube o uvrstitvi na iskalnikih.</p></details>
        <details><summary>Kaj, če že imam spletno stran?</summary><p>Pripravim predogled prenovljene strani, ki ga primerjate s sedanjo.</p></details>
        <details><summary>Lahko dobim spletno trgovino ali rezervacije?</summary><p>Da, oboje kot dodatek, cena po dogovoru.</p></details>
      </div>
    </div>
  </section>

  <!-- PRIMERI -->
  <section class="sec sec--alt" id="primeri" aria-labelledby="primeri-h">
    <div class="wrap">
      <h2 class="eyebrow reveal" id="primeri-h">Primeri</h2>
      <article class="feature reveal">
        <a class="feature-shot" href="/p/briski/" aria-label="Odpri stran Gostilnice in picerije Briški">
          <img src="/img/zaslon-briski-m.webp" width="600" height="923" alt="Posnetek zaslona strani Gostilnice in picerije Briški na telefonu" loading="lazy" decoding="async">
        </a>
        <div class="feature-copy">
          <p class="tag tag--solid">Izdelana stran</p>
          <h3 class="h2">Gostilnica in picerija Briški, Kočevje</h3>
          <p>Jedilnik, tedenska ponudba, galerija in delovni čas, z gumbom za klic.</p>
          <ul class="chips" aria-label="Kaj stran vsebuje">
            <li>Jedilnik</li><li>Tedenska ponudba</li><li>Galerija</li><li>Delovni čas</li>
          </ul>
          <a class="btn" href="/p/briski/">Odpri stran<Icon name="arrow" /></a>
        </div>
      </article>
      <div class="cards cards--2 cards--examples">
        <article class="card card--example reveal">
          <a class="example-shot" href="/p/pohistvo-jereb/" rel="noopener" target="_blank" aria-label="Odpri predogled za Pohištvo Jereb">
            <img src="/img/zaslon-jereb-m.webp" width="600" height="923" alt="Posnetek zaslona predogleda za Pohištvo Jereb na telefonu" loading="lazy" decoding="async">
          </a>
          <div>
            <p class="tag">Primer predloga</p>
            <h3>Pohištvo Jereb, Škofja Loka</h3>
            <p>Predogled, pripravljen za podjetje: več podstrani in galerije po prostorih.</p>
            <a class="link" href="/p/pohistvo-jereb/" rel="noopener" target="_blank">Odpri predogled<Icon name="arrow" /></a>
          </div>
        </article>
        <article class="card card--example reveal">
          <a class="example-shot" href="/p/fitnes-no-1/1/" rel="noopener" target="_blank" aria-label="Odpri predogled za Fitnes No 1">
            <img src="/img/zaslon-fit-m.webp" width="600" height="923" alt="Posnetek zaslona predogleda za Fitnes No 1 na telefonu" loading="lazy" decoding="async">
          </a>
          <div>
            <p class="tag">Primer predloga</p>
            <h3>Fitnes No 1, Kočevje</h3>
            <p>Primer predloga.</p>
            <a class="link" href="/p/fitnes-no-1/1/" rel="noopener" target="_blank">Odpri predogled<Icon name="arrow" /></a>
          </div>
        </article>
      </div>
      <p class="note reveal">»Primer predloga« je predogled, ki sem ga pripravil za podjetje pred naročilom. To ne pomeni, da je podjetje moja stranka.</p>
    </div>
  </section>

  <!-- O MENI -->
  <section class="sec" id="o-meni" aria-labelledby="omeni-h">
    <div class="wrap about-grid">
      <figure class="about-photo reveal">
        <img src="/img/alej-portret-760.webp" width="760" height="950" alt="Alej Kump" loading="lazy" decoding="async">
      </figure>
      <div class="about-copy">
        <p class="eyebrow reveal">O meni</p>
        <h2 class="h2 reveal" id="omeni-h">Sem Alej Kump, iz Kočevja.</h2>
        <p class="reveal">AK agencija je ime, pod katerim delam. Uradno ime podjetja je AK agencija, računalniško programiranje, Alej Kump s.p. Podjetje sem registriral 15. septembra 2026.</p>
        <dl class="points reveal">
          <div><dt>Ena številka</dt><dd>Vsak klic, SMS in sporočilo dobim jaz.</dd></div>
          <div><dt>Cena vnaprej</dt><dd>Trije paketi, cena po dogovoru v pisni ponudbi.</dd></div>
          <div><dt>Iskreno</dt><dd>Če presodim, da vam ne morem pošteno pomagati, vam to povem v prvem odgovoru.</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- KONTAKT -->
  <section class="sec sec--alt" id="kontakt" aria-labelledby="kontakt-h">
    <div class="wrap">
      <p class="eyebrow reveal">Pogovoriva se</p>
      <h2 class="h2 reveal" id="kontakt-h">Pripravljeni na novo spletno stran?</h2>
      <div class="cards cards--3 contact">
        <a class="card card--link reveal" href="https://www.instagram.com/alej_kump/" rel="noopener" target="_blank">
          <span class="icon-box"><Icon name="instagram" /></span>
          <span class="contact-label">Instagram</span>
          <strong>@alej_kump</strong>
          <span>V sporočilo napišite STRAN.</span>
        </a>
        <a class="card card--link reveal" href="tel:+38670479188">
          <span class="icon-box"><Icon name="call" /></span>
          <span class="contact-label">Telefon</span>
          <strong>070 479 188</strong>
          <span>Klic ali SMS.</span>
        </a>
        <a class="card card--link reveal" href="mailto:alej.kump@gmail.com">
          <span class="icon-box"><Icon name="mail" /></span>
          <span class="contact-label">E-pošta</span>
          <strong>alej.kump@gmail.com</strong>
          <span>Odpre vaš poštni program.</span>
        </a>
      </div>
      <p class="company reveal">AK agencija, računalniško programiranje, Alej Kump s.p., Ulica heroja Marinclja 3, 1330 Kočevje · matična št. 7585942000 · davčna št. 67735509 · nisem zavezanec za DDV (čl. 94 ZDDV-1)</p>
    </div>
  </section>
</Base>
