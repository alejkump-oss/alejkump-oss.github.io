---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

// The six monthly MARKETING packages, copied verbatim from live-site/marketing.html.
const packages = [
  { name: 'MINI', price: '59', items: ['2 kratka videa (reela)', 'Opisi s ključniki'], subject: 'MARKETING%20MINI' },
  { name: 'VIDEO', price: '99', items: ['4 kratki videi (reeli)', 'Opisi s ključniki'], subject: 'MARKETING%20VIDEO' },
  { name: 'START', price: '189', items: ['6 kratkih videov (reelov)', '6 objav (slika ali vrtiljak)', 'Mesečni načrt objav', 'Opisi s ključniki'], subject: 'MARKETING%20START' },
  { name: 'RAST', price: '349', rec: true, items: ['10 videov in 10 objav', '4 objave za Google profil', '2 oglasa: video ali slika, 3 različice besedila, predlog ciljne skupine', 'Mesečni načrt objav in opisi s ključniki', 'Mesečno poročilo', '30-minutni posvet na mesec'], subject: 'MARKETING%20RAST' },
  { name: 'PREMIUM', price: '590', items: ['16 videov in 12 objav', '8 objav za Google profil', '4 oglasi', 'Vodenje oglasov v vašem Meta računu', 'Mesečni načrt objav in opisi s ključniki', 'Tedensko poročilo', '30-minutni posvet na mesec'], subject: 'MARKETING%20PREMIUM' },
  { name: 'PARTNER', price: '990', items: ['25 videov in 20 objav', '12 objav za Google profil', '6 oglasov', 'Vodenje oglasov', 'Mesečni načrt objav in opisi s ključniki', 'Četrtletni načrt vsebin', 'Tedensko poročilo', 'Tedenski 30-minutni posvet'], sub: 'Omejeno število podjetij – potrdim po pogovoru, ali imam prosto zmogljivost.', cta: 'Dogovoriva se', subject: 'MARKETING%20PARTNER' },
];
---
<Base
  page="storitve"
  path="storitve.html"
  title="Storitve: spletne strani in marketing | AK agencija"
  description="Spletne strani za lokalna podjetja in kratki videi za marketing. Pri vsaki storitvi veste vnaprej, kaj dobite in koliko plačate."
  ogDescription="Spletne strani za lokalna podjetja s ceno po dogovoru in brezplačnim predogledom, in marketing s kratkimi videi."
>
  <section class="sec sec--alt page-hero" aria-labelledby="st-h">
    <div class="wrap">
      <p class="eyebrow reveal">Storitve</p>
      <h1 class="h1 h1--page reveal" id="st-h">Spletna stran in kratki videi.</h1>
      <p class="lead reveal">Dve storitvi, vse s ceno vnaprej.</p>

      <div class="cards cards--2 cards--services">
        <article class="card card--service reveal">
          <span class="icon-box"><Icon name="monitor" /></span>
          <h2>Spletne strani</h2>
          <p class="tag">Cena po dogovoru · najprej brezplačen predogled</p>
          <p>Hitre, mobilno prilagojene strani za podjetja, kjer stranka na telefonu hitro pogleda, kaj ponujate, in vas pokliče. Najprej prejmete brezplačen predogled, nato pisno ponudbo s ceno, dogovorjeno vnaprej.</p>
          <ul class="checks">
            <li><Icon name="check" />Osnovna: 1 stran, razdeljena na sekcije</li>
            <li><Icon name="check" />Lokalni posel: do 5 podstrani</li>
            <li><Icon name="check" />Premium: do 5 podstrani, s pripravljenimi besedili in slikami</li>
            <li><Icon name="check" />Domena za prvo leto vključena, DDV ni obračunan, plačilo tudi na obroke</li>
          </ul>
          <a class="btn btn--solid" href="cene.html">Paketi in cene<Icon name="arrow" /></a>
        </article>
        <article class="card card--service reveal">
          <span class="icon-box"><Icon name="video" /></span>
          <h2>Marketing</h2>
          <p class="tag">Prvi video brezplačno · brez vezave</p>
          <p>Kratki videi (reeli), objave in oglasi za lokalna podjetja. Pošljete posnetke s telefona, dobite zmontiran kratek video z napisi in glasbo.</p>
          <ul class="checks">
            <li><Icon name="check" />Posnamete po snemalnem listu ali pridem posnet jaz, brez doplačila</li>
            <li><Icon name="check" />Montaža, napisi in ritmična glasba, zraven opisi s ključniki</li>
            <li><Icon name="check" />Datoteke dobite po e-pošti in jih objavite sami</li>
          </ul>
          <a class="btn" href="#marketing">Paketi in cene<Icon name="arrow" /></a>
        </article>
      </div>
      <p class="note note--bar reveal">Spletno trgovino in naročanje na termin dodam kot dodatek, cena po dogovoru. Rezultatov ne obljubljam.</p>
    </div>
  </section>

  <section class="sec" id="za-koga" aria-labelledby="zk-h">
    <div class="wrap">
      <h2 class="h2 reveal" id="zk-h">Za koga</h2>
      <p class="lead reveal">Za lokalna podjetja v Sloveniji, ki še nimajo svoje spletne strani ali imajo zastarelo, počasno oziroma slabo berljivo na telefonu.</p>
      <ul class="tiles">
        <li class="tile reveal"><span class="icon-box icon-box--sm"><Icon name="tool" /></span>Obrtniki in mojstri</li>
        <li class="tile reveal"><span class="icon-box icon-box--sm"><Icon name="fork" /></span>Lokali in gostilne</li>
        <li class="tile reveal"><span class="icon-box icon-box--sm"><Icon name="bed" /></span>Nastanitve in apartmaji</li>
        <li class="tile reveal"><span class="icon-box icon-box--sm"><Icon name="scissors" /></span>Saloni in storitve</li>
      </ul>
    </div>
  </section>

  <section class="cta-band" aria-labelledby="cta-h">
    <div class="wrap">
      <h2 class="h2 reveal" id="cta-h">Napišite STRAN. Pripravim vam predogled.</h2>
      <div class="btn-row btn-row--center reveal">
        <a class="btn btn--solid" href="tel:+38670479188"><Icon name="call" />Pokličite 070 479 188</a>
        <a class="btn btn--ghost" href="https://www.instagram.com/alej_kump/" rel="noopener" target="_blank"><Icon name="instagram" />Instagram @alej_kump</a>
      </div>
    </div>
  </section>

  <section class="sec sec--alt" id="marketing" aria-labelledby="mk-h">
    <div class="wrap">
      <h2 class="h2 reveal" id="mk-h">Marketing: paketi in cene</h2>
      <p class="lead reveal">Vi posnamete s telefonom. Jaz zmontiram. Prvi video brezplačno, brez obveznosti. Brez vezave, odpoved z enim e-mailom. Končne cene, DDV ni obračunan (94. člen ZDDV-1). Plačilo na TRR po računu.</p>
      <div class="cards cards--3 prices">
        {packages.map((p) => (
          <article class={`card price-card reveal${p.rec ? ' price-card--rec' : ''}`}>
            {p.rec && <p class="tag tag--solid">Priporočeno</p>}
            <h3>{p.name}</h3>
            <p class="amount">{p.price} €<span>/mesec</span></p>
            <ul class="bullets">{p.items.map((it) => <li>{it}</li>)}</ul>
            {p.sub && <p class="price-sub">{p.sub}</p>}
            <a class="btn btn--solid" href={`mailto:alej.kump@gmail.com?subject=${p.subject}`}>{p.cta ?? 'Naročite'}<span class="sr-only"> paket {p.name}</span></a>
          </article>
        ))}
      </div>
      <div class="btn-row reveal"><a class="btn" href="marketing.html">Celotna tabela in pogoji storitve MARKETING<Icon name="arrow" /></a></div>
    </div>
  </section>
</Base>
